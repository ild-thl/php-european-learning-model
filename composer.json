{
    "name": "isy-thl/european-digital-credentials",
    "description": "Framework-independent European Digital Credential document model and serializer.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "IsyThl\\EuropeanDigitalCredentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsyThl\\EuropeanDigitalCredentials\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.9"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "find src tests -path 'src/Legacy' -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l",
        "format": "phpcbf --standard=phpcs.xml src tests",
        "style": "phpcs --standard=phpcs.xml",
        "analyse": "phpstan analyse --configuration=phpstan.neon"
    }
}
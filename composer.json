{
    "name": "isy-thl/european-digital-credentials",
    "description": "Framework-independent European Digital Credential document model and serializer.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "IsyThl\\EuropeanDigitalCredentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IsyThl\\EuropeanDigitalCredentials\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml"
    }
}
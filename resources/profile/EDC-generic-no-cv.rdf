    <rdfs:comment xml:lang="it">Essere umano (persona fisica).</rdfs:comment>
    <rdfs:comment xml:lang="en">A human being (a natural person).</rdfs:comment>
    <rdfs:comment xml:lang="me">Osoba (fizičko lice).</rdfs:comment>
    <rdfs:comment xml:lang="sl">Človek (fizična oseba).</rdfs:comment>
    <rdfs:comment xml:lang="sr">Људско биће (физичко лице).</rdfs:comment>
    <rdfs:label xml:lang="fr">Personne</rdfs:label>
    <rdfs:label xml:lang="tr">Gerçek Kişi</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Person-elm_contactPoint">
        <sh:description xml:lang="sv">Kontaktinformation för den enhet som kan vidta åtgärder.</sh:description>
        <sh:name xml:lang="hu">Kapcsolattartási adatok</sh:name>

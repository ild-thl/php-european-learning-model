        >12</sh:order>
        <sh:name xml:lang="en">homepage</sh:name>
        <sh:description xml:lang="en">A homepage for some thing.</sh:description>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/WebResource"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Qualification-elm_learningSetting">
        <sh:description xml:lang="lv">Mācību vides veids (formāla, neformāla). Var norādīt tikai vērtības, kas ņemtas no mācību vides veidu saraksta (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="lv">Mācību vide</sh:name>
        <sh:description xml:lang="sr">Тип околности учења (формално или неформално). Ако се наводи, вредност мора да потиче са списка Околности учења (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="sk">Druh vzdelávacieho prostredia (formálne, neformálne). Poskytnutá hodnota musí byť zo zoznamu druhov vzdelávacieho prostredia (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="lt">Mokymosi pobūdžio tipas (formalusis, neformalusis) Jei nurodoma, vertė turi būti iš mokymosi pobūdžio tipų sąrašo (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="me">Okruženje za učenje</sh:name>
        <sh:name xml:lang="el">Περιβάλλον μάθησης</sh:name>
        <sh:name xml:lang="de">Lernumgebung</sh:name>
        <sh:name xml:lang="pt">Contexto de aprendizagem</sh:name>
        <sh:name xml:lang="is">Námsumhverfi</sh:name>
        <sh:description xml:lang="hr">Vrsta okruženja za učenje (formalno, neformalno). Ako je navedena, vrijednost mora biti s popisa vrsta obrazovnih okruženja (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="nl">Leeromgeving</sh:name>
        <sh:description xml:lang="de">Art der Lernumgebung (formal, nichtformal). Falls angegeben, muss der Wert aus der Liste der Lernumgebungsarten stammen (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:description xml:lang="tr">Öğrenme ortamının türü (örgün, yaygın). Verilmişse, değer öğrenme ortamı türlerinin listesinden gelmelidir (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="pl">Tryb nauki</sh:name>
        <sh:description xml:lang="en">The type of learning setting (formal, non-formal).</sh:description>
        <sh:description xml:lang="es">El tipo de entorno de aprendizaje (formal, no formal). Si se facilita, el valor debe proceder de la lista de tipos de Entornos de aprendizaje (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="mk">Поставување на учење</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="cs">Typ prostředí, kde učení probíhá (formální, neformální). Poskytnutá hodnota musí být převzata ze seznamu Prostředí, kde učení probíhá (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="da">Type læringsramme (formel, ikke-formel). Hvis oplyst, skal værdien tages fra listen Learning setting types (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="ro">Tipul de cadru de învățare (formal, non-formal). Dacă este furnizată, valoarea trebuie să provină din lista tipurilor de cadre de învățare (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="mt">It-tip ta’ ambjent ta’ tagħlim (formali, mhux formali). Jekk jiġi pprovdut, il-valur għandu jiġi mit-tipi ta’ ssettjar tat-Tagħlim (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="et">Õpikeskkond</sh:name>
        <sh:name xml:lang="mt">Ambjent ta’ Tagħlim</sh:name>
        <sh:name xml:lang="es">Entorno de aprendizaje</sh:name>
        <sh:description xml:lang="sl">Vrsta učnih okolij (formalno, neformalno). Navedena vrednost mora izhajati s seznama vrst učnih okolij (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="et">Õpikeskkonna liik (ametlik, mitteametlik). Kui väärtus on märgitud, peab see pärinema õpikeskkonna liikide loetelust (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="fr">Le type de cadre d’apprentissage (formel ou non formel). Si elle est fournie, la valeur doit provenir de la liste des Types de cadre d’apprentissage (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="hu">A tanulási környezet típusa (formális, nem formális). Az értéknek (ha meg van adva) a tanulási környezet típusának a listájáról kell származnia (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="bg">Среда, в която се провежда обучението</sh:name>
        <sh:name xml:lang="en">learning setting</sh:name>
        <sh:description xml:lang="pl">Rodzaj trybu nauki (formalny, pozaformalny). Jeżeli ją podano, wartość ta musi pochodzić z wykazu rodzajów trybu nauki (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="is">Tegund námsumhverfis (formlegt, ekki formlegt). Ef til staðar, verður gildið að koma úr lista Námsumhverfistegunda (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="sl">Učno okolje</sh:name>
        <sh:description xml:lang="me">Tip okruženja za učenje (formalno, neformalno). Ako je navedena, vrijednost mora da potiče sa liste tipova okruženja za učenje (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="en">The type of learning setting (formal, non-formal). If provided, the value must come from the list of Learning setting types (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="fi">Oppimistilanne</sh:name>
        <sh:name xml:lang="cs">Prostředí, kde učení probíhá</sh:name>
        <sh:description xml:lang="nl">Het soort leeromgeving (formeel, niet-formeel). Indien verstrekt, moet de waarde afkomstig zijn uit de lijst van soorten leeromgevingen (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="ga">Cineál an tsuímh foghlama (foirmiúil, neamhfhoirmiúil). Má chuirtear ar fáil é, ní mór an luach teacht ón liosta Cineálacha suímh foghlama (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="hu">Tanulási környezet</sh:name>
        <sh:name xml:lang="sv">Lärandemiljö</sh:name>
        <sh:name xml:lang="ro">Cadrul de învățare</sh:name>
        <sh:description xml:lang="it">Il tipo di contesto di apprendimento (formale, non formale). Se fornito, il valore deve essere tratto dall'elenco dei tipi di contesto di apprendimento (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="da">Læringsmiljø</sh:name>
        <sh:name xml:lang="no">Læringsmiljø</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="it">Contesto di apprendimento</sh:name>
        <sh:description xml:lang="mk">Тип на опкружувањето за учење (формално, неформално). Ако е дадена, вредноста мора да биде од листата на типовите на опкружувања за учење (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="pt">O tipo de contexto de aprendizagem (formal, não formal). Se for indicado, o valor deve provir da lista de códigos de contextos de aprendizagem (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="ga">Suíomh na Foghlama</sh:name>
        <sh:description xml:lang="el">Ο τύπος του περιβάλλοντος μάθησης (τυπικό, μη τυπικό). Εάν παρέχεται, η τιμή πρέπει να προέρχεται από τον κατάλογο «Τύποι περιβάλλοντος μάθησης» (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="fr">Cadre d’apprentissage</sh:name>
        <sh:description xml:lang="sv">Typ av lärandemiljö (formell, informell). I förekommande fall måste värdet komma från listan över lärandemiljöer (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="tr">Öğrenim Ortamı</sh:name>
        <sh:name xml:lang="sk">Vzdelávacie prostredie</sh:name>
        <sh:name xml:lang="hr">Obrazovno okruženje</sh:name>
        <sh:description xml:lang="fi">Oppimisympäristön tyyppi (virallinen, epävirallinen) Jos arvo määritellään, sen on oltava Oppimisympäristötyypit (Learning setting types) -luettelon (http://publications.europa.eu/resource/dataset/international-education-classification) mukainen.</sh:description>
        <sh:name xml:lang="lt">Mokymosi pobūdis</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/learningSetting"/>
        <sh:description xml:lang="bg">Видът на учебната среда (формална, неформална). Ако бъде посочена, стойността трябва да е от списъка с видове учебна среда (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="no">Typen læringsmiljø (formelt, uformelt). Hvis oppgitt, må verdien komme fra listen over læringssettingstyper (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="fr">La spécification d’un processus d’évaluation et de validation obtenu lorsqu’une autorité compétente établit qu’une personne a obtenu des résultats d’apprentissage correspondant à des normes données.</rdfs:comment>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/Qualification"/>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Qualification-elm_volumeOfLearning">
        <sh:description xml:lang="lv">Aptuvenais stundu skaits, kas izglītojamajam būtu jāvelta mācībām, lai tās sekmīgi pabeigtu. Tas ietver stundu skaitu grupu darbā, praktiskajā nodarbībās, kā arī pastāvīgo darbu mājās.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:name xml:lang="et">Õppemaht</sh:name>
        <sh:description xml:lang="en">The estimated number of hours the learner is expected to spend engaged in learning to earn the award. This would include the notional number of hours in class, in group work, in practicals, as well as hours engaged in self-motivated study.</sh:description>
        <sh:description xml:lang="bg">Брой часове, които се очаква учащият да посвети на учебни дейности, за да получи удостоверение. Това включва индикативния брой часове, прекарани в клас, работа в група, практически занятия или самообучение.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="it">Volume di apprendimento</sh:name>
        <sh:description xml:lang="da">Det anslåede antal timer, som eleven forventes at bruge på at deltage i læring for at optjene prisen. Dette omfatter det teoretiske antal timer i klassen, i gruppearbejde, i praksis samt timer brugt på selvstudier.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="tr">Öğrenim hacmi</sh:name>
        <sh:description xml:lang="es">El número estimado de horas que se espera que el alumno dedique al aprendizaje para obtener la distinción. Esto incluiría el número teórico de horas de trabajo en grupo y de prácticas, así como las horas dedicadas al estudio automotivado.</sh:description>
        <sh:name xml:lang="ro">Numărul de ore de învățare</sh:name>
        <sh:name xml:lang="mt">Volum ta’ tagħlim</sh:name>
        <sh:name xml:lang="sl">Obseg učenja</sh:name>
        <sh:description xml:lang="sk">Odhadovaný počet hodín, ktoré by vzdelávajúca sa osoba mala stráviť vzdelávaním sa, aby jej mohla byť udelená kvalifikácia. Tento počet by zahŕňal predpokladaný počet hodín strávených prácou v skupinách, praktickými cvičeniami, ako aj hodín venovaných samoštúdiu.</sh:description>
        <sh:description xml:lang="ro">Numărul estimat de ore pe care cursantul ar urma să le dedice studiului pentru a obține certificatul. Acesta ar include numărul teoretic de ore, munca în grup, practica, precum și numărul de ore de studiu individual.</sh:description>
        <sh:name xml:lang="da">Læringens omfang</sh:name>
        <sh:name xml:lang="sv">Lärandevolym</sh:name>
        <sh:name xml:lang="en">volume of learning</sh:name>
        <sh:name xml:lang="lt">Mokymosi apimtis</sh:name>
        <sh:description xml:lang="sv">Beräknat antal timmar som en person förväntas ägna åt lärandet. Räkna med det antal timmar som används för grupparbete, praktik och självstudier.</sh:description>
        <sh:name xml:lang="mk">Обем на учење</sh:name>
        <sh:name xml:lang="pt">Volume de aprendizagem</sh:name>
        <sh:description xml:lang="cs">Odhadovaný počet hodin, které by měl účastník vzdělávání strávit učením, aby získal kvalifikaci. Tento počet by zahrnoval pomyslný počet hodin strávených při práci ve skupině, praktických cvičeních a také počet hodin věnovaných samostudiu.</sh:description>
        <sh:description xml:lang="hu">Azon órák becsült száma, amelyeket a tanulónak várhatóan tanulással kell töltenie, hogy az elismerést megszerezze. Ide tartozik a csoportmunkával, a gyakorlattal, valamint az önálló tanulással töltött órák körülbelüli száma.</sh:description>
        <sh:description xml:lang="fr">Nombre d’heures estimé que l’apprenant devrait consacrer à l’apprentissage pour obtenir l'attribution. Cela inclut le nombre théorique d’heures de cours, de travaux de groupes, de travaux pratiques, ainsi que d’heures d’apprentissage autonome.</sh:description>
        <sh:name xml:lang="sk">Objem vzdelávania</sh:name>
        <sh:name xml:lang="me">Obim učenja</sh:name>
        <sh:description xml:lang="fi">Arvioitu tuntimäärä, jonka opiskelija käyttää oppimissaavutuksen saamiseen vaadittavaan oppimiseen. Sisällytä lukuun ryhmätyöhön, harjoituksiin ja itsenäiseen opiskeluun käytettyjen tuntien nimellinen määrä.</sh:description>
        <sh:name xml:lang="fr">Volume d’apprentissage</sh:name>
        <sh:description xml:lang="is">Áætlaður fjöldi klukkustunda sem gert er ráð fyrir að nemandi stundi námið til að fá viðurkenningu. Það myndi fela í sér reiknaðan fjölda klukkustunda í hópvinnu, verklegum verkefnum, sem og stundir sem fara í sjálfshvetjandi nám.</sh:description>
        <sh:description xml:lang="sr">Процењени број сати које полазник очекивано треба да проведе учећи да би стекао доделу. Ово би требало да обухвата номинални број сати присуства, у групном раду, на практичним вежбама, као и сати проведених у самоиницијативном учењу.</sh:description>
        <sh:description xml:lang="nl">Het geraamde aantal uren dat de lerende naar verwachting zal besteden aan het leren om de kwalificatie te behalen. Dit omvat het hypothetische aantal uren les, groepswerk, practica en zelfstandige studie.</sh:description>
        <sh:description xml:lang="sl">Predvideno število ur, ki naj bi jih učeči se porabil za učenje za pridobitev spričevala. To vključuje število ur v učilnici, ur skupinskega dela, praktičnega dela in samomotiviranega učenja.</sh:description>
        <sh:name xml:lang="es">Volumen de aprendizaje</sh:name>
        <sh:name xml:lang="el">Όγκος μάθησης</sh:name>
        <sh:name xml:lang="lv">Mācību apjoms</sh:name>
        <sh:name xml:lang="pl">Wymiar nauki</sh:name>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:description xml:lang="lt">Numatomas laikas valandomis, kurio asmeniui, kuris mokosi, turėtų prireikti, kad pasiektų norimą mokymosi rezultatą. Į šį laiką turėtų būti įtrauktos numatomos pamokų, grupinio darbo, praktinių užsiėmimų valandos, taip pat savarankiško mokymosi valandos.</sh:description>
        <sh:description xml:lang="pt">O número estimado de horas de aprendizagem que o aprendente deverá frequentar para obter a qualificação. Tal incluiria o número teórico de horas em trabalho de grupo e em trabalho prático, bem como horas de estudo individuais.</sh:description>
        <sh:name xml:lang="hr">Opseg učenja</sh:name>
        <sh:description xml:lang="it">La stima del numero di ore che il discente dovrebbe dedicare all'apprendimento per ottenere il riconoscimento. Include il numero teorico di ore dedicate ai lavori di gruppo, agli esami pratici e allo studio autonomo.</sh:description>
        <sh:description xml:lang="pl">Szacowana liczba godzin, którą uczący się powinien spędzić na nauce, aby uzyskać rezultat. Obejmuje to hipotetyczną liczbę godzin zajęć w klasie, pracy w grupach i zajęć praktycznych, a także godzin spędzonych na samodzielnej nauce.</sh:description>
        <sh:description xml:lang="et">Hinnanguline tundide arv, mille õppija peab eeldatavasti tulemuse saavutamiseks õppimisele kulutama. See hõlmab nii rühmatööde, praktikumide kui ka iseseisva õppetööga seotud arvestuslikku tundide arvu.</sh:description>
        <sh:description xml:lang="el">Ο εκτιμώμενος αριθμός ωρών μάθησης που αναμένεται να αφιερώσει ο εκπαιδευόμενος για να αποκτήσει τον τίτλο. Ο αριθμός αυτός θα περιλαμβάνει τον ονομαστικό αριθμό των ωρών εργασίας, ομαδικής εργασίας, πρακτικής άσκησης, καθώς και των ωρών που αφιερώνονται σε προσωπική μελέτη.</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="en">The estimated number of hours the learner is expected to spend engaged in learning to earn the award. This would include the notional number of hours in, in group work, in practicals, as well as hours engaged in self-motivated study.</sh:description>
        <sh:name xml:lang="no">Læringsomfang</sh:name>
        <sh:description xml:lang="hr">Procijenjeni broj sati za koji se od učenika očekuje da ih će ih provesti učeći kako bi ostvario rezultat. To bi uključivalo zamišljeni broj sati provedenih u radu u skupini, u praktičnom radu te u samostalnom učenju.</sh:description>
        <sh:description xml:lang="de">Geschätzte Anzahl an Lernstunden, die zum Erwerb des Abschlusses zu absolvieren sind. Dies umfasst die geplante Anzahl an Unterrichts- und Übungsstunden sowie Gruppenarbeit und Selbststudium.</sh:description>
        <sh:description xml:lang="tr">Öğrencinin başarı kazanmak için öğrenme faaliyetinde geçirmesi beklenen tahmini saat sayısı. Bu, grup çalışmasında, uygulamalarda ve kendi kendine motivasyonla çalışılan saatlerin yanı sıra kavramsal saat sayısını da içerecektir.</sh:description>
        <sh:description xml:lang="no">Det estimerte antallet timer eleven forventes å bruke på å lære for å tjene premien. Dette vil inkludere det teoretiske antall timer i, i gruppearbeid, i praksis, så vel som timer engasjert i selvmotiverte studier.</sh:description>
        <sh:name xml:lang="is">Námsumfang</sh:name>
        <sh:name xml:lang="bg">Продължителност на обучението</sh:name>
        <sh:name xml:lang="ga">Méid na foghlama</sh:name>
        <sh:description xml:lang="mk">Очекуваниот број на часови кои се очекува ученикот да ги помине во учење за да ја добие дипломата. Ова би ја вклучило условната бројка на часови, за работа во група, пракса, како и за време на часовите во кои се бави со самомотивирана обука.</sh:description>
        <sh:description xml:lang="ga">Líon measta na n-uaireanta a chaitheann an foghlaimeoir i mbun foghlama chun an ghnóthachtáil a thuilleamh. Cuir i gcás líon measta na n-uaireanta a chaitear sa rang, i mbun obair ghrúpa nó obair phraiticiúil, agus líon measta na n-uaireanta a chaitheann an foghlaimeoir ag staidéar ar a chonlán féin.</sh:description>
        <sh:name xml:lang="fi">Oppimispanostus</sh:name>
        <sh:name xml:lang="de">Lernumfang</sh:name>
        <sh:name xml:lang="cs">Objem učení</sh:name>
        <sh:name xml:lang="nl">Leervolume</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/volumeOfLearning"/>
        <sh:description xml:lang="me">Procijenjeni broj sati za koje se očekuje da će polaznik provesti učeći kako bi zaslužio nagradu. To bi uključivalo zamišljeni broj sati grupnog rada, vježbe, kao i sate uključene u samomotivisano učenje.</sh:description>
        <sh:description xml:lang="mt">L-għadd stmat ta’ sigħat li l-istudent hu mistenni li jqatta’ impenjat fit-tagħlim biex jikseb l-għotja. Dan ikun jinkludi l-għadd nozzjonali ta’ sigħat f’ħidma fi grupp, fi sessjonijiet prattiċi, kif ukoll is-sigħat involuti fi studju awtomotivat.</sh:description>
        <sh:name xml:lang="hu">A tanulás mennyisége</sh:name>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="de">Wird am Ende eines Beurteilungs- und Validierungsprozesses verliehen, wenn eine dafür zuständige Stelle festgestellt hat, dass die Lernergebnisse einer Person vorgegebenen Standards entsprechen.</rdfs:comment>
    <rdfs:comment xml:lang="me"></rdfs:comment>
    <rdfs:label xml:lang="sl">Kvalifikacija</rdfs:label>
    <rdfs:label xml:lang="me">Kvalifikacija</rdfs:label>
    <rdfs:label xml:lang="lt">Kvalifikacija</rdfs:label>
    <rdfs:label xml:lang="hr">Kvalifikacija</rdfs:label>
    <rdfs:comment xml:lang="pl">Specyfikacja procesu oceny i walidacji uzyskiwana wówczas, gdy właściwy organ stwierdza, że dana osoba osiągnęła efekty uczenia się zgodne z określonymi normami.</rdfs:comment>
    <rdfs:comment xml:lang="lt">Įvertinimo ir patvirtinimo proceso specifikacija, gaunama, kai kompetentinga institucija nustato, kad asmens mokymosi rezultatai atitinka nustatytus standartus.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Qualification-elm_qualificationCode">
        <sh:description xml:lang="no">En identifiserende kode fra et kvalifikasjonsbasert semantisk referanseelement. Denne egenskapen brukes til å klassifisere kvalifikasjonsinformasjonen med en kvalifikasjon fra et kjent kvalifikasjonsrammeverk. (f.eks. lenken til den akkrediterte NQF-kvalifiseringen). Hvis oppgitt, bør verdien komme fra et kontrollert vokabular.</sh:description>
        <sh:name xml:lang="lt">kvalifikacijos kodas</sh:name>
        <sh:description xml:lang="pt">Um código de identificação de um elemento semântico de referência baseado na qualificação. Esta propriedade é utilizada para classificar as informações sobre a qualificação com base numa qualificação de um quadro de qualificações conhecido (por exemplo, a ligação à qualificação do QNQ acreditado). Se for indicado, o valor deve provir de um vocabulário controlado.</sh:description>
        <sh:name xml:lang="sr">шифра квалификације</sh:name>
        <sh:name xml:lang="fr">code de la certification</sh:name>
        <sh:name xml:lang="sl">oznaka kvalifikacije</sh:name>
        <sh:name xml:lang="hr">oznaka kvalifikacije</sh:name>
        <sh:description xml:lang="sk">Identifikačný kód z referenčného sémantického aktíva založeného na kvalifikáciách. Táto vlastnosť sa používa na priradenie informácií o kvalifikácii ku kvalifikácii zo známeho kvalifikačného rámca (napr. odkaz na akreditovanú kvalifikáciu NKR). Poskytnutá hodnota by mala byť z riadeného slovníka.</sh:description>
        <sh:description xml:lang="lt">Identifikavimo kodas iš kvalifikacijomis grįsto referencinio semantinio ištekliaus. Ši savybė naudojama kvalifikavimo informacijai klasifikuoti kartu kvalifikacija iš žinomos kvalifikacijų sistemos (pvz., nuoroda į akredituotos NKS kvalifikaciją). Jei nurodoma, vertė turėtų būti iš kontrolinio žodyno.</sh:description>
        <sh:name xml:lang="hu">a képesítés kódja</sh:name>
        <sh:name xml:lang="da">kvalifikationskode</sh:name>
        <sh:name xml:lang="me">kvalifikacioni kod</sh:name>
        <sh:name xml:lang="sv">kvalifikationens kod</sh:name>
        <sh:description xml:lang="it">Un codice identificativo da risorse semantiche di riferimento basate sulle qualifiche. Questa proprietà è utilizzata per classificare le informazioni sulle qualifiche sulla base di una qualifica appartenente a un quadro delle qualifiche noto (ad esempio, riferimento a una qualifica dell'NQF riconosciuto). Se fornito, il valore deve essere tratto da un vocabolario controllato.</sh:description>
        <sh:name xml:lang="mk">код на квалификација</sh:name>
        <sh:description xml:lang="sr">Шифра за идентификацију из референтног семантичког ресурса заснованог на квалификацијама. Ово својство служи за класификацију информација преко квалификације из познатог оквира квалификација. (нпр. веза до акредитоване квалификације у НОК-у). Ако се наводи, вредност треба да потиче из контролисаног вокабулара.</sh:description>
        <sh:name xml:lang="et">kvalifikatsiooni kood</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="no">kvalifiseringsskode</sh:name>
        <sh:description xml:lang="el">Αναγνωριστικός κωδικός από σημασιολογικό στοιχείο αναφοράς βάσει τίτλου επαγγελματικού προσόντος. Η ιδιότητα αυτή χρησιμοποιείται για την ταξινόμηση των πληροφοριών του τίτλου επαγγελματικού προσόντος με τίτλο επαγγελματικού προσόντος από γνωστό πλαίσιο επαγγελματικών προσόντων. (π.χ. ο σύνδεσμος με τον τίτλο επαγγελματικού προσόντος του διαπιστευμένου εθνικού πλαισίου επαγγελματικών προσόντων). Εάν παρέχεται, η τιμή θα πρέπει να προέρχεται από ελεγχόμενο λεξιλόγιο.</sh:description>
        <sh:name xml:lang="sk">kód kvalifikácie</sh:name>
        <sh:name xml:lang="en">qualification code</sh:name>
        <sh:description xml:lang="nl">Een identificatiecode van een op de kwalificatie gebaseerd semantisch referentie-activum. Deze eigenschap wordt gebruikt om de kwalificatiegegevens in te delen met een kwalificatie uit een bekend kwalificatiekader (bv. de link naar de geaccrediteerde NQF-kwalificatie). Indien verstrekt, moet de waarde afkomstig zijn uit een gecontroleerde woordenlijst.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="me">Identifikacioni kod iz referentnog semantičkog sredstva zasnovanog na kvalifikacijama. Ovo svojstvo se koristi za klasifikaciju informacija o kvalifikaciji sa kvalifikacijom iz poznatog kvalifikacionog okvira. (npr. link do akreditovane NOK kvalifikacije). Ako je navedena, vrijednost bi trebalo da potiče iz kontrolisanog rječnika.</sh:description>
        <sh:description xml:lang="fr">Un code d’identification d’un actif sémantique de référence fondé sur les certifications. Cette propriété est utilisée pour classer les informations relatives à la certification avec une certification provenant d’un cadre de certifications connu. (par exemple le lien vers la certification CNC accréditée). Si elle est fournie, la valeur doit provenir d’un vocabulaire contrôlé.</sh:description>
        <sh:description xml:lang="tr">Nitelik tabanlı referans anlamsal varlıktan alınan bir tanımlama kodu. Bu özellik, nitelik bilgilerini bilinen bir nitelik çerçevesinden bir nitelik ile sınıflandırmak için kullanılır. (örneğin, akredite NQF niteliğine bağlantı). Verilmişse, değer kontrol edilmiş bir sözlükten gelmelidir.</sh:description>
        <sh:name xml:lang="nl">kwalificatiecode</sh:name>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="pl">Kod identyfikacyjny pochodzący z referencyjnego zasobu semantycznego bazującego na kwalifikacjach. Ta właściwość służy do przyporządkowywania informacji dotyczących kwalifikacji do odpowiednich klas w znanych ramach kwalifikacji (np. związek z kwalifikacjami akredytowanymi w KRK). Jeżeli ją podano, wartość powinna pochodzić ze słownika kontrolowanego.</sh:description>
        <sh:description xml:lang="is">Auðkenniskóði úr merkingarfræðilegu tilvísunarsafni sem byggir á hæfni. Þetta safn er notað til að flokka hæfniupplýsingar úr ákveðnum hæfniramma. (t.d. linkur sem vísar á samþykktri NQF-hæfni). Ef til staðar, þarf gildið að koma frá stýrðum orðaforða.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="ro">Un cod de identificare dintr-un activ semantic de referință bazat pe calificări. Această proprietate este utilizată pentru a clasifica informațiile privind calificarea în raport cu o calificare dintr-un cadru cunoscut al calificărilor. (de exemplu, linkul către calificarea din CNC acreditată). Dacă este furnizată, valoarea ar trebui să provină dintr-un vocabular controlat.</sh:description>
        <sh:name xml:lang="de">Qualifikationscode</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/qualificationCode"/>
        <sh:name xml:lang="ro">codul calificării</sh:name>
        <sh:name xml:lang="mt">kodiċi tan-notifika</sh:name>
        <sh:name xml:lang="tr">nitelik kodu</sh:name>
        <sh:name xml:lang="bg">код на квалификацията</sh:name>
        <sh:name xml:lang="fi">tutkinnon koodi</sh:name>
        <sh:description xml:lang="sl">Identifikacijska oznaka iz referenčnega semantičnega sredstva, ki temelji na kvalifikacijah. Ta lastnost se uporablja za razvrstitev informacij o kvalifikaciji s kvalifikacijo iz znanega ogrodja kvalifikacij. (npr. povezava do akreditirane kvalifikacije iz nacionalnega ogrodja kvalifikacij). Če je vrednost navedena, bi morala izhajati iz kontroliranega besednjaka.</sh:description>
        <sh:description xml:lang="mt">Kodiċi ta’ identifikazzjoni minn assi semantiku ta’ referenza bbażat fuq il-kwalifika. Din il-proprjetà tintuża biex l-informazzjoni dwar il-kwalifika tiġi kklassifikata bi kwalifika minn qafas ta’ kwalifika magħruf. (eż., ir-rabta mal-kwalifika akkreditata tal-QNK). Jekk jiġi pprovdut, il-valur għandu jiġi minn vokabularju kkontrollat.</sh:description>
        <sh:description xml:lang="hu">Minősítésen alapuló szemantikai referenciaeszközből származó azonosító kód. Ez a tulajdonság arra szolgál, hogy a minősítésre vonatkozó információk egy ismert képesítési keretrendszer alapján osztályozva legyenek. (pl. az akkreditált nemzeti képesítési keretrendszer szerinti minősítésre mutató link). Az értéknek (ha meg van adva) ellenőrzött szójegyzékből kell származnia.</sh:description>
        <sh:name xml:lang="cs">kód kvalifikace</sh:name>
        <sh:name xml:lang="el">κωδικός τίτλου προσόντων</sh:name>
        <sh:description xml:lang="fi">Yksilöivä tunniste tutkintoon liittyvästä semanttisesta viitekokoelmasta. Tämän ominaisuuden avulla luokitellaan tunnettuun tutkintojen viitekehykseen kuuluvan tutkinnon tiedot. (Esim. linkki akkreditoituun kansalliseen tutkintojen viitekehykseen). Jos arvo määritellään, sen täytyy perustua kontrolloituun sanastoon.</sh:description>
        <sh:name xml:lang="ga">cód na cáilíochta</sh:name>
        <sh:description xml:lang="mk">Идентификациски код од референтен семантички актив по основ на квалификација. Овој својство се користи за класификација на податоците со квалификации од веќе позната рамка на квалификации. (на пр., линк до акредитираната квалификација во НКР). Ако е дадена, вредноста треба да биде од контролиран вокабулар.</sh:description>
        <sh:description xml:lang="ga">Cód aitheantais ó shócmhainn shéimeantach thagartha atá bunaithe ar cháilíocht. Úsáidtear an tréith seo chun an t-eolas cáilíochta a aicmiú le cáilíocht ó chreat cáilíochta aitheanta. (e.g. an nasc leis an gcáilíocht chreidiúnaithe den Chreat Náisiúnta Cáilíochtaí). Má chuirtear ar fáil é, ba cheart an luach teacht ó stór focal rialaithe.</sh:description>
        <sh:description xml:lang="bg">Идентификационен код от референтен семантичен актив, базиран на квалификации. Това свойство се използва за класифициране на информацията за квалификация въз основа на квалификация от известна квалификационна рамка (напр. връзка към акредитирана квалификация по НКР). Ако бъде посочена, стойността трябва да е от контролиран речник.</sh:description>
        <sh:name xml:lang="it">codice della qualifica</sh:name>
        <sh:description xml:lang="es">Un código de identificación procedente de un activo semántico de referencia basado en cualificaciones. Esta propiedad se utiliza para clasificar la información sobre una cualificación con una cualificación de un marco de cualificaciones conocido (por ejemplo, el enlace a la cualificación acreditada por el marco nacional de cualificaciones). Si se facilita, el valor debe proceder de un vocabulario controlado.</sh:description>
        <sh:description xml:lang="cs">Identifikační kód z referenčního sémantického aktiva založeného na kvalifikaci. Tato vlastnost se používá k zařazení informací o kvalifikaci pod nějakou kvalifikaci ze známého rámce kvalifikací (např. odkaz na akreditovanou kvalifikaci podle národního rámce kvalifikací). Poskytnutá hodnota by měla být převzata z řízeného slovníku.</sh:description>
        <sh:description xml:lang="hr">Identifikacijska oznaka iz referentne semantičke stavke koja se temelji na kvalifikacijama. Ovo se svojstvo upotrebljava za razvrstavanje informacija o kvalifikacijama s kvalifikacijama iz poznatog kvalifikacijskog okvira (npr. poveznica na akreditirane kvalifikacije iz nacionalnog kvalifikacijskog okvira). Ako je navedena, vrijednost bi trebala biti iz kontroliranog rječnika.</sh:description>
        <sh:description xml:lang="et">Kvalifikatsioonipõhise semantika alusvara identifitseerimiskood. Seda omadust kasutatakse kvalifikatsiooniteabe liigitamiseks teadaoleva kvalifikatsiooniraamistiku kvalifikatsiooniga (nt link akrediteeritud riikliku kvalifikatsiooniraamistiku kvalifikatsioonile). Kui väärtus on märgitud, peaks see pärinema kontrollitud sõnastikust.</sh:description>
        <sh:name xml:lang="pt">código da qualificação</sh:name>
        <sh:description xml:lang="sv">En identifieringskod från en kvalifikationsbaserad semantisk referenstillgång. Denna egenskap används för att klassificera informationen om kvalifikation med en kvalifikation från en känd referensram för kvalifikationer (t.ex. länken till den ackrediterade kvalifikationen enligt den nationella referensramen för kvalifikationer). I förekommande fall ska värdet komma från en kontrollerad ordlista.</sh:description>
        <sh:description xml:lang="de">Ein Identifizierungscode aus einer qualifikationsbasierten semantischen Bezugsgröße. Diese Eigenschaft dient zur Klassifizierung der Qualifikationsinformationen mit einer Qualifikation aus einem bekannten Qualifikationsrahmen. (z. B. Link zur akkreditierten NQR-Qualifikation). Falls angegeben, sollte der Wert aus einem kontrollierten Vokabular stammen.</sh:description>
        <sh:description xml:lang="da">En identifikationskode fra et kvalificeringsbaseret semantisk referenceaktiv. Egenskaben anvendes til at klassificere oplysningerne om kvalifikationen med en kvalifikation fra en kendt kvalifikationsramme (f.eks. sammenhæng med den akkrediterede NQF-kvalifikation). Hvis oplyst, skal værdien tages fra en kontrolleret ordliste.</sh:description>
        <sh:name xml:lang="es">código de cualificación</sh:name>
        <sh:name xml:lang="pl">kod kwalifikacji</sh:name>
        <sh:name xml:lang="is">hæfnikóði</sh:name>
        <sh:description xml:lang="lv">Identifikācijas kods no semantiska atsauces aktīva, kura pamatā ir kvalifikācijas. Šo rekvizītu izmanto, lai informāciju par kvalifikāciju klasificētu pie kvalifikācijas, kas nāk no zināmas kvalifikācijas sistēmas. (Piemēram, saite uz akreditēto VKI kvalifikāciju). Var norādīt tikai vērtības, kas ņemtas no kontrolētas vārdnīcas.</sh:description>
        <sh:description xml:lang="en">An identifying code from a qualification based reference semantic asset. This property is used to classify the qualification information with a qualification from a known qualification framework. (e.g., the link to the accredited QF qualification).</sh:description>
        <sh:name xml:lang="lv">kvalifikācijas kods</sh:name>
        <sh:description xml:lang="en">An identifying code from a qualification-based reference semantic asset. This property is used to classify the qualification information with a qualification from a known qualification framework. (e.g., the link to the accredited NQF qualification). If provided, the value should come from a controlled vocabulary.</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="pt">A especificação de um processo de avaliação e validação obtido quando um organismo competente determina que uma pessoa alcançou resultados de aprendizagem de acordo com determinadas normas.</rdfs:comment>
    <rdfs:label xml:lang="mt">Kwalifika</rdfs:label>
    <rdfs:comment xml:lang="bg">Спецификация на процес на оценяване и валидиране, получена, когато компетентен орган определи, че дадено лице е постигнало резултати от обучението, съответстващи на определени стандарти.</rdfs:comment>
    <rdfs:comment xml:lang="it">Specifica di un processo di valutazione e convalida, che si ottiene quando un'autorità competente stabilisce che una persona ha conseguito risultati di apprendimento ai livelli stabiliti.</rdfs:comment>
    <rdfs:label xml:lang="nl">Kwalificatie</rdfs:label>
    <rdfs:comment xml:lang="sk">Špecifikácia procesu hodnotenia a potvrdzovania získaného vo chvíli, keď príslušný orgán rozhodne, že jednotlivec dosiahol vzdelávacie výstupy zodpovedajúce daným normám.</rdfs:comment>
    <rdfs:label xml:lang="sk">Kvalifikácia</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Qualification-elm_entryRequirement">
        <sh:description xml:lang="da">Specifikt adgangskrav eller specifik forudsætning for enkeltpersoner, for hvilke denne specifikation for læringsresultater er udformet med henblik på at starte denne læringsmulighed.</sh:description>
        <sh:description xml:lang="sk">Osobitná vstupná požiadavka alebo predpoklad, pokiaľ ide o jednotlivcov, v prípade ktorých je daná špecifikácia vzdelávacieho výstupu určená na začatie tejto príležitosti na vzdelávanie.</sh:description>
        <sh:description xml:lang="hu">Konkrét felvételi követelmény vagy előfeltétel azok számára, akikre vonatkozóan a tanulási eredmények specifikációja meghatározza a tanulási lehetőség kezdetét.</sh:description>
        <sh:name xml:lang="de">Zugangsvoraussetzungen</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="en">Specific entry requirements or prerequisites of individuals for which this specification is designed to start this learning opportunity.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:description xml:lang="hr">Poseban uvjet za upis ili preduvjet za pojedince za koje je specifikacija obrazovnog postignuća osmišljena kako bi se aktivirala ova mogućnost učenja.</sh:description>
        <sh:name xml:lang="ga">riachtanas iontrála</sh:name>
        <sh:name xml:lang="en">entry requirements</sh:name>
        <sh:description xml:lang="ro">Cerință specifică de admitere sau condiție prealabilă impusă persoanelor pentru care este concepută această specificație a rezultatelor învățării în vederea beneficierii de această oportunitate de învățare.</sh:description>
        <sh:name xml:lang="el">προϋπόθεση εγγραφής</sh:name>
        <sh:description xml:lang="nl">Specifieke toelatingsvereiste of eerste vereiste van individuen voor wie deze leerprestatiespecificatie is bedoeld om aan deze leermogelijkheid te beginnen.</sh:description>
        <sh:name xml:lang="et">sisenemistingimused</sh:name>
        <sh:description xml:lang="el">Ειδική απαίτηση ή προαπαιτούμενο εισόδου για άτομα για τα οποία η συγκεκριμένη προδιαγραφή μαθησιακού επιτεύγματος έχει σχεδιαστεί για την έναρξη της συγκεκριμένης ευκαιρίας μάθησης.</sh:description>
        <sh:name xml:lang="nl">toelatingsvereiste</sh:name>
        <sh:name xml:lang="sv">behörighetskrav</sh:name>

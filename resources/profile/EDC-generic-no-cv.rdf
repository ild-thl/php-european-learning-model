        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="en">An earned right, e.g., to practice a profession, take advantage of a learning opportunity or join an organisation, as a result of the acquisition of knowledge, skills, responsibility and/or autonomy.</rdfs:comment>

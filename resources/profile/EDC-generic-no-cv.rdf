        <sh:name xml:lang="en">embedded evidence</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="fr">Les informations intégrées sur le processus qui a abouti à la délivrance du justificatif vérifiable.</sh:description>
        <sh:description xml:lang="lt">Įterpta informacija apie procesą, po kurio buvo išduotas patikrinamas kredencialas.</sh:description>
        <sh:description xml:lang="ga">An fhaisnéis leabaithe faoin bpróiseas as ar eascair eisiúint an dintiúir infhíoraithe.</sh:description>
        <sh:description xml:lang="de">Die eingebetteten Informationen über den Prozess, der zur Ausstellung des überprüfbaren Nachweises geführt hat.</sh:description>
        <sh:name xml:lang="pl">dowody osadzone</sh:name>
        <sh:name xml:lang="mk">вметнат доказ</sh:name>
        <sh:description xml:lang="sk">Vložené informácie o postupe, ktorého výsledkom bolo vydanie overiteľného certifikátu.</sh:description>
        <sh:description xml:lang="sr">Уграђене информације о процесу који је за резултат имао издавање акредитива који се може верификовати.</sh:description>
        <sh:name xml:lang="fi">upotettu todiste</sh:name>
        <sh:description xml:lang="fi">Upotetut tiedot todennettavan osaamistodistuksen myöntämiseen johtaneesta prosessista.</sh:description>
        <sh:name xml:lang="pt">comprovativo incorporado</sh:name>
        <sh:name xml:lang="de">eingebetteter Nachweis</sh:name>
        <sh:name xml:lang="el">ενσωματωμένα αποδεικτικά στοιχεία</sh:name>
        <sh:name xml:lang="da">indlejret dokumentation</sh:name>
        <sh:description xml:lang="el">Οι ενσωματωμένες πληροφορίες σχετικά με τη διαδικασία που οδήγησε στην έκδοση του επαληθεύσιμου διαπιστευτηρίου.</sh:description>
        <sh:description xml:lang="pt">As informações incorporadas sobre o processo que resultou na emissão da credencial verificável.</sh:description>
        <sh:name xml:lang="es">pruebas incorporadas</sh:name>
        <sh:description xml:lang="tr">Doğrulanabilir yeterlilik kanıtının düzenlenmesi sonucunu sağlayan süreç hakkındaki iliştirilmiş bilgiler.</sh:description>
        <sh:description xml:lang="pl">Informacje osadzone na temat procesu, który doprowadził do wydania weryfikowalnego poświadczenia.</sh:description>
        <sh:name xml:lang="mt">evidenza inkorporata</sh:name>
        <sh:name xml:lang="hr">ugrađeni dokazi</sh:name>
        <sh:name xml:lang="sr">уграђени доказ</sh:name>
        <sh:description xml:lang="no">Den innebygde informasjonen om prosessen som resulterte i utstedelsen av den verifiserbare legitimasjonen.</sh:description>
        <sh:name xml:lang="me">ugrađeni dokazi</sh:name>

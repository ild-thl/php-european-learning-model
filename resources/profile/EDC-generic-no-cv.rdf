        <sh:name xml:lang="mt">Tariffi</sh:name>
        <sh:description xml:lang="cs">Informace o ceně kurzu, včetně poplatků a možnosti stipendií/grantů, které jsou k dispozici.</sh:description>
        <sh:name xml:lang="ro">Taxe</sh:name>
        <sh:name xml:lang="sl">Pristojbine</sh:name>
        <sh:name xml:lang="en">price detail</sh:name>
        <sh:name xml:lang="lt">Mokesčiai už mokslą</sh:name>
        <sh:description xml:lang="ro">Informații despre prețul cursului, inclusiv taxe și subvenții/burse disponibile.</sh:description>
        <sh:description xml:lang="sv">Information om kursens prissättning, inklusive avgifter och tillgängliga stipendier/rabatter.</sh:description>
        <sh:description xml:lang="mk">Информации за цените на курсот, вклучително и надокнади и достапни стипендии / субвенции.</sh:description>
        <sh:name xml:lang="pl">Opłaty</sh:name>
        <sh:description xml:lang="da">Oplysninger om prisen på kurset, herunder gebyrer og tilgængelige stipendier/tilskud.</sh:description>
        <sh:description xml:lang="en">Information about the pricing of the course, including fees and scholarships/subsidies available.</sh:description>
        <sh:name xml:lang="da">Gebyrer</sh:name>
        <sh:name xml:lang="no">Avgifter</sh:name>
        <sh:name xml:lang="sv">Avgifter</sh:name>
        <sh:description xml:lang="it">Informazioni sul costo del corso, comprese tasse e borse di studio/sussidi disponibili.</sh:description>
        <sh:description xml:lang="et">Teave kursuse hinna kohta, sealhulgas olemasolevad tasud ja stipendiumid/toetused.</sh:description>
        <sh:name xml:lang="mk">Надоместоци</sh:name>
        <sh:description xml:lang="sk">Informácie o cene kurzu vrátane poplatkov a dostupných štipendií/dotácií.</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="sr">Услови, као што су време и локација, под којима неко може да усвоји скуп знања и/или вештина за одговорну и самосталну примену.</rdfs:comment>
    <rdfs:label xml:lang="ro">Oportunitate de învățare</rdfs:label>

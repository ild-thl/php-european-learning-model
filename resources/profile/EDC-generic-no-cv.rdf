    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/DisplayParameter"/>
    <rdfs:label xml:lang="sr">Параметар за приказ</rdfs:label>
    <rdfs:label xml:lang="pt">Parâmetro de visualização</rdfs:label>
    <rdfs:label xml:lang="is">Mörk glugga</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/DisplayParameter-elm_primaryLanguage">
        <sh:description xml:lang="pt">A língua principal da credencial (só pode ser aplicada uma língua). O valor indicado deve provir da lista de autoridade relativa às línguas (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="mk">Примарен јазик на акредитивот (може да се примени само еден јазик). Наведената вредност мора да биде од листата на именувани јазици од надлежните органи (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="sv">Referensens primära språk (endast ett språk kan användas). Det tillhandahållna värdet måste komma från auktoritetsregistret för namn på språk (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="it">Lingua principale</sh:name>
        <sh:description xml:lang="me">Primarni jezik kredencijala (može se primijeniti samo jedan jezik). Navedena vrijednost mora da potiče sa Liste ovlašćenja sa nazivima jezika (http://publications.europa.eu/resource/authoriti/language).</sh:description>
        <sh:name xml:lang="hu">Elsődleges nyelv</sh:name>
        <sh:description xml:lang="pl">Język główny, w którym sporządzono poświadczenie (można zastosować wyłącznie jeden język). Podana wartość musi pochodzić z autorytatywnego wykazu języków (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="tr">Dil</sh:name>
        <sh:name xml:lang="lv">Primārā valoda</sh:name>
        <sh:description xml:lang="et">Tõendi peamine keel (kasutada saab ainult ühte keelt). Märgitud väärtus peab pärinema keele normandmeloendist (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="lt">Kredencialo pirminė kalba (gali būti tik viena kalba). Pateikta vertė turi būti iš kalbų vardinių autoritetinių duomenų sąrašo (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="bg">Предпочитан език</sh:name>
        <sh:description xml:lang="bg">Основният език на удостоверението (може да се използва само един език). Посочената стойност трябва да е от номенклатурния списък на езиците (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="fi">Osaamistodistuksen ensisijainen kieli (vain yksi kieli on mahdollinen). Arvon on oltava Language (kieli) -NAL-luettelon mukainen(http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:name xml:lang="es">Idioma principal</sh:name>
        <sh:name xml:lang="nl">Eerste taal</sh:name>
        <sh:name xml:lang="cs">Primární jazyk</sh:name>
        <sh:description xml:lang="cs">Primární jazyk certifikátu (lze použít pouze jeden jazyk).Poskytnutá hodnota musí být převzata ze Seznamu Určených orgánů pro jazyk (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="ro">Limba principală a acreditării (se poate selecta o singură limbă). Valoarea furnizată trebuie să provină din lista de limbi desemnate ale autorității (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="en">primary language</sh:name>
        <sh:description xml:lang="hr">Glavni jezik vjerodajnice (može se primijeniti samo jedan jezik). Navedena vrijednost mora biti s popisa jezika imenovanog tijela (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="ro">Limba principală</sh:name>
        <sh:name xml:lang="fi">Ensisijainen kieli</sh:name>
        <sh:description xml:lang="nl">De eerste taal van de credential (er kan slechts één taal worden toegepast). De verstrekte waarde moet afkomstig zijn uit de standaardnamenlijst van talen (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="lv">Apliecinājuma dokumenta pamatvaloda (var izmantot tikai vienu valodu). Var norādīt tikai vērtības, kas ņemtas no valodu nosaukumu autoritatīvā saraksta (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:name xml:lang="lt">Pagrindinė kalba</sh:name>
        <sh:name xml:lang="is">Aðaltungumál</sh:name>
        <sh:description xml:lang="tr">Yeterlilik kanıtının ana dili (sadece bir dil uygulanabilir).Verilen değer Dil Birimi Adı Verilmiş Yetkili Listesinden gelmelidir (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="de">Hauptsprache</sh:name>
        <sh:description xml:lang="en">The primary language of the credential (only one language can be applied).</sh:description>
        <sh:name xml:lang="pl">Język główny</sh:name>
        <sh:description xml:lang="is">Frummál skilríkis (aðeins er hægt að velja eitt tungumál).Uppgefin gildi verða að koma af lista yfir Tungumálaheiti yfirvalda (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="en">The primary language of the credential (only one language can be applied). The provided value must come from the Language Named Authority List (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="es">La lengua principal de la credencial (solo puede aplicarse una lengua). El valor facilitado debe proceder de la Lista autorizada de nombres Lengua (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="fr">La première langue du justificatif (une seule langue peut être appliquée). La valeur fournie doit provenir de la liste d’autorités de la Langue (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="pt">Primeira língua</sh:name>
        <sh:description xml:lang="it">La lingua principale della credenziale (può essere applicata una sola lingua). Il valore fornito deve essere tratto dalle lingue indicate nell'elenco delle autorità designate (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="hr">Prvi preferirani jezik</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/primaryLanguage"/>
        <sh:description xml:lang="el">Η κύρια γλώσσα του διαπιστευτηρίου (μπορεί να εφαρμοστεί μόνο μία γλώσσα).Η παρεχόμενη τιμή πρέπει να προέρχεται από τον κατάλογο εγκεκριμένων ονομάτων «Language» (Γλώσσα) (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="no">Hovedspråket for legitimasjonen (kun ett språk kan brukes). Den oppgitte verdien må komme fra Language Named Authority-listen (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="sv">Första språk</sh:name>
        <sh:name xml:lang="fr">Première langue</sh:name>
        <sh:description xml:lang="hu">A tanúsítvány elsődleges nyelve (csak egy nyelv adható meg). A megadott értéknek a nyelvek szójegyzékéből kell származnia (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="ga">Príomhtheanga an dintiúir (ní féidir ach teanga amháin a chur i bhfeidhm). Ní mór an luach a chuirfear ar fáil teacht ó Liosta na nÚdarás Ainmnithe de réir Teanga (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="de">Die Hauptsprache des Nachweises (nur eine Sprache kann verwendet werden). Der angegebene Wert muss aus der Sprachautoritätsliste (http://publications.europa.eu/resource/authority/language) stammen.</sh:description>
        <sh:description xml:lang="sl">Primarni jezik potrdila (uporabi se lahko samo en jezik). Navedena vrednost mora izhajati z referenčnega seznama jezikov (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="et">Esmane keel</sh:name>
        <sh:name xml:lang="sk">Prvý jazyk</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >7</sh:order>
        <sh:description xml:lang="sk">Primárny jazyk certifikátu (možno použiť iba jeden jazyk). Poskytnutá hodnota musí byť zo zoznamu určených orgánov pre jazyky (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="mt">Il-lingwa primarja tal-kredenzjali (tista’ tiġi applikata lingwa waħda biss). Il-valur ipprovdut irid jiġi mil-Lista tal-Awtorità Imsemmija tal-Lingwa(http://publications.europa.eu/resource/authority/language).</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:description xml:lang="sr">Примарни језик акредитива (само један језик може да се примени). Наведена вредност мора да потиче са именованог одобреног списка Језик (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="ga">Príomhtheanga</sh:name>
        <sh:name xml:lang="no">Hovedspråk</sh:name>
        <sh:name xml:lang="mk">Примарен јазик</sh:name>
        <sh:name xml:lang="el">Κύρια γλώσσα</sh:name>
        <sh:name xml:lang="mt">Lingwa Primarja</sh:name>
        <sh:description xml:lang="da">Eksamensbevisets primære sprog (der kan kun angives ét sprog). Den angivne værdi skal tages fra listen Language Named Authority (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="sl">Želeni jezik</sh:name>
        <sh:name xml:lang="da">Primært sprog</sh:name>
      </sh:PropertyShape>
    </sh:property>

  <sh:NodeShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/ClaimShape">
    <rdfs:comment xml:lang="sk">Súbor vyjadrení o konajúcom Subjekte v súvislosti so vzdelávaním a/alebo zamestnaním. Táto trieda má vlastnosti spoločné pre všetky vyhlásenia vrátane Vzdelávacieho výstupu, Vzdelávacej činnosti, Hodnotenia vzdelávania a Vzdelávacieho nároku. Slúži ako rozširujúci bod, ktorý umožňuje vymedzenie ďalších podtried.</rdfs:comment>
    <rdfs:comment xml:lang="it">Una serie di dichiarazioni relative a un agente nel contesto dell'apprendimento e/o dell'impiego. Questa classe presenta proprietà comuni a tutte le affermazioni, compresi i risultati dell'apprendimento, l'attività di apprendimento, la valutazione dell'apprendimento e il diritto all'apprendimento. Funge da punto di estensione che consente di definire sottoclassi supplementari.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Claim-elm_awardedBy">
        <sh:description xml:lang="sv">Detaljerna för att utfärda uppsättningen av uttalanden som gjorts om en aktör i samband med lärande och/eller anställning.</sh:description>
        <sh:description xml:lang="hr">Pojedinosti dodjele o skupu izjava o predstavniku u kontekstu učenja i/ili zapošljavanja.</sh:description>
        <sh:name xml:lang="bg">Присъдено от</sh:name>
        <sh:description xml:lang="it">Le informazioni dettagliate in merito al riconoscimento riguardanti la serie di dichiarazioni presentate riguardo a un agente nel contesto dell'apprendimento e/o dell'impiego.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >3</sh:order>
        <sh:description xml:lang="mt">Id-dettalji tal-għoti tas-sett ta’ dikjarazzjonijiet magħmula dwar Aġent fil-kuntest tat-tagħlim u/jew tal-impjieg.</sh:description>
        <sh:name xml:lang="sk">Udelené</sh:name>
        <sh:description xml:lang="et">Esindaja kohta õppimise ja/või töötamise kontekstis esitatud tõendite kogumi väljaandmise üksikasjad.</sh:description>
        <sh:name xml:lang="cs">Udělující subjekt</sh:name>
        <sh:description xml:lang="me">Detalji o dodjeli skupa izjava o Agentu u kontekstu učenja i/ili zaposlenja.</sh:description>
        <sh:name xml:lang="lv">Piešķīrējs</sh:name>
        <sh:description xml:lang="pt">Os dados de atribuição relativos ao conjunto de declarações formuladas sobre um agente no contexto da aprendizagem e/ou do emprego.</sh:description>
        <sh:name xml:lang="el">απονεμήθηκε από</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="mt">Mogħtija minn</sh:name>
        <sh:description xml:lang="no">Tildelingsdetaljene for settet med erklæringer om en agent i sammenheng med læring og/eller ansettelse.</sh:description>
        <sh:name xml:lang="no">Tildelt av</sh:name>
        <sh:description xml:lang="tr">Öğrenme ve / veya istihdam bağlamında bir Acente hakkında yapılan bir dizi beyanın verilen detayları.</sh:description>
        <sh:name xml:lang="hr">Dodijelio/dodijelila</sh:name>
        <sh:name xml:lang="sl">Podelil/a</sh:name>
        <sh:description xml:lang="mk">Деталите за доделување од збирот на изјави направени за агент во контекст на учење и / или вработување.</sh:description>
        <sh:name xml:lang="pt">Atribuída por:</sh:name>
        <sh:description xml:lang="hu">A szervről a tanulással és/vagy a foglalkoztatással összefüggésben tett nyilatkozatok összességének odaítélt információi.</sh:description>
        <sh:description xml:lang="bg">Свързаните с присъждане данни за набора от изявления относно извършител в контекста на учене и/или заетост.</sh:description>
        <sh:name xml:lang="ga">Arna bhronnadh ag</sh:name>
        <sh:name xml:lang="lt">Suteikė</sh:name>
        <sh:description xml:lang="is">Upplýsingar um viðurkenningu sem heyrir undir safn fullyrðinga sem settar eru fram um aðila í tengslum við nám og/eða starf.</sh:description>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/AwardingProcess"/>
        <sh:description xml:lang="en">The awarding details of the set of statements made about an Agent in the context of learning and / or employment.</sh:description>
        <sh:name xml:lang="hu">Kiállította:</sh:name>
        <sh:description xml:lang="sl">Podrobnosti o dodelitvi v zvezi z nizom izjav o Vršilcu dejanja v okviru učenja in/ali zaposlitve.</sh:description>
        <sh:description xml:lang="sk">Podrobnosti o udelení kvalifikácie, pokiaľ ide o súbor vyjadrení o konajúcom Subjekte v súvislosti so vzdelávaním a/alebo zamestnaním.</sh:description>
        <sh:name xml:lang="sv">Utfärdad av</sh:name>
        <sh:name xml:lang="fi">Myöntäjä</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="de">Die Vergabedetails der Reihe von Aussagen, die über einen Akteur im Zusammenhang mit dem Lernen und/oder der Beschäftigung gemacht werden.</sh:description>
        <sh:description xml:lang="lt">Informacija apie pareiškimų apie subjektą atsižvelgiant į mokymąsi ir (arba) užimtumą suteikimą.</sh:description>
        <sh:name xml:lang="mk">Доделена од</sh:name>
        <sh:name xml:lang="en">awarded by</sh:name>
        <sh:name xml:lang="tr">Belgelendiren</sh:name>
        <sh:description xml:lang="pl">Szczegóły dotyczące uzyskania rezultatu w zakresie zbioru opinii na temat podmiotu złożonych w kontekście uczenia się lub zatrudnienia.</sh:description>
        <sh:name xml:lang="et">Väljaandja</sh:name>
        <sh:name xml:lang="de">Verliehen von</sh:name>
        <sh:description xml:lang="nl">De uitreikingsdetails van de reeks beweringen die zijn gedaan over een gemachtigde in het kader van leren en/of werken.</sh:description>
        <sh:description xml:lang="fi">Toimijasta annetun oppimiseen ja/tai työkokemukseen liittyvän lausuntokokonaisuuden myöntämistä koskevat tiedot.</sh:description>
        <sh:description xml:lang="ga">Na mionsonraí bronnta a bhaineann le sraith ráiteas a rinneadh faoi Ghníomhaire i gcomhthéacs na foghlama agus/nó na fostaíochta.</sh:description>
        <sh:description xml:lang="en">The awarding details of this claim.</sh:description>
        <sh:name xml:lang="da">Tildelt af</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/awardedBy"/>
        <sh:description xml:lang="el">Οι λεπτομέρειες χορήγησης του συνόλου των διατυπώσεων σχετικά με έναν Παράγοντα στο πλαίσιο της μάθησης και/ή της απασχόλησης.</sh:description>
        <sh:name xml:lang="it">Rilasciato da</sh:name>
        <sh:description xml:lang="da">Tildelingsoplysninger om sættet af erklæringer om en agent vedrørende læring og/eller beskæftigelse.</sh:description>
        <sh:description xml:lang="lv">Dati par paziņojumu kopuma piešķiršanu par aktoru mācību un/vai nodarbinātības kontekstā.</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:name xml:lang="ro">Acordată de</sh:name>
        <sh:name xml:lang="pl">Poświadczył/a</sh:name>
        <sh:name xml:lang="nl">Toegekend door</sh:name>
        <sh:description xml:lang="sr">Детаљи о додели из скупа изјава које су дате о Чиниоцу у контексту учења и/или запослења.</sh:description>
        <sh:description xml:lang="es">La información de concesión del conjunto de afirmaciones realizadas sobre un Agente en el contexto del aprendizaje o del empleo.</sh:description>
        <sh:description xml:lang="ro">Detaliile legate de atribuire ale setului de afirmații făcute cu privire la un agent în contextul învățării și/sau al ocupării unui loc de muncă.</sh:description>
        <sh:description xml:lang="cs">Podrobnosti o udělení kvalifikace ohledně souboru prohlášení učiněných o Subjektu v souvislosti se vzděláváním a/nebo zaměstnáním.</sh:description>
        <sh:name xml:lang="me">Dodijeljeno od strane</sh:name>
        <sh:name xml:lang="is">Veitt af</sh:name>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:description xml:lang="fr">Les informations d’attribution de l’ensemble de déclarations faites à propos d’un agent dans le contexte d’un apprentissage et/ou d’un emploi.</sh:description>
        <sh:name xml:lang="fr">Attribué par</sh:name>
        <sh:name xml:lang="es">Otorgado por</sh:name>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="mk">Збир на изјави за агент во контекст на учење и / или вработување. Оваа класа има својства кои се заеднички за сите барања, вклучувајќи постигање во учење, активност на учење, процена на учење и право на учење. Таа служи како точка на проширување која овозможува дефинирање на дополнителни поткласи.</rdfs:comment>
    <rdfs:label xml:lang="ro">Afirmație</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Claim-adms_identifier">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="http://www.w3.org/ns/adms#identifier"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >0</sh:order>
        <sh:or rdf:parseType="Collection">
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Identifier"/>
          </rdf:Description>
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LegalIdentifier"/>
          </rdf:Description>
        </sh:or>
        <sh:name xml:lang="en">identifier</sh:name>
        <sh:description xml:lang="en">Links a resource to an adms:Identifier class.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="fr">Un ensemble de déclarations faites à propos d’un agent dans le contexte d’un apprentissage et/ou d’un emploi. Cette classe comporte des propriétés communes à toutes les affirmations, y compris Acquis d’apprentissage, Activité d’apprentissage, Évaluation d’apprentissage et Droit d’apprentissage. Elle sert de point d’extension permettant de définir des sous-classes supplémentaires.</rdfs:comment>
    <rdfs:comment xml:lang="ro">O serie de afirmații făcute cu privire la un agent în contextul învățării și/sau al ocupării unui loc de muncă. Această clasă are proprietăți comune tuturor afirmațiilor, inclusiv rezultatul învățării, activitatea de învățare, evaluarea învățării și dreptul de a învăța. Servește drept punct de extindere care permite definirea unor subclase suplimentare.</rdfs:comment>
    <rdfs:comment xml:lang="et">Tõendite kogum, mis on tehtud esindaja kohta õppimise ja/või töötamise kontekstis. Sellel klassil on kõigi tõendite ühised omadused, sealhulgas õpitulemus, õpitegevus, õpihindamine ja õppimisõigus. See toimib laienduspunktina, mis võimaldab määratleda täiendavaid alamklasse.</rdfs:comment>
    <rdfs:comment xml:lang="en">A set of statements made about an Agent in the context of learning and / or employment. This class carries properties common to all claims, including Learning Achievement, Learning Activity, Learning Assessment and Learning Entitlement. It serves as an extension point that enables the definition of additional subclasses.</rdfs:comment>
    <rdfs:comment xml:lang="sl">Niz podanih izjav o Vršilcu dejanja v okviru učenja in/ali zaposlitve. Ta razred vsebuje lastnosti, ki so skupne vsem trditvam, vključno s trditvami Učni dosežek, Učna dejavnost, Ocena učnih rezultatov in Upravičenost na podlagi izobrazbe. Uporablja se kot razširitvena točka, ki omogoča opredelitev dodatnih podrazredov.</rdfs:comment>
    <rdfs:comment xml:lang="bg">Набор от изявления относно извършител в контекста на учене и/или заетост. Този клас съдържа свойства, които са общи за всички твърдения, включително учебно постижение, учебна дейност, оценка на учене и произтичащо от обучение право. Той служи за определяне на допълнителни подкласове.</rdfs:comment>
    <rdfs:label xml:lang="sl">Trditev</rdfs:label>
    <rdfs:comment xml:lang="da">En række udsagn om en agent i forbindelse med læring og/eller beskæftigelse. Denne klasse har egenskaber, der er fælles for alle forespørgsler, herunder læringsresultat, læringsaktivitet, læringsvurdering og læringsrettighed. Den fungerer som en udvidelse, der gør det muligt at definere yderligere underklasser.</rdfs:comment>
    <rdfs:comment xml:lang="hu">A szervről a tanulással és/vagy a foglalkoztatással összefüggésben tett nyilatkozatok összessége. Ez az osztály az összes állításra (pl. tanulási eredmények, tanulási tevékenység, a tanulás értékelése, képzési jogosultság) vonatkozóan közös tulajdonságokkal rendelkezik. Egy állításból további alárendelt osztályok határozhatók meg.</rdfs:comment>
    <rdfs:comment xml:lang="hr">Skup izjava o predstavniku u kontekstu učenja i/ili zapošljavanja. Ovaj razred ima svojstva koja su zajednička svim zahtjevima, uključujući obrazovna postignuća, aktivnost učenja, procjenu ishoda učenja i prava koja proizlaze iz učenja. Služi kao točka proširenja koja omogućuje definiranje dodatnih podrazreda.</rdfs:comment>
    <rdfs:comment xml:lang="cs">Soubor prohlášení učiněných o Subjektu v souvislosti se vzděláváním a/nebo zaměstnáním. Tato třída má společné vlastnosti pro všechna tvrzení, včetně Studijních výsledků, Vzdělávací aktivity, Hodnocení učení a Nároku na vzdělávání. Slouží jako rozšiřující bod, který umožňuje definovat další podtřídy.</rdfs:comment>
    <rdfs:label xml:lang="de">Aussage</rdfs:label>
    <rdfs:comment xml:lang="de">Eine Reihe von Aussagen, die über einen Akteur im Zusammenhang mit dem Lernen und/oder der Beschäftigung gemacht werden. Diese Kategorie enthält Eigenschaften, die allen Aussagen gemeinsam sind, wie z. B. Lernleistung, Lernaktivität, Lernbewertung und Anspruch auf Teilnahme an Bildungsmaßnahmen. Sie dient als Erweiterungspunkt, der die Definition von weiteren untergeordneten Klassen ermöglicht.</rdfs:comment>
    <rdfs:comment xml:lang="ga">Sraith ráiteas a rinneadh faoi Ghníomhaire i gcomhthéacs na foghlama agus/nó na fostaíochta. Tá tréithe ag an aicme seo a bhaineann le gach éileamh, lena n-áirítear Gnóthachtáil Foghlama, Gníomhaíocht Foghlama, Measúnú Foghlama agus Teidlíocht Foghlama. Feidhmíonn sé mar phointe sínidh lenar féidir fo-aicmí breise a shainmhíniú.</rdfs:comment>
    <rdfs:comment xml:lang="en">A claim made by an issuer.</rdfs:comment>
    <rdfs:comment xml:lang="me">Skup izjava datih o Agentu u kontekstu učenja i/ili zaposlenja. Ova klasa nosi svojstva zajednička za sve zahtjeve, uključujući postignuća u učenju, aktivnost učenja, procjenu učenja i pravo na učenje. Služi kao tačka proširenja koja omogućava definisanje dodatnih podklasa.</rdfs:comment>
    <rdfs:comment xml:lang="tr">Öğrenme ve / veya istihdam bağlamında bir Acente hakkında yapılan bir dizi beyan. Bu sınıf Öğrenme Edinimi, Öğrenme Faaliyeti, Öğrenme Değerlendirmesi ve Öğrenme Yetkisi dahil olmak üzere tüm talepler için ortak özellikler taşır. İlave alt sınıfların tanımını sağlayan bir genişleme noktası olarak hizmet sunar.</rdfs:comment>
    <rdfs:comment xml:lang="pl">Zbiór opinii na temat podmiotu złożonych w kontekście uczenia się lub zatrudnienia. Ta klasa obejmuje właściwości wspólne dla wszystkich oświadczeń, uwzględniając rezultaty nauczania, działania edukacyjne, oceny z nauki i uprawnienia do nauki. Jest to punkt wyjścia umożliwiający zdefiniowanie dodatkowych podklas.</rdfs:comment>
    <rdfs:label xml:lang="da">Forespørgsel</rdfs:label>
    <rdfs:comment xml:lang="sv">En uppsättning uttalanden som gjorts om en aktör i samband med lärande och/eller anställning. Denna klass har egenskaper som är gemensamma för alla påståenden, inklusive läranderesultat, inlärningsaktivitet, bedömning av lärande och läranderättighet. Den fungerar som en tilläggspunkt som möjliggör definition av ytterligare underklasser.</rdfs:comment>
    <rdfs:comment xml:lang="lt">Teiginiai apie subjektą atsižvelgiant į mokymąsi ir (arba) užimtumą. Šiai klasei būdingos visiems teiginiams bendros savybės, įskaitant mokymosi rezultatus, mokymosi veiklą, mokymosi vertinimą ir studijų suteikiamą teisę. Tai yra išplėtimo taškas, leidžiantis apibrėžti papildomus poklasius.</rdfs:comment>
    <rdfs:comment xml:lang="mt">Sett ta’ dikjarazzjonijiet magħmula dwar Aġent fil-kuntest tat-tagħlim u/jew tal-impjieg. Din il-klassi ġġorr proprjetajiet komuni għall-claims kollha, inklużi l-Kisba tat-Tagħlim, l-Attività tat-Tagħlim, il-Valutazzjoni tat-Tagħlim u l-Intitolament għat-Tagħlim. Dan iservi bħala punt ta’ estensjoni li jippermetti d-definizzjoni ta’ sottoklassijiet addizzjonali.</rdfs:comment>
    <rdfs:label xml:lang="it">Affermazione</rdfs:label>
    <rdfs:comment xml:lang="pt">Um conjunto de declarações formuladas sobre um agente no contexto de aprendizagem e/ou emprego. Esta classe possui propriedades comuns a todas as declarações, incluindo a aquisição de aprendizagem, a atividade de aprendizagem, a avaliação da aprendizagem e o direito de aprendizagem. Serve de ponto de extensão que permite a definição de subclasses adicionais.</rdfs:comment>
    <rdfs:label xml:lang="is">Vitnisburður</rdfs:label>
    <rdfs:label xml:lang="en">Claim</rdfs:label>
    <rdfs:label xml:lang="mt">Claim</rdfs:label>
    <rdfs:comment xml:lang="fi">Toimijasta annettujen oppimiseen ja/tai työkokemukseen liittyvien lausuntojen joukko. Tässä luokassa on kaikille lausumille yhteisiä ominaisuuksia, mukaan lukien oppimissaavutus, oppimistoimi, oppimisen arviointi ja oppimisen kelpuutus. Se toimii laajennuksena ja mahdollistaa uusien alaluokkien määrittelyn.</rdfs:comment>
    <rdfs:label xml:lang="el">Δήλωση</rdfs:label>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/Claim"/>
    <rdfs:comment xml:lang="no">Et sett med erklæringer om en agent i sammenheng med læring og/eller ansettelse. Denne klassen har egenskaper som er felles for alle krav, inkludert læringsprestasjoner, læringsaktivitet, læringsvurdering og læringsberettigelse. Det fungerer som et utvidelsespunkt som muliggjør definisjon av ytterligere underklasser.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Claim-dc_title">
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:uniqueLang rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean"
        >true</sh:uniqueLang>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="en">Title</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/title"/>
        <sh:description xml:lang="en">A name given to the resource.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:order>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="is">Safn fullyrðinga sem settar eru fram um aðila í tengslum við nám og/eða starf. Þessi flokkur inniheldur eiginleika sem sameiginlegir eru öllum vitnisburðum, meðal annars námsárangri, námsvirkni, námsmati og námsréttindum. Það nýtist sem framlengingarhluti sem gerir skilgreiningu viðbótarundirflokka mögulega.</rdfs:comment>
    <rdfs:label xml:lang="ga">Éileamh</rdfs:label>
    <rdfs:comment xml:lang="sr">Скуп изјава које су дате о Чиниоцу у контексту учења и/или запослења. Ова класа носи својства која су заједничка свим тврдњама, укључујући Достигнуће учења, Активност учења, Образовну процену и Образовно право. Она служи као тачка проширења која омогућава дефинисање додатних подређених класа.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Claim-elm_additionalNote">
        <sh:description xml:lang="ga">Tuilleadh eolais faoi oibiacht nó ábhar a sholáthraítear mar théacs saor.</sh:description>
        <sh:description xml:lang="lv">Brīvā tekstā sniegta papildu informācija par objektu vai tematu.</sh:description>
        <sh:name xml:lang="it">Ulteriori informazioni</sh:name>
        <sh:description xml:lang="mt">Aktar informazzjoni dwar oġġett jew suġġett ipprovduta bħala test liberu.</sh:description>
        <sh:name xml:lang="is">Viðbótarupplýsingar</sh:name>
        <sh:name xml:lang="bg">Допълнителна информация</sh:name>
        <sh:name xml:lang="el">Περισσότερες πληροφορίες</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="cs">Další informace</sh:name>
        <sh:description xml:lang="sl">Dodatne informacije o gradniku ali temi, predložene kot prosto besedilo.</sh:description>
        <sh:description xml:lang="ro">Informații suplimentare despre un obiect sau o temă furnizate sub formă de text liber.</sh:description>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Note"/>
        <sh:name xml:lang="me">Više informacija</sh:name>
        <sh:name xml:lang="hr">Više informacija</sh:name>
        <sh:description xml:lang="it">Ulteriori informazioni su un oggetto o un argomento fornite sotto forma di testo libero.</sh:description>
        <sh:name xml:lang="da">Yderligere oplysninger</sh:name>
        <sh:name xml:lang="lt">Daugiau informacijos</sh:name>
        <sh:description xml:lang="hr">Dodatne informacije o predmetu ili temi koji su navedeni kao slobodni tekst.</sh:description>
        <sh:name xml:lang="sl">Več informacij</sh:name>
        <sh:name xml:lang="fi">Lisätietoja</sh:name>
        <sh:description xml:lang="me">Dodatna slobodna tekstualna napomena o osiguranju kvaliteta ili licenciranju organizacije ili kvalifikacije.</sh:description>
        <sh:name xml:lang="lv">Vairāk informācijas</sh:name>
        <sh:description xml:lang="sk">Ďalšie informácie o objekte alebo téme poskytnuté ako voľný text.</sh:description>
        <sh:description xml:lang="es">Más información sobre un objeto o tema en forma de texto libre.</sh:description>
        <sh:name xml:lang="et">Lisateave</sh:name>
        <sh:description xml:lang="sv">Ytterligare information om ett objekt eller ämne som levereras som fri text.</sh:description>
        <sh:description xml:lang="el">Περαιτέρω πληροφορίες σχετικά με ένα αντικείμενο ή ένα θέμα οι οποίες παρέχονται με τη μορφή ελεύθερου κειμένου.</sh:description>
        <sh:description xml:lang="tr">Serbest metin biçiminde verilen bir konu veya bir nesne hakkında daha fazla bilgi.</sh:description>
        <sh:description xml:lang="pl">Dodatkowe informacje na temat obiektu lub tematu przedstawione jako tekst dowolny.</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="et">Vaba tekstina esitatud lisateave objekti või teema kohta.</sh:description>
        <sh:name xml:lang="mk">Повеќе информации</sh:name>
        <sh:name xml:lang="hu">További információk</sh:name>

  <sh:NodeShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/PersonShape">
    <rdfs:comment xml:lang="bg">Човек (физическо лице).</rdfs:comment>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/Person"/>
    <rdfs:comment xml:lang="tr">Bir insan (gerçek bir kişi).</rdfs:comment>
    <rdfs:comment xml:lang="fr">Un être humain (une personne physique).</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Person-elm_citizenshipCountry">
        <sh:name xml:lang="mk">Државјанство</sh:name>
        <sh:description xml:lang="en">The country (or countries) that conferred citizenship rights on a human being. If provided, the value must come from the Country Named Authority List (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="hr">Zemlja (ili zemlje) koja je pojedincu dodijelila građanska prava. Ako je navedena, vrijednost mora biti s popisa država imenovanog tijela (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/citizenshipCountry"/>
        <sh:name xml:lang="hu">Állampolgárság</sh:name>
        <sh:description xml:lang="is">Land (eða lönd) sem veittu mannveru ríkisborgararétt. Ef til staðar, þarf gildið að koma af lista yfir Landsheiti yfirvalda (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="sv">Medborgarskap</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="hr">Državljanstvo</sh:name>
        <sh:name xml:lang="me">Državljanstvo</sh:name>
        <sh:name xml:lang="sl">Državljanstvo</sh:name>
        <sh:nodekind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:description xml:lang="lt">Šalis (arba šalys), suteikusi žmogui pilietybės teises. Jei pateikiama, vertė turi būti iš šalių vardinių autoritetinių duomenų sąrašo (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="it">Il paese o i paesi che hanno conferito diritti di cittadinanza a un essere umano. Se fornito, il valore deve essere tratto dai paesi indicati nell'elenco delle autorità designate (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="nl">Nationaliteit</sh:name>
        <sh:name xml:lang="sk">Občianstvo</sh:name>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:name xml:lang="tr">Vatandaşlık</sh:name>
        <sh:description xml:lang="pl">Kraj lub kraje, które przyznały tej istocie ludzkiej obywatelstwo. Jeżeli ją podano, wartość ta musi pochodzić z autorytatywnego wykazu państw (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="sv">Det land (eller de länder) som tilldelade medborgerliga rättigheter till en person. I förekommande fall måste värdet komma från auktoritetsregistret för namn på länder (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="pt">O país (ou países) que conferiu direitos de cidadania a uma pessoa. Se for indicado, o valor deve provir da lista de autoridade relativa aos países (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="sk">Krajina alebo krajiny, ktoré osobe priznali práva občana. Poskytnutá hodnota musí byť zo zoznamu určených orgánov jednotlivých krajín (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="fi">Kansalaisuus</sh:name>
        <sh:description xml:lang="sr">Земља (или земље) које особи дају права држављанства. Ако се наводи, вредност мора да потиче са именованог одобреног списка Земља (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="fi">Maa, jossa (tai maat, joissa) henkilölle annettiin kansalaisuus. Jos arvo määritellään, sen on oltava Maa (Country) -NAL-luettelon mukainen(http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="it">Cittadinanza</sh:name>
        <sh:name xml:lang="pt">Nacionalidade</sh:name>
        <sh:name xml:lang="el">Ιθαγένεια</sh:name>
        <sh:name xml:lang="es">Nacionalidad</sh:name>
        <sh:description xml:lang="de">Das Land (oder die Länder), in dem (denen) einem Menschen Bürgerrechte verliehen wurden. Falls angegeben, muss der Wert aus der Länderautoritätsliste stammen (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="no">Statsborgerskap</sh:name>
        <sh:name xml:lang="et">Kodakondsus</sh:name>
        <sh:name xml:lang="fr">Nationalité</sh:name>
        <sh:description xml:lang="mk">Земјата (или земјите) кои ги доделиле правата на државјанство на човечко суштество. Ако е дадена, вредноста мора да биде од листата на именувани јазици од надлежните органи (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="lv">Pilsonība</sh:name>
        <sh:description xml:lang="me">Država (ili države) koje su osobi dodijelile prava na državljanstvo. Ako je navedena, vrijednost mora da potiče sa liste nadležnih za državu (http://publications.europa.eu/resource/authoriti/countri).</sh:description>
        <sh:description xml:lang="no">Landet (eller landene) som ga et mennesket statsborgerrettigheter. Hvis oppgitt, må verdien komme fra listen over land med navn (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="da">Nationalitet</sh:name>
        <sh:description xml:lang="es">El país (o países) que confirió derechos de ciudadanía a un ser humano. Si se facilita, el valor debe proceder de la Lista autorizada de nombres País (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="bg">Гражданство</sh:name>
        <sh:description xml:lang="nl">Het land (of de landen) waarvan een mens de rechten als staatsburger heeft. Indien verstrekt, moet de waarde afkomstig zijn uit de standaardnamenlijst van landen (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="cs">Státní příslušnost</sh:name>
        <sh:description xml:lang="bg">Държавата или държавите, предоставили права на гражданство на човек. Ако бъде посочена, стойността трябва да е от номенклатурния списък на държавите (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="el">Η χώρα (ή οι χώρες) που χορήγησε (χορήγησαν) δικαιώματα ιθαγένειας σε έναν άνθρωπο. Εάν παρέχεται, η τιμή πρέπει να προέρχεται από τον κατάλογο εγκεκριμένων ονομάτων «Country» (Χώρα) (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="da">Land (eller lande), der har givet et menneske borgerskabsrettigheder. Hvis oplyst, skal værdien tages fra listen Country Named Authority (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:name xml:lang="pl">Obywatelstwo</sh:name>
        <sh:description xml:lang="fr">Le(s) pays ayant conféré des droits liés à la citoyenneté à un être humain. Si elle est fournie, la valeur doit provenir de la liste d’autorités du Pays (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="ga">An tír (nó na tíortha) a bhronn cearta saoránachta ar dhuine. Má chuirtear ar fáil é, ní mór an luach teacht ó Liosta na nÚdarás Ainmnithe de réir Tíre (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="mt">Il-pajjiż (jew pajjiżi) li taw drittijiet taċ-ċittadinanza lil bniedem. Jekk jiġi pprovdut, il-valur irid jiġi mil-Lista tal-Awtorità Imsemmija tal-Pajjiż (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="lt">Pilietybė</sh:name>
        <sh:name xml:lang="is">Ríkisfang</sh:name>
        <sh:description xml:lang="ro">Țara care i-a conferit/țările care i-au conferit drepturi cetățenești unei ființe umane. Dacă este furnizată, valoarea trebuie să provină din lista autorităților naționale desemnate (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="hu">Az(ok) az ország(ok), amely(ek) állampolgári jogokkal ruházták fel a személyt. A megadott értéknek az országnevek szójegyzékéből kell származnia (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:name xml:lang="ga">Saoránacht</sh:name>
        <sh:name xml:lang="de">Staatsangehörigkeit</sh:name>
        <sh:description xml:lang="lv">Valsts (vai valstis), kas piešķir pilsonību cilvēkam. Var norādīt tikai vērtības, kas ņemtas no valstu nosaukumu autoritatīvā saraksta (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="tr">Bir insana vatandaşlık hakkı veren ülke (veya ülkeler). Verilmişse, değerin Ülke Adı Verilen Yetki listesinden gelmesi zorunludur (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="sl">Država (ali države), ki je osebi podelila pravice iz državljanstva. Navedena vrednost mora izhajati z referenčnega seznama držav(http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:description xml:lang="en">The country (or countries) that conferred citizenship rights on the person.</sh:description>
        <sh:name xml:lang="ro">Cetățenie</sh:name>
        <sh:description xml:lang="cs">Země, která (které) osobě udělila (udělily) občanská práva. Poskytnutá hodnota musí být převzata ze Seznamu Určených orgánů jednotlivých zemí (http://publications.europa.eu/resource/authority/country).</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:name xml:lang="en">citizenship</sh:name>
        <sh:name xml:lang="mt">Ċittadinanza</sh:name>
        <sh:description xml:lang="et">Riik (või riigid), kes on andnud inimesele kodanikuõigused. Kui väärtus on märgitud, peab see pärinema riikide normandmeloendist (http://publications.europa.eu/resource/authority/country).</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:label xml:lang="bg">Физическо лице</rdfs:label>
    <rdfs:label xml:lang="ga">Duine</rdfs:label>
    <rdfs:comment xml:lang="el">Άνθρωπος (φυσικό πρόσωπο).</rdfs:comment>
    <sh:property rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/elm_order"/>
    <rdfs:comment xml:lang="hu">Ember (természetes személy).</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Person-elm_hasClaim">
        <sh:name xml:lang="me">ima tvrdnju</sh:name>
        <sh:name xml:lang="da">har krav</sh:name>
        <sh:name xml:lang="no">har krav</sh:name>
        <sh:description xml:lang="bg">Набор от изявления относно човек в контекста на учене и/или заетост. За едно лице следва да има поне едно твърдение. Силно препоръчително е тук директно да се използват подкласовете за твърдението (напр. учебно постижение, учебна дейност, оценка на ученето, произтичащо от обучение право), а суперкласът „твърдение“ да се използва само в редките случаи, когато дадено твърдение не е обхванато от съществуващите подкласове.</sh:description>
        <sh:description xml:lang="tr">Bir kişinin öğrenme ve/veya istihdam bağlamında bir Acente hakkında yapılan bir dizi beyan. Bir kişinin en az bir talebi olmalıdır. Talebin alt sınıflarının kullanımı (örneğin Öğrenme Edinimi Modeli, Öğrenme Faaliyeti Modeli, Öğrenme Değerlendirme Modeli, Öğrenme Yetkisi Modeli) ve sadece doğrudan verilen talebin mevcut alt sınırların kapsamında yer almadığı nadir durumlarda Talep üst sınıfı kullanımı şiddetle tavsiye edilir.</sh:description>
        <sh:name xml:lang="nl">heeft bewering</sh:name>
        <sh:description xml:lang="sv">En uppsättning uttalanden som gjorts om en aktör i samband med en persons inlärning och/eller anställning. En person bör ha minst ett påstående. Det rekommenderas varmt att underklasser av påståendet används direkt här (t.ex. läranderesultat, inlärningsaktivitet, bedömning av lärande, läranderättighet) och att påståendets överklass används endast i det sällsynta fallet att påståendet inte täcks av befintliga underklasser.</sh:description>
        <sh:description xml:lang="lt">Teiginiai apie subjektą atsižvelgiant į žmogaus mokymąsi ir (arba) užimtumą. Asmuo turi turėti bent vieną teiginį. Primygtinai patariama čia naudoti teiginio poklasius (pvz., mokymosi rezultatai, mokymosi veikla, mokymosi vertinimas, studijų suteikiama teisė) ir naudoti teiginio antklasį retais atvejais, kai pateiktas teiginys nepriklauso esamiems poklasiams.</sh:description>
        <sh:description xml:lang="hu">A szervről a tanulással és/vagy egy személy foglalkoztatásával összefüggésben tett nyilatkozatok összessége. Egy személyhez legalább egy állításnak kell tartoznia. Nagyon ajánljuk, hogy itt közvetlenül az állítás alárendelt osztályait használja (pl. tanulási eredmények, tanulási tevékenység, a tanulás értékelése, képzési jogosultság), és csak abban a ritka esetben használja a fölérendelt osztályt, ha a megnevezett állításra nem vonatkoznak a meglévő alárendelt osztályok.</sh:description>
        <sh:description xml:lang="en">A claim of the person. A person should at least have one claim.</sh:description>
        <sh:name xml:lang="pt">tem um tipo de resultado</sh:name>
        <sh:node>
          <sh:NodeShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/ClaimNodeShape">
            <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >6</sh:order>
            <sh:or rdf:parseType="Collection">
              <rdf:Description>
                <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LearningAchievement"/>

        <sh:name xml:lang="ro">subcomponentă</sh:name>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LearningOpportunity"/>
        <sh:name xml:lang="mt">għandu parti</sh:name>
        <sh:name xml:lang="hu">valaminek a része</sh:name>
        <sh:name xml:lang="fr">a la partie</sh:name>
        <sh:description xml:lang="ro">Categorii inferioare de reușită care, atunci când sunt combinate, formează această reușită.</sh:description>
        <sh:name xml:lang="el">έχει τμήμα</sh:name>
        <sh:name xml:lang="mk">има дел</sh:name>
        <sh:description xml:lang="it">Risultati parziali che, combinati insieme, costituiscono questo risultato.</sh:description>
        <sh:description xml:lang="cs">Dílčí studijní úspěchy, které tento studijní úspěch tvoří.</sh:description>
        <sh:description xml:lang="en">Smaller units of achievement, which when combined make up this achievement.</sh:description>
        <sh:description xml:lang="bg">По-малки постижения, които в съчетание съставляват това постижение.</sh:description>
        <sh:name xml:lang="sl">ima del</sh:name>
        <sh:description xml:lang="tr">Bir araya geldiklerinde bu başarıyı oluşturan daha küçük başarı birimleri.</sh:description>
        <sh:description xml:lang="et">Väiksemad tulemused, mis koos moodustavad selle tulemuse.</sh:description>
        <sh:description xml:lang="fr">Unités d'acquis plus petites qui, prises ensemble, forment cet acquis.</sh:description>
        <sh:description xml:lang="ga">Aonaid ghnóthachtála níos lú, a chuirtear le chéile chun an ghnóthachtáil seo a iomlánú.</sh:description>
        <sh:name xml:lang="lt">priklauso dalis</sh:name>
        <sh:name xml:lang="sv">har del</sh:name>
        <sh:name xml:lang="da">har del</sh:name>
        <sh:name xml:lang="bg">има част</sh:name>
        <sh:name xml:lang="no">har en del</sh:name>
        <sh:name xml:lang="de">hat Teil</sh:name>
        <sh:description xml:lang="el">Μικρότερες μονάδες επιτευγμάτων, οι οποίες όταν συνδυάζονται συναποτελούν το συγκεκριμένο επίτευγμα.</sh:description>
        <sh:description xml:lang="de">Kleinere Leistungseinheiten, die gemeinsam diese Leistung ergeben.</sh:description>
        <sh:name xml:lang="et">osa järgmises</sh:name>
        <sh:description xml:lang="sv">Mindre prestationer som tillsammans utgör den här prestationen.</sh:description>
        <sh:description xml:lang="hu">Az eredmény kisebb alegységei.</sh:description>
        <sh:name xml:lang="en">has part</sh:name>
        <sh:description xml:lang="sk">Komponenty (celkového) výsledku.</sh:description>
        <sh:description xml:lang="pl">Mniejsze elementy rezultatu, które razem składają się na ten rezultat.</sh:description>
        <sh:description xml:lang="lt">Mažesni pasiekimo vienetai, kurie kartu sudaro šį pasiekimą.</sh:description>
        <sh:name xml:lang="it">ha una parte</sh:name>
        <sh:name xml:lang="cs">obsahuje část</sh:name>
        <sh:description xml:lang="mt">Unitajiet ta’ kisba iżgħar, li flimkien jiffurmaw din il-kisba.</sh:description>
        <sh:description xml:lang="da">Mindre resultatenheder, som samlet set udgør dette resultat.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/hasPart"/>
        <sh:name xml:lang="lv">ir daļa</sh:name>
        <sh:name xml:lang="nl">heeft deel</sh:name>
        <sh:description xml:lang="sl">Manjše enote dosežka, ki skupaj sestavljajo ta dosežek.</sh:description>
        <sh:description xml:lang="sr">0.0</sh:description>
        <sh:description xml:lang="pt">Unidades de aquisição menores, que, quando combinadas, compõem esta aquisição de aprendizagem.</sh:description>
        <sh:name xml:lang="hr">ima dio</sh:name>
        <sh:name xml:lang="me">ima dio</sh:name>
        <sh:description xml:lang="nl">Kleinere prestaties die samen deze prestatie vormen.</sh:description>
        <sh:name xml:lang="is">hefur hluta</sh:name>
        <sh:name xml:lang="ga">a bhfuil an chuid seo a leanas ann</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:description xml:lang="mk">Помали единици на достигнување, кои кога се комбинирани го сочинуваат ова достигнување.</sh:description>
        <sh:description xml:lang="fi">Pienempiä saavutusten yksiköitä, jotka yhdistettynä muodostavat tämän saavutuksen.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:name xml:lang="sk">obsahuje časť</sh:name>
        <sh:name xml:lang="sr">има део</sh:name>
        <sh:description xml:lang="hr">Manje jedinice postignuća koje zajedno tvore ovo postignuće.</sh:description>
        <sh:description xml:lang="en">An association property, that defines a part/whole relationship between instances of the same class. A related resource that is included either physically or logically in the described resource.</sh:description>
        <sh:description xml:lang="es">Unidades de entidad menor que, una vez combinadas, conforman este logro.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="fi">osanaan</sh:name>
        <sh:name xml:lang="tr">bölümü var</sh:name>

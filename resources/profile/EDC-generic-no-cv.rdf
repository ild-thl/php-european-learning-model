        <sh:name xml:lang="bg">Допълнителна информация</sh:name>
        <sh:name xml:lang="lt">Daugiau informacijos</sh:name>
        <sh:name xml:lang="pl">Więcej informacji</sh:name>
        <sh:description xml:lang="no">Ytterligere informasjon om et objekt eller emne levert som fritekst.</sh:description>
        <sh:description xml:lang="mk">Дополнителни информации за објект или тема кои се доставени како слободен текст.</sh:description>
        <sh:name xml:lang="sl">Več informacij</sh:name>
        <sh:name xml:lang="no">Tilleggsopplysninger</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="is">Viðbótarupplýsingar</sh:name>
        <sh:name xml:lang="sv">Mer information</sh:name>
        <sh:description xml:lang="el">Περαιτέρω πληροφορίες σχετικά με ένα αντικείμενο ή ένα θέμα οι οποίες παρέχονται με τη μορφή ελεύθερου κειμένου.</sh:description>
        <sh:name xml:lang="en">more information</sh:name>
        <sh:name xml:lang="de">Weitere Informationen</sh:name>
        <sh:name xml:lang="fi">Lisätietoja</sh:name>
        <sh:description xml:lang="ga">Tuilleadh eolais faoi oibiacht nó ábhar a sholáthraítear mar théacs saor.</sh:description>
        <sh:description xml:lang="sl">Dodatne informacije o gradniku ali temi, predložene kot prosto besedilo.</sh:description>
        <sh:description xml:lang="me">Dodatna slobodna tekstualna napomena o osiguranju kvaliteta ili licenciranju organizacije ili kvalifikacije.</sh:description>
        <sh:name xml:lang="sk">Ďalšie informácie</sh:name>
        <sh:description xml:lang="it">Ulteriori informazioni su un oggetto o un argomento fornite sotto forma di testo libero.</sh:description>
        <sh:description xml:lang="tr">Serbest metin biçiminde verilen bir konu veya bir nesne hakkında daha fazla bilgi.</sh:description>
        <sh:description xml:lang="hu">További információk egy objektumról vagy témáról, szabad szöveg formájában.</sh:description>
        <sh:name xml:lang="ga">Tuilleadh eolais</sh:name>
        <sh:description xml:lang="is">Frekari upplýsingar um viðfang eða efnisatriði sem rita má frjálst.</sh:description>
        <sh:description xml:lang="sr">Додатне информације о неком објекту или теми наведене у формату произвољног текста.</sh:description>
        <sh:name xml:lang="pt">Mais informações</sh:name>
        <sh:name xml:lang="nl">Meer informatie</sh:name>
        <sh:name xml:lang="es">Más información</sh:name>
        <sh:description xml:lang="de">Weitere Informationen über ein Objekt oder ein Thema, die als Freitext zur Verfügung gestellt werden.</sh:description>
        <sh:name xml:lang="ro">Informații suplimentare</sh:name>
        <sh:description xml:lang="es">Más información sobre un objeto o tema en forma de texto libre.</sh:description>
        <sh:name xml:lang="fr">Informations supplémentaires</sh:name>
        <sh:description xml:lang="fi">Lisätietoa objektista tai aiheesta vapaamuotoisena tekstinä.</sh:description>
        <sh:description xml:lang="et">Vaba tekstina esitatud lisateave objekti või teema kohta.</sh:description>
        <sh:description xml:lang="sv">Ytterligare information om ett objekt eller ämne som levereras som fri text.</sh:description>
        <sh:name xml:lang="cs">Další informace</sh:name>
        <sh:name xml:lang="el">Περισσότερες πληροφορίες</sh:name>
        <sh:name xml:lang="mt">Aktar informazzjoni</sh:name>
        <sh:description xml:lang="sk">Ďalšie informácie o objekte alebo téme poskytnuté ako voľný text.</sh:description>
        <sh:description xml:lang="lt">Daugiau informacijos apie objektą arba temą pateikiama laisvos formos tekste.</sh:description>
        <sh:description xml:lang="hr">Dodatne informacije o predmetu ili temi koji su navedeni kao slobodni tekst.</sh:description>
        <sh:description xml:lang="ro">Informații suplimentare despre un obiect sau o temă furnizate sub formă de text liber.</sh:description>
        <sh:name xml:lang="da">Yderligere oplysninger</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="et">Lisateave</sh:name>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Note"/>
        <sh:name xml:lang="hr">Više informacija</sh:name>
        <sh:name xml:lang="me">Više informacija</sh:name>
        <sh:description xml:lang="cs">Další informace ve formě volného textu o objektu nebo tématu.</sh:description>
        <sh:name xml:lang="hu">További információk</sh:name>
        <sh:name xml:lang="en">additional note</sh:name>
        <sh:description xml:lang="da">Yderligere oplysninger om en genstand eller et emne angivet som fritekst.</sh:description>
        <sh:description xml:lang="bg">Допълнителна информация за обект или тема, предоставена под формата на свободен текст.</sh:description>
        <sh:name xml:lang="lv">Vairāk informācijas</sh:name>
        <sh:description xml:lang="fr">Informations supplémentaires sur un objet ou un sujet fournies sous forme de texte libre.</sh:description>
        <sh:description xml:lang="pt">Informações adicionais sobre um objeto ou tema fornecidas em texto livre.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/additionalNote"/>
        <sh:description xml:lang="nl">Aanvullende informatie over een object of onderwerp die als vrije tekst wordt verstrekt.</sh:description>
        <sh:name xml:lang="it">Ulteriori informazioni</sh:name>
        <sh:description xml:lang="en">Further information about an object or topic supplied as free text.</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="lv">Brīvā tekstā sniegta papildu informācija par objektu vai tematu.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >10</sh:order>
        <sh:description xml:lang="mt">Aktar informazzjoni dwar oġġett jew suġġett ipprovduta bħala test liberu.</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:label xml:lang="lv">Specifikācija</rdfs:label>
    <rdfs:comment xml:lang="no">En standarddefinisjon av kjennetegn ved prospektiv læring eller en prosess knyttet til læring. Denne klassen har egenskaper som er felles for alle spesifikasjoner, inkludert læringsprestasjonsspesifikasjon, læringsaktivitetsspesifikasjon, læringsvurderingsspesifikasjon og læringsrettighetsspesifikasjon. Det fungerer som et utvidelsespunkt som muliggjør definisjon av ytterligere underklasser.</rdfs:comment>
    <rdfs:comment xml:lang="lv">Nākotnes mācību vai ar mācīšanos saistīta procesa raksturlielumu standarta definīcija. Šai klasei ir īpašības, kas ir kopīgas visām specifikācijām, tai skaitā mācību sasniegumu specifikācijai, mācību aktivitātes specifikācijai, mācību novērtējuma specifikācijai un mācību tiesību specifikācijai. Tā kalpo kā paplašinājums, kas ļauj definēt papildu apakšklases.</rdfs:comment>
    <rdfs:comment xml:lang="ro">O definiție standard a caracteristicilor unor eventuale oportunități viitoare de învățare sau a unui proces legat de învățare. Această clasă are proprietăți comune tuturor specificațiilor, inclusiv specificația de realizare a învățării, specificația activității de învățare, specificația de evaluare a învățării și specificația privind dreptul de a învăța. Servește drept punct de extindere care permite definirea unor subclase suplimentare.</rdfs:comment>
    <rdfs:comment xml:lang="sr">Стандардна дефиниција карактеристика будућег учења или процеса повезаног са учењем. Ова класа носи својства која су заједничка свим спецификацијама, укључујући Спецификацију достигнуће учења, Спецификацију активности учења, Спецификацију образовне процене и Спецификацију образовног права. Она служи као тачка проширења која омогућава дефинисање додатних подређених класа.</rdfs:comment>
    <rdfs:comment xml:lang="sv">En standarddefinition av egenskaperna för framtida lärande eller en process som är kopplad till lärande. Denna klass har egenskaper som är gemensamma för alla specifikationer, inklusive specifikation av läranderesultat, inlärningsaktivitetsspecifikation, specifikation av bedömning av lärande och specifikation av läranderättighet. Den fungerar som en tilläggspunkt som möjliggör definition av ytterligare underklasser.</rdfs:comment>
    <rdfs:comment xml:lang="tr">Öğrenme ile bağlantılı bir işlem veya muhtemel öğrenmenin özelliklerinin standart bir tanımı. Bu sınıf Öğrenme Edinimi Şartnamesi, Öğrenme Faaliyeti Şartnamesi, Öğrenme Değerlendirmesi Şartnamesi ve Öğrenme Yetkisi Şartnamesi dahil olmak üzere tüm şartnameler için ortak özellikler taşır. İlave alt sınıfların tanımını sağlayan bir genişleme noktası olarak hizmet sunar.</rdfs:comment>
    <rdfs:comment xml:lang="el">Τυποποιημένος ορισμός των χαρακτηριστικών της μελλοντικής μάθησης ή διαδικασίας που συνδέεται με τη μάθηση. Η κατηγορία αυτή έχει κοινές ιδιότητες για όλες τις προδιαγραφές, συμπεριλαμβανομένων της Προδιαγραφής μαθησιακού επιτεύγματος, της Προδιαγραφής μαθησιακής δραστηριότητας, της Προδιαγραφής αξιολόγησης της μάθησης και της Προδιαγραφής μαθησιακού δικαιώματος. Χρησιμεύει ως σημείο επέκτασης που επιτρέπει τον ορισμό πρόσθετων υποκατηγοριών.</rdfs:comment>
    <rdfs:comment xml:lang="en">A standard definition of the characteristics of prospective learning or a process linked to learning. This class carries properties common to all specifications, including Learning Achievement Specification, Learning Activity Specification, Learning Assessment Specification and Learning Entitlement Specification. It serves as an extension point that enables the definition of additional subclasses.</rdfs:comment>
    <rdfs:label xml:lang="mt">Speċifikazzjoni</rdfs:label>
    <rdfs:label xml:lang="cs">Specifikace</rdfs:label>
    <rdfs:label xml:lang="de">Spezifikation</rdfs:label>
    <rdfs:comment xml:lang="mt">Definizzjoni standard tal-karatteristiċi tat-tagħlim prospettiv jew proċess marbut mat-tagħlim. Din il-klassi ġġorr proprjetajiet komuni għall-ispeċifikazzjonijiet kollha, inklużi l-Ispeċifikazzjoni tal-Kisba tat-Tagħlim, l-Ispeċifikazzjoni tal-Attività tat-Tagħlim, l-Ispeċifikazzjoni tal-Valutazzjoni tat-Tagħlim u l-Ispeċifikazzjoni tal-Intitolament għat-tagħlim. Dan iservi bħala punt ta’ estensjoni li jippermetti d-definizzjoni ta’ sottoklassijiet addizzjonali.</rdfs:comment>
    <rdfs:label xml:lang="tr">Tanım</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Specification-skos_altLabel">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#altLabel"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >2</sh:order>
        <sh:name xml:lang="en">alternative label</sh:name>
        <sh:description xml:lang="en">The range of skos:altLabel is the class of RDF plain literals.</sh:description>
        <sh:description xml:lang="en">skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="sl">Standardna opredelitev značilnosti predvidenega učenja ali procesa, povezanega z učenjem. Ta razred vsebuje lastnosti, ki so skupne vsem specifikacijam, vključno s Specifikacijo učnega dosežka, Specifikacijo učne dejavnosti, Specifikacijo ocene učnih rezultatov in Specifikacijo upravičenosti na podlagi izobrazbe. Uporablja se kot razširitvena točka, ki omogoča opredelitev dodatnih podrazredov.</rdfs:comment>
    <rdfs:comment xml:lang="pt">Uma definição normalizada das características da aprendizagem prospetiva ou de um processo associado à aprendizagem. Esta classe comporta propriedades comuns a todas as especificações, incluindo a especificação da aquisição da aprendizagem, a especificação da atividade de aprendizagem, a especificação da avaliação da aprendizagem e especificação do direito de aprendizagem. Serve de ponto de extensão que permite a definição de subclasses adicionais.</rdfs:comment>
    <rdfs:comment xml:lang="hr">Standardna definicija svojstava budućeg učenja ili procesa povezanog s učenjem. Ovaj razred ima svojstva koja su zajednička svim specifikacijama, uključujući specifikacije obrazovnog postignuća, specifikacije aktivnosti učenja, specifikacije procjene ishoda učenja i specifikacije prava koja proizlaze iz učenja. Služi kao točka proširenja koja omogućuje definiranje dodatnih podrazreda.</rdfs:comment>
    <rdfs:comment xml:lang="es">Una definición estándar de las características del aprendizaje futuro o de un proceso vinculado al aprendizaje. Esta clase presenta propiedades comunes a todas las especificaciones, en particular la Especificación del logro del aprendizaje, la Especificación de la actividad de aprendizaje, la Especificación de la evaluación del aprendizaje y la Especificación del derecho al aprendizaje. Permite ampliar la definición de subclases adicionales.</rdfs:comment>
    <rdfs:comment xml:lang="it">Una definizione standard delle caratteristiche dell'apprendimento prospettico o di un processo legato all'apprendimento. Questa classe presenta proprietà comuni a tutte le specifiche, comprese le specifiche dei risultati dell'apprendimento, dell'attività di apprendimento, della valutazione dell'apprendimento e del diritto all'apprendimento. Funge da punto di estensione che consente di definire sottoclassi supplementari.</rdfs:comment>
    <rdfs:comment xml:lang="fi">Ennakko-opintojen tai oppimiseen liittyvän prosessin ominaisuuksien vakiomääritelmä. Tässä luokassa on kaikille eritelmille yhteisiä ominaisuuksia, mukaan lukien oppimissaavutuksen eritelmä, oppimistoimen eritelmä, osaamisen arviointiprosessin eritelmä ja oppimisen kelpuutuksen eritelmä. Se toimii laajennuksena ja mahdollistaa uusien alaluokkien määrittelyn.</rdfs:comment>
    <rdfs:comment xml:lang="ga">Sainmhíniú caighdeánach ar thréithe na foghlama ionchasaí nó próiseas a bhaineann le foghlaim. Tá maoin ag an aicme seo a bhaineann le gach sonraíocht, lena n-áirítear Sonraíocht Gnóthachtála Foghlama, Sonraíocht Gníomhaíochta Foghlama, Measúnú Foghlama agus Sonraíocht Teidlíochta Foghlama. Feidhmíonn sé mar phointe sínidh lenar féidir fo-aicmí breise a shainmhíniú.</rdfs:comment>
    <rdfs:label xml:lang="mk">Спецификација</rdfs:label>
    <rdfs:label xml:lang="en">Specification</rdfs:label>
    <rdfs:label xml:lang="sk">Špecifikácia</rdfs:label>
    <sh:property rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/elm_order"/>
    <rdfs:label xml:lang="no">Spesifikasjon</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Specification-elm_status">
        <sh:description xml:lang="me">Status objavljivanja osiguranja kvaliteta ili licenciranja organizacije ili kvalifikacije. Ako je navedena, vrijednost mora da potiče iz rječnika kontrolisanog statusom akreditacije (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="fi">Tila</sh:name>
        <sh:description xml:lang="et">Organisatsiooni või kvalifikatsiooni kvaliteedi tagamise või litsentseerimise avaldamise staatus. Kui väärtus on märgitud, peab see pärinema akrediteerimise staatuse kontrollitud sõnastikust (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="it">Stato</sh:name>
        <sh:description xml:lang="no">Publiseringsstatusen til kvalitetssikringen eller lisensieringen av en organisasjon eller en kvalifikasjon. Hvis oppgitt, må verdien komme fra det kontrollerte vokabularet for akkrediteringsstatus (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="hu">Egy szervezet vagy képesítés minőségbiztosításának vagy engedélyezésének közzétételi állapota. Az értéknek (ha meg van adva) az akkreditációs állapot ellenőrzött szójegyzékéből kell származnia (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="es">Estado</sh:name>
        <sh:description xml:lang="bg">Статусът на публикуване на информацията относно осигуряването на качеството или лицензирането на организация или квалификация. Ако бъде посочена, стойността трябва да е от контролирания речник за акредитационен статус (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="sv">Publiceringsstatusen för kvalitetssäkringen eller licensieringen av en organisation eller en kvalifikation. I förekommande fall måste värdet komma från den kontrollerade ordlistan för ackrediteringsstatusen (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="mt">L-istatus tal-pubblikazzjoni tal-assigurazzjoni tal-kwalità jew il-liċenzjar ta’ organizzazzjoni jew kwalifika. Jekk jiġi pprovdut, il-valur irid jiġi mil-vokabularju kkontrollat tal-istatus tal-Akkreditazzjoni (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="is">Staða</sh:name>
        <sh:description xml:lang="is">Útgáfustaða gæðavottunar eða leyfisveitingar skipulagsheildar eða hæfnivottorðs. Ef til staðar, þarf gildið að koma frá stýrðum orðaforða um faggildingu (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="hr">Status objave osiguravanja kvalitete ili licenciranja organizacije ili kvalifikacije. Ako je navedena, vrijednost mora biti iz kontroliranog rječnika statusa akreditacije (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="sr">Статус објављивања контроле квалитета или лиценцирања организације или квалификације. Ако се наводи, вредност мора да потиче из контролисаног вокабулара Статус акредитације (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="nl">De publicatiestatus van de kwaliteitsborging of toelating van een organisatie of een kwalificatie. Indien verstrekt, moet de waarde afkomstig zijn uit de gecontroleerde woordenlijst voor de accreditatiestatus (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="en">status</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:description xml:lang="sl">Status objave zagotavljanja kakovosti ali licenciranja organizacije ali kvalifikacije. Če je vrednost navedena, mora izhajati iz kontroliranega besednjaka za status akreditacije (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="fr">Le statut de publication de l’assurance de la qualité ou l’octroi de licences concernant une organisation ou une certification. Si elle est fournie, la valeur doit provenir du vocabulaire contrôlé du Statut d’accréditation (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="mk">Статусот на публикација за осигурувањето на квалитетот или лиценцирање на организација или квалификација. Ако е наведена, вредноста мора да произлезе од контролиран вокабулар за статусот на акредикацијата (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="sk">Stav uverejnenia zabezpečovania kvality alebo udeľovania licencie v prípade organizácie alebo kvalifikácie. Poskytnutá hodnota musí byť z riadeného slovníka stavov akreditácie (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="fi">Organisaation tai tutkinnon laadunvarmistuksen tai lisensoinnin julkaisutila. Jos arvo määritellään, sen on oltava kontrolloidusta sanastosta Akkreditoinnin tila(http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="ro">Statutul publicării garanției de asigurare a calității sau a autorizației pentru o organizație sau o calificare. Dacă este furnizată, valoarea trebuie să provină din vocabularul controlat al statutului acreditării (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="mk">Статус</sh:name>
        <sh:name xml:lang="bg">Статус</sh:name>
        <sh:description xml:lang="tr">Kalite güvencesi veya bir niteliğin veya bir kuruluşu ruhsatlandırmasının yayınlanma durumu. Verilmişse, değerin Akreditasyon durumu kontrol edilmiş sözlükten gelmesi zorunludur (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="tr">Statü</sh:name>
        <sh:description xml:lang="cs">Stav zveřejnění zajišťování kvality organizace nebo kvalifikace nebo udělování licencí organizaci nebo kvalifikaci. Poskytnutá hodnota musí být převzata ze stavu Akreditace řízeného slovníku (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="it">Lo stato di pubblicazione della garanzia di qualità o dell'autorizzazione di un'organizzazione o di una qualifica. Se fornito, il valore deve essere tratto dal vocabolario controllato dello stato di accreditamento (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="lv">Statuss</sh:name>
        <sh:name xml:lang="hu">Státusz</sh:name>
        <sh:description xml:lang="lv">Organizācijas vai kvalifikācijas kvalitātes nodrošināšanas vai licencēšanas publikācijas statuss. Var norādīt tikai vērtības, kas ņemtas no akreditācijas statusu kontrolētas vārdnīcas(http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/status"/>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:name xml:lang="ro">Statut</sh:name>
        <sh:name xml:lang="fr">Statut</sh:name>
        <sh:name xml:lang="sk">Stav</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:description xml:lang="lt">Organizacijos arba kvalifikacijos kokybės užtikrinimo arba licencijavimo skelbimo būsena. Jei nurodoma, vertė turi būti iš akreditacijų būsenų kontrolinio žodyno (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:name xml:lang="sv">Status</sh:name>
        <sh:name xml:lang="sl">Status</sh:name>
        <sh:name xml:lang="ga">Stádas</sh:name>
        <sh:name xml:lang="pl">Status</sh:name>
        <sh:name xml:lang="no">Status</sh:name>
        <sh:name xml:lang="nl">Status</sh:name>
        <sh:name xml:lang="mt">Status</sh:name>
        <sh:name xml:lang="me">Status</sh:name>
        <sh:name xml:lang="hr">Status</sh:name>
        <sh:name xml:lang="cs">Status</sh:name>
        <sh:name xml:lang="da">Status</sh:name>
        <sh:name xml:lang="de">Status</sh:name>
        <sh:description xml:lang="pt">O estado de publicação da garantia de qualidade ou do licenciamento de uma organização ou qualificação. Se for indicado, o valor deve provir do vocabulário controlado relativo ao estado da acreditação (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="ga">Stádas foilsithe dearbhaithe cáilíochta nó ceadúnaithe eagraíochta nó cáilíochta. Má chuirtear ar fáil é, ní mór an luach teacht ón stór focal maidir le stádas Creidiúnaithe (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="en">The publication status of the quality assurance or licensing of an organisation or a qualification. If provided, the value must come from the Accredication status controlled vocabulary (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="lt">Būsena</sh:name>
        <sh:name xml:lang="et">Staatus</sh:name>
        <sh:name xml:lang="pt">Estatuto</sh:name>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:description xml:lang="es">El estado de publicación de la garantía de calidad o la concesión de licencias de una organización o una cualificación. Si se facilita, el valor debe proceder del vocabulario controlado Estado de la acreditación (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="en">The status. It can be the status of the verification check, Entitlement specification etc</sh:description>
        <sh:description xml:lang="da">Status for offentliggørelse af kvalitetssikringen eller godkendelsen af en organisation eller en kvalifikation. Hvis oplyst, skal værdien tages fra den kontrollerede ordliste Accredication status (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="el">Η κατάσταση δημοσίευσης της διασφάλισης ποιότητας ή της αδειοδότησης ενός οργανισμού ή ενός τίτλου επαγγελματικού προσόντος. Εάν παρέχεται, η τιμή πρέπει να προέρχεται από το ελεγχόμενο λεξιλόγιο «Κατάσταση διαπίστευσης» (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:description xml:lang="pl">Status zapewnienia jakości lub licencjonowania instytucji lub kwalifikacji. Jeżeli ją podano, wartość ta musi pochodzić ze słownika kontrolowanego dotyczącego statusu akredytacji (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
        <sh:name xml:lang="el">Κατάσταση</sh:name>
        <sh:description xml:lang="de">Der Veröffentlichungsstatus der Qualitätssicherung oder Lizenzierung einer Organisation oder einer Qualifikation. Falls angegeben, muss der Wert aus dem kontrollierten Vokabular für den Akkreditierungsstatus stammen (http://publications.europa.eu/resource/dataset/accreditation-status).</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="et">Kavandatava õppimise või õppimisega seotud protsessi tunnuste standardmääratlus. Sellel klassil on kõigi kirjelduste ühised omadused, sealhulgas õpitulemuse, õpitegevuse, õpihindamise ja õppimisõiguse kirjeldus. See toimib laienduspunktina, mis võimaldab määratleda täiendavaid alamklasse.</rdfs:comment>
    <rdfs:label xml:lang="sv">Specifikation</rdfs:label>
    <rdfs:label xml:lang="da">Specifikation</rdfs:label>
    <rdfs:comment xml:lang="cs">Standardní definice charakteristik možného vzdělávání nebo procesu spojeného se vzděláváním. Tato třída má společné vlastnosti pro všechny specifikace, včetně Specifikace studijních výsledků, Specifikace vzdělávacích aktivit, Specifikace hodnocení učení a Specifikace nároku na vzdělávání. Slouží jako rozšiřující bod, který umožňuje definovat další podtřídy.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Specification-elm_category">
        <sh:name xml:lang="et">kategooria</sh:name>
        <sh:description xml:lang="mt">Il-kategorija bħala sekwenza tad-deskrizzjoni ta’ sett ta’ għarfien u/jew ħiliet użati b’responsabbiltà u awtonomija, li jistgħu jinkisbu.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/category"/>
        <sh:name xml:lang="hr">kategorija</sh:name>
        <sh:name xml:lang="sl">kategorija</sh:name>
        <sh:name xml:lang="mt">kategorija</sh:name>
        <sh:name xml:lang="me">kategorija</sh:name>
        <sh:name xml:lang="lv">kategorija</sh:name>
        <sh:name xml:lang="lt">kategorija</sh:name>
        <sh:description xml:lang="it">La categoria intesa come stringa della descrizione di un insieme di conoscenze e/o abilità che possono essere acquisite, utilizzate con responsabilità e autonomia.</sh:description>
        <sh:description xml:lang="nl">De categorie als een reeks van de beschrijving van kennis en/of vaardigheden die op verantwoordelijke en zelfstandige wijze worden gebruikt, die kunnen worden verworven.</sh:description>
        <sh:name xml:lang="pl">kategoria</sh:name>
        <sh:name xml:lang="fi">kategoria</sh:name>
        <sh:description xml:lang="sv">Kategorin som en beskrivningssträng av en uppsättning kunskaper och/eller färdigheter som en person kan skaffa sig och som används med ansvar och självständighet.</sh:description>
        <sh:description xml:lang="lv">Kategorija kā rakstzīmju virkne, kas apraksta iegūstamo atbildīgi un autonomi izmantojamo zināšanu un/vai prasmju kopumu.</sh:description>
        <sh:name xml:lang="fr">catégorie</sh:name>
        <sh:description xml:lang="sl">Kategorija niza opisa nabora znanja in/ali spretnosti, ki se uporabljajo odgovorno in samostojno ter se lahko pridobijo.</sh:description>
        <sh:description xml:lang="no">Kategorien som en streng av beskrivelsen av et sett med kunnskap og/eller ferdigheter brukt med ansvar og autonomi, som kan tilegnes.</sh:description>
        <sh:name xml:lang="is">flokkur</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="es">La categoría en forma de secuencia de la descripción de un conjunto de conocimientos o competencias utilizados con responsabilidad y autonomía, que pueden adquirirse.</sh:description>
        <sh:name xml:lang="es">categoría</sh:name>
        <sh:description xml:lang="bg">Категорията (под формата на низ) на описанието на набор от знания и/или умения, използвани отговорно и самостоятелно, които могат да бъдат придобити.</sh:description>
        <sh:description xml:lang="da">Kategorien som en streng af beskrivelsen af et sæt af kundskaber og/eller færdigheder, der anvendes med ansvar og selvstændighed, og som kan erhverves.</sh:description>
        <sh:description xml:lang="sr">Категорија у облику ниске описа скупа знања и/или вештина за одговорну и самосталну примену који се могу стећи.</sh:description>
        <sh:description xml:lang="sk">Kategória ako reťazec opisu súboru vedomostí a/alebo zručností používaných zodpovedne a samostatne, ktoré možno nadobudnúť.</sh:description>
        <sh:name xml:lang="it">categoria</sh:name>
        <sh:name xml:lang="ro">categoria</sh:name>
        <sh:name xml:lang="pt">categoria</sh:name>
        <sh:name xml:lang="cs">kategorie</sh:name>
        <sh:description xml:lang="fi">Kategoria merkkijonona, joka on osa kuvausta hankittavissa olevista vastuullisesti ja itsenäisesti käytettävistä tiedoista ja/tai taidoista.</sh:description>
        <sh:name xml:lang="mk">категорија</sh:name>
        <sh:name xml:lang="sr">категорија</sh:name>
        <sh:name xml:lang="hu">kategória</sh:name>
        <sh:description xml:lang="el">Η κατηγορία ως συμβολοσειρά της περιγραφής ενός συνόλου γνώσεων και/ή δεξιοτήτων που χρησιμοποιούνται με υπευθυνότητα και αυτονομία, οι οποίες μπορούν να αποκτηθούν.</sh:description>
        <sh:name xml:lang="sk">kategória</sh:name>
        <sh:description xml:lang="pl">Wyrażona jako ciąg znaków kategoria opisu możliwego do zdobycia zestawu wiedzy lub umiejętności wykorzystywanych z odpowiedzialnością i autonomią.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="ro">Categoria, sub formă de șir de descriere a unui set de cunoștințe și/sau competențe utilizate cu responsabilitate și autonomie, care pot fi dobândite.</sh:description>
        <sh:description xml:lang="lt">Atsakingai ir savarankiškai naudojamų žinių ir (arba) įgūdžių, kurie gali būti įgyti, aprašo kategorija kaip eilutė.</sh:description>
        <sh:description xml:lang="hr">Kategorija kao niz opisa skupa znanja i/ili vještina koje se upotrebljavaju odgovorno i autonomno te koje se mogu steći.</sh:description>
        <sh:name xml:lang="el">κατηγορία</sh:name>
        <sh:description xml:lang="cs">Kategorie řetězce popisu souboru znalostí a/nebo dovedností používaných zodpovědně a samostatně, které lze získat.</sh:description>
        <sh:name xml:lang="de">Kategorie</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="nl">categorie</sh:name>
        <sh:name xml:lang="bg">категория</sh:name>
        <sh:description xml:lang="de">Die Kategorie als Zeichenkette der Beschreibung einer Reihe von Kenntnissen und/oder Fähigkeiten, die mit Verantwortung und Autonomie genutzt werden und erworben werden können.</sh:description>
        <sh:name xml:lang="ga">catagóir</sh:name>
        <sh:description xml:lang="is">Flokkur sem strengur, á lýsingu á safni þekkingar og/eða færni sem notað er af ábyrgð og með sjálfstæðum hætti og sem hægt er að öðlast.</sh:description>
        <sh:description xml:lang="me">Kategorija kao niz opisa skupa znanja i/ili vještina koji se koriste sa odgovornošću i autonomijom, a koja se mogu steći.</sh:description>
        <sh:description xml:lang="en">A category to which this specification belongs. This property can be used instead of dc:type, if the category cannot provided via a controlled vocabulary.</sh:description>
        <sh:name xml:lang="en">category</sh:name>
        <sh:description xml:lang="hu">Azon elsajátítható ismeretek és/vagy készségek ismertetésének kódkategóriája, amelyeket az egyén önállóan és felelősségteljesen tud használni.</sh:description>
        <sh:description xml:lang="ga">An chatagóir mar theaghrán den tuairisc ar thacar eolais agus/nó scileanna a úsáidtear le freagracht agus neamhspleáchas, a d’fhéadfaí a fháil.</sh:description>
        <sh:description xml:lang="mk">Категоријата како низа во описот на збирот на знаења и/или вештини кои се употребени со одговорност и автономија, а кои можат да се стекнат.</sh:description>
        <sh:description xml:lang="en">The category as a string of the description of a set of knowledge and/or skills used with responsibility and autonomy, which may be acquired.</sh:description>
        <sh:description xml:lang="tr">Edinilebilecek olan otonomi ve sorumluluk ile kullanılan bir dizi bilgi ve/veya kabiliyetin tanımının bir dizisi olan kategori.</sh:description>
        <sh:description xml:lang="pt">A categoria como uma sequência da descrição de um conjunto de conhecimentos e/ou competências utilizados com responsabilidade e autonomia, que podem ser adquiridos.</sh:description>
        <sh:name xml:lang="tr">kategori</sh:name>
        <sh:name xml:lang="sv">kategori</sh:name>
        <sh:name xml:lang="no">kategori</sh:name>
        <sh:name xml:lang="da">kategori</sh:name>
        <sh:description xml:lang="et">Kategooria kui omandatavate vastutustundlikult ja iseseisvalt kasutatavate teadmiste ja/või oskuste kogumi kirjelduse string.</sh:description>
        <sh:description xml:lang="fr">La catégorie en tant que chaîne de la description d’un ensemble de connaissances et/ou de compétences utilisées avec des responsabilités et une certaine autonomie, qui peuvent être acquises.</sh:description>
      </sh:PropertyShape>
    </sh:property>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/GeometryShape">
    <sh:targetClass rdf:resource="http://www.w3.org/ns/locn#Geometry"/>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Geometry-clv_longitude">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="http://data.europa.eu/m8g/longitude"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"

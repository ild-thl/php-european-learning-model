        <sh:name xml:lang="da">Yderligere oplysninger</sh:name>
        <sh:description xml:lang="et">Vaba tekstina esitatud lisateave objekti või teema kohta.</sh:description>
        <sh:name xml:lang="lv">Vairāk informācijas</sh:name>

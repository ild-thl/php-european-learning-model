        <sh:description xml:lang="tr">Faaliyetleri yerine getirebilecek olan kurumun tanımlanabilir coğrafi yeri.</sh:description>
        <sh:description xml:lang="hu">A tevékenységeket végrehajtani képes entitás azonosítható földrajzi helyszíne.</sh:description>
        <sh:description xml:lang="de">Der identifizierbare geografische Ort der Entität, die Aktionen ausführen kann.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>

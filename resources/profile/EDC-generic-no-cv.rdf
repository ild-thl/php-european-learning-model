        <sh:name xml:lang="mk">Контакт информација</sh:name>
        <sh:description xml:lang="bg">Информация за контакт със субекта, който е в състояние да извършва действия.</sh:description>
        <sh:name xml:lang="et">Kontaktandmed</sh:name>
        <sh:name xml:lang="bg">Координати за връзка</sh:name>
        <sh:description xml:lang="nl">De contactgegevens van de entiteit die in staat is om acties uit te voeren.</sh:description>
        <sh:description xml:lang="en">The entitlement of the person.</sh:description>
        <sh:description xml:lang="hr">Podaci za kontakt subjekta koji može provoditi mjere.</sh:description>
        <sh:description xml:lang="lt">Subjekto, galinčio atlikti veiksmus, kontaktiniai duomenys.</sh:description>
        <sh:name xml:lang="nl">Contactgegevens</sh:name>
        <sh:description xml:lang="en">The contact information of the entity that is able to carry out actions.</sh:description>

    <rdfs:comment xml:lang="sk">Údaje získané z jedného alebo viacerých európskych digitálnych certifikátov.</rdfs:comment>
    <rdfs:label xml:lang="fr">Présentation numérique européenne</rdfs:label>
    <rdfs:label xml:lang="sv">Europeisk digital presentation</rdfs:label>
    <rdfs:comment xml:lang="is">Gögn sem fengin eru frá einu eða fleiri Evrópskum stafrænum skilríkjum.</rdfs:comment>
    <rdfs:label xml:lang="lt">Europos skaitmeninis pateikimas</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalPresentation-elm_verificationCheck">
        <sh:name xml:lang="pl">Kontrola weryfikacyjna</sh:name>
        <sh:name xml:lang="fr">Contrôle de vérification</sh:name>
        <sh:description xml:lang="mk">Условите и резултатот од тест во однос на одредени пропишани критериуми во контекст на дигитално потпишан акредитив.</sh:description>
        <sh:description xml:lang="ga">Coinníollacha agus toradh tástála in aghaidh critéir fhorordaithe áirithe i gcomhthéacs dintiúr atá sínithe go digiteach.</sh:description>
        <sh:name xml:lang="fi">Todentamistarkastus</sh:name>
        <sh:name xml:lang="ga">Seiceáil Fíorúcháin</sh:name>
        <sh:description xml:lang="en">The conditions and result of a test against certain prescribed criteria in the context of a digitally-signed credential.</sh:description>
        <sh:description xml:lang="fi">Digitaalisesti allekirjoitettuun osaamistodistukseen liittyvän, määrättyihin kriteereihin perustuvan testin ehdot ja tulokset.</sh:description>
        <sh:description xml:lang="en">A verification check. This is an association to the Verification Check class</sh:description>
        <sh:name xml:lang="hu">Ellenőrzés</sh:name>
        <sh:description xml:lang="sl">Pogoji in rezultat preskusa na podlagi določenih predpisanih meril v okviru digitalno podpisanega potrdila.</sh:description>
        <sh:name xml:lang="tr">Doğrulama Kontrolü</sh:name>
        <sh:name xml:lang="me">Provjera verifikacije</sh:name>
        <sh:description xml:lang="tr">Dijital olarak imzalanmış bir yetkinlik kanıtının bağlamında kurallarla bağlanmış olan belirli kriterlere karşı bir testin sonucu ve koşulları.</sh:description>
        <sh:description xml:lang="fr">Les conditions et le résultat d’un test au regard de certains critères prescrits dans le contexte d’un justificatif signé numériquement.</sh:description>
        <sh:description xml:lang="es">Las condiciones y el resultado de un examen con arreglo a determinados criterios prescritos en el contexto de una credencial firmada digitalmente.</sh:description>
        <sh:description xml:lang="is">Skilyrði og niðurstöður prófs mót tilteknum fyrirfram ákveðnum forsendum í tengslum við stafrænt undirritað skilríki.</sh:description>
        <sh:name xml:lang="da">Verifikationskontrol</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="lt">Patikra</sh:name>
        <sh:name xml:lang="mt">Kontroll tal-Verifika</sh:name>
        <sh:name xml:lang="de">Überprüfung</sh:name>
        <sh:name xml:lang="no">Verifiseringssjekk</sh:name>
        <sh:name xml:lang="lv">Verifikācijas pārbaude</sh:name>
        <sh:description xml:lang="nl">De voorwaarden en het resultaat van een toetsing aan bepaalde voorgeschreven criteria in het kader van een digitaal ondertekende credential.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="hr">Uvjeti i rezultati ispitivanja u odnosu na određene propisane kriterije u kontekstu digitalno potpisane vjerodajnice.</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="el">Οι όροι και το αποτέλεσμα δοκιμασίας βάσει ορισμένων καθορισμένων κριτηρίων στο πλαίσιο ψηφιακά υπογεγραμμένου διαπιστευτηρίου.</sh:description>
        <sh:name xml:lang="nl">Verificatie</sh:name>
        <sh:name xml:lang="es">Control de verificación</sh:name>
        <sh:name xml:lang="it">Controllo a fini di verifica</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="mk">Верификациска контрола</sh:name>
        <sh:description xml:lang="de">Die Bedingungen und das Ergebnis einer Prüfung anhand bestimmter vorgeschriebener Kriterien im Rahmen eines digital unterzeichneten Nachweises.</sh:description>
        <sh:name xml:lang="sk">Kontrola overenia</sh:name>
        <sh:name xml:lang="pt">Controlo de verificação</sh:name>
        <sh:description xml:lang="it">Le condizioni e il risultato di una verifica condotta sulla base di determinati criteri prescritti nel contesto di una credenziale con firma digitale.</sh:description>
        <sh:name xml:lang="bg">Проверка</sh:name>
        <sh:name xml:lang="is">Sannprófun</sh:name>
        <sh:name xml:lang="el">Έλεγχος επαλήθευσης</sh:name>
        <sh:name xml:lang="cs">Kontrola ověření</sh:name>
        <sh:name xml:lang="en">verification check</sh:name>
        <sh:description xml:lang="pt">As condições e o resultado de um teste com base em determinados critérios prescritos no contexto de uma credencial assinada digitalmente.</sh:description>
        <sh:name xml:lang="sv">Verifiering</sh:name>
        <sh:description xml:lang="lv">Digitāli parakstīta apliecinājuma dokumenta kontekstā saskaņā ar iepriekš noteiktiem kritērijiem veiktas pārbaudes nosacījumi un rezultāts.</sh:description>
        <sh:description xml:lang="et">Digitaalselt allkirjastatud tõendi teatavate etteantud kriteeriumide alusel testimise tingimused ja tulemus.</sh:description>
        <sh:name xml:lang="sl">Preverjanje</sh:name>
        <sh:description xml:lang="mt">Il-kundizzjonijiet u r-riżultat ta’ test skont ċerti kriterji preskritti fil-kuntest ta’ kredenzjali ffirmata diġitalment.</sh:description>
        <sh:name xml:lang="hr">Provjera</sh:name>
        <sh:description xml:lang="sr">Услови и резултати теста у односу на одређене прописане критеријуме у контексту дигитално потписаног акредитива.</sh:description>
        <sh:description xml:lang="lt">Su skaitmeniniu parašu patvirtintu kredencialu susijusio bandymo pagal tam tikrus nustatytus kriterijus sąlygos ir rezultatai.</sh:description>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/VerificationCheck"/>
        <sh:description xml:lang="no">Betingelsene og resultatet av en test mot visse foreskrevne kriterier i sammenheng med en digitalt signert legitimasjon.</sh:description>
        <sh:description xml:lang="da">Betingelserne for og resultatet af en prøvning i forhold til visse foreskrevne kriterier i forbindelse med et digitalt underskrevet eksamensbevis.</sh:description>
        <sh:description xml:lang="pl">Nazwa warunków i wyniku testu przeprowadzanego pod kątem określonych, wcześniej ustalonych kryteriów w kontekście poświadczenia opatrzonego podpisem cyfrowym.</sh:description>
        <sh:name xml:lang="ro">Control de verificare</sh:name>
        <sh:description xml:lang="cs">Podmínky a výsledek testu podle určitých předepsaných kritérií v kontextu digitálně podepsaného certifikátu.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/verificationCheck"/>
        <sh:description xml:lang="sk">Podmienky a výsledok testu na základe určitých predpísaných kritérií v súvislosti s digitálne podpísaným certifikátom.</sh:description>
        <sh:description xml:lang="bg">Условията и резултатите от тест спрямо определени критерии в контекста на цифрово подписано удостоверение.</sh:description>
        <sh:description xml:lang="sv">Villkoren och resultatet av ett test mot vissa föreskrivna kriterier i samband med en digitalt signerad referens.</sh:description>
        <sh:name xml:lang="et">Kontroll</sh:name>
        <sh:description xml:lang="ro">Condițiile și rezultatul unui test pe baza anumitor criterii prevăzute în contextul unei acreditări semnate digital.</sh:description>
        <sh:description xml:lang="hu">A digitális aláírással ellátott tanúsítvánnyal összefüggésben, előzetesen meghatározott kritériumok alapján végzett vizsgálat feltételei és eredménye.</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="no">Data hentet fra én eller flere europeiske digitale legitimasjoner.</rdfs:comment>
    <rdfs:label xml:lang="mt">Preżentazzjoni Diġitali Ewropea</rdfs:label>
    <rdfs:label xml:lang="sr">Европска дигитална презентација</rdfs:label>
    <rdfs:label xml:lang="es">Presentación digital europea</rdfs:label>
    <rdfs:comment xml:lang="nl">Gegevens die zijn afgeleid van een of meer Europese digitale credentials.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
    <rdfs:comment xml:lang="it">Dati derivati da una o più credenziali digitali europee.</rdfs:comment>
    <rdfs:comment xml:lang="sr">Подаци изведени из најмање једног Европског дигиталног акредитива.</rdfs:comment>
    <rdfs:comment xml:lang="et">Ühest või mitmest Euroopa digitaalsest õppetõendist saadud teave.</rdfs:comment>
    <rdfs:comment xml:lang="hu">Egy vagy több európai digitális tanúsítványból származó adatok.</rdfs:comment>
    <sh:property>

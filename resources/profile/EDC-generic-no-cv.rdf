    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Organisation-elm_eidasLegalIdentifier">
        <sh:description xml:lang="ro">Un emitent trebuie să aibă un singur identificator emis în mod oficial de o autoritate publică dată, care are un context spațial.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="ga">Ní mór aitheantóir amháin arna eisiúint go foirmiúil ag údarás poiblí ar leith, a bhfuil comhthéacs spásúil aige, a bheith ag eisitheoir.</sh:description>
        <sh:name xml:lang="en">eIDAS identifier</sh:name>
        <sh:name xml:lang="cs">povinný právní identifikátor</sh:name>
        <sh:description xml:lang="sr">Издавалац мора да има један једини идентификатор који је формално издало одређено државно тело који садржи просторни контекст.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:name xml:lang="hr">obvezna pravna identifikacijska oznaka</sh:name>
        <sh:name xml:lang="me">obavezni pravni identifikator</sh:name>
        <sh:name xml:lang="mk">задолжителен правен идентификатор</sh:name>
        <sh:description xml:lang="et">Väljaandjal peab olema üks ja ainult üks ametlikult väljastatud identifikaator, mille on välja andnud konkreetne ametiasutus ja millel on ruumiline kontekst.</sh:description>
        <sh:description xml:lang="no">En utsteder må ha én og kun én formelt utstedt identifikator av en gitt offentlig myndighet, som har en romlig kontekst.</sh:description>
        <sh:description xml:lang="is">Útgefandi má aðeins hafa eitt formlegt aukenni sem gefið er út af tilteknu yfirvaldi í svæðistengdu samengi.</sh:description>
        <sh:description xml:lang="en">The official identification number of the organisation, as awarded by the relevant national authority.authority.</sh:description>
        <sh:name xml:lang="lv">obligātais juridiskais identifikators</sh:name>
        <sh:description xml:lang="nl">Een verstrekker moet één en niet meer dan één door een bepaalde overheidsinstantie formeel verstrekte identificatiecode hebben, met een ruimtelijke context.</sh:description>
        <sh:description xml:lang="lt">Išdavėjas turi turėti tik vieną konkrečios valdžios institucijos oficialiai išduotą identifikatorių, turintis teritorinį aspektą.</sh:description>
        <sh:description xml:lang="pt">Um emitente deve ter um e apenas um identificador formalmente emitido por uma determinada autoridade pública que tenha um contexto espacial.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:description xml:lang="da">En udsteder skal have én og kun én formelt udstedt identifikator fra en given offentlig myndighed, som har en pladsmæssig sammenhæng.</sh:description>
        <sh:description xml:lang="hu">Egy kibocsátónak rendelkeznie kell egy olyan azonosítóval, amelyet egy konkrét hatóság adott ki, és amely térbeli információkat is tartalmaz. A kibocsátó kizárólag egyetlen ilyen azonosítóval rendelkezhet.</sh:description>
        <sh:description xml:lang="pl">Instytucja wydająca musi posiadać jeden i tylko jeden wydany formalnie przez dany organ publiczny identyfikator, który ma kontekst przestrzenny.</sh:description>
        <sh:description xml:lang="sk">Vydavateľ musí mať len jeden identifikátor formálne vydaný príslušným orgánom verejnej moci, ktorý sa vzťahuje na určitý priestor.</sh:description>
        <sh:name xml:lang="sk">povinné právne identifikačné číslo</sh:name>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LegalIdentifier"/>
        <sh:name xml:lang="et">kohustuslik juriidiline identifikaator</sh:name>
        <sh:description xml:lang="mt">Emmittent għandu jkollu identifikatur wieħed u wieħed biss maħruġ formalment minn awtorità pubblika partikolari, li għandu kuntest spazjali.</sh:description>
        <sh:name xml:lang="sr">обавезан законски идентификатор</sh:name>
        <sh:name xml:lang="ro">identificator juridic obligatoriu</sh:name>
        <sh:description xml:lang="sv">En utfärdare måste ha en och endast en formellt utfärdad identifierare från en viss offentlig myndighet som har en geografisk kontext.</sh:description>

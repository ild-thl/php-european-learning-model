        >2</sh:order>
        <sh:name xml:lang="en">alternative label</sh:name>
        <sh:description xml:lang="en">The range of skos:altLabel is the class of RDF plain literals.</sh:description>
        <sh:description xml:lang="en">skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>

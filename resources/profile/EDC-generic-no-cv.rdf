        <sh:name xml:lang="cs">Místo</sh:name>
        <sh:name xml:lang="sl">Kraj</sh:name>
        <sh:description xml:lang="it">Il luogo geografico identificabile del soggetto in grado di svolgere azioni.</sh:description>
        <sh:description xml:lang="nl">De identificeerbare geografische plaats van de entiteit die in staat is om acties uit te voeren.</sh:description>
        <sh:description xml:lang="mt">Il-post ġeografiku identifikabbli tal-entità li tista’ twettaq azzjonijiet.</sh:description>
        <sh:name xml:lang="it">Luogo</sh:name>
        <sh:description xml:lang="en">The location of a resource.</sh:description>
        <sh:description xml:lang="bg">Установимо географско място на субекта, който е в състояние да извършва действия.</sh:description>
        <sh:name xml:lang="et">Toimumiskoht</sh:name>
        <sh:description xml:lang="is">Auðkennanleg landfræðileg staðsetning aðila sem er fær um að sjá um framkvæmd aðgerða.</sh:description>
        <sh:description xml:lang="el">Ο προσδιορίσιμος γεωγραφικός τόπος στον οποίο βρίσκεται η οντότητα που είναι σε θέση να εκτελεί ενέργειες.</sh:description>
        <sh:name xml:lang="es">Ubicación</sh:name>
        <sh:name xml:lang="lv">Vieta</sh:name>
        <sh:name xml:lang="lt">Vieta</sh:name>
        <sh:name xml:lang="nl">Plaats</sh:name>
        <sh:name xml:lang="ro">Locul</sh:name>
        <sh:description xml:lang="sv">Den identifierbara geografiska platsen för den enhet som kan vidta åtgärder.</sh:description>
        <sh:name xml:lang="fi">Sijainti</sh:name>
        <sh:description xml:lang="mk">Препознатливо географско место на ентитетот кој може да спроведе активности.</sh:description>
        <sh:description xml:lang="et">Tegevusi läbiviiva üksuse tuvastatav geograafiline asukoht.</sh:description>
        <sh:description xml:lang="no">Det identifiserbare geografiske stedet for enheten som er i stand til å utføre handlinger.</sh:description>
        <sh:description xml:lang="en">The identifiable geographic place of the entity that is able to carry out actions.</sh:description>
        <sh:description xml:lang="ga">Áit gheografach inaitheanta an eintitis atá in ann gníomhaíochtaí a dhéanamh.</sh:description>
        <sh:description xml:lang="ro">Locul geografic identificabil al entității care este în măsură să desfășoare acțiuni.</sh:description>
        <sh:name xml:lang="bg">Местоположение</sh:name>
        <sh:name xml:lang="pl">Miejsce</sh:name>
        <sh:name xml:lang="en">location</sh:name>
        <sh:name xml:lang="ga">Suíomh</sh:name>
        <sh:description xml:lang="lv">Tās entītijas ģeogrāfiskā atrašanās vieta, kura var veikt darbības.</sh:description>
        <sh:description xml:lang="fi">Toimien toteuttamiseen kykenevän tahon todennettavissa oleva maantieteellinen paikka.</sh:description>
        <sh:name xml:lang="mk">Локација</sh:name>
        <sh:name xml:lang="hr">Lokacija</sh:name>
        <sh:name xml:lang="me">Lokacija</sh:name>
        <sh:description xml:lang="pt">O local geograficamente identificado da entidade capaz de realizar ações.</sh:description>
        <sh:name xml:lang="no">Sted</sh:name>
        <sh:name xml:lang="da">Sted</sh:name>
        <sh:name xml:lang="sk">Miesto</sh:name>
        <sh:name xml:lang="tr">Yer</sh:name>
        <sh:description xml:lang="fr">Le lieu géographique identifiable de l’entité ayant la capacité de mener des actions.</sh:description>
        <sh:description xml:lang="es">La ubicación geográfica identificable de la entidad que puede llevar a cabo las acciones.</sh:description>
        <sh:description xml:lang="me">Prepoznatljivo geografsko mjesto subjekta koji je u stanju da sprovodi akcije.</sh:description>
        <sh:name xml:lang="sv">Plats</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >8</sh:order>
        <sh:description xml:lang="hr">Prepoznatljivo zemljopisno mjesto subjekta koji može provoditi mjere.</sh:description>
        <sh:name xml:lang="hu">Helyszín</sh:name>
        <sh:name xml:lang="mt">Lok</sh:name>
        <sh:description xml:lang="sl">Določljiv geografski kraj subjekta, ki lahko opravlja dejavnosti.</sh:description>
        <sh:description xml:lang="sk">Identifikovateľné geografické miesto subjektu, ktorý môže vykonávať akcie.</sh:description>
        <sh:name xml:lang="is">Staðsetning</sh:name>
        <sh:description xml:lang="pl">Możliwa do zidentyfikowania lokalizacja geograficzna podmiotu, który jest w stanie prowadzić działania.</sh:description>
        <sh:description xml:lang="cs">Identifikovatelná zeměpisná poloha entity, která může provádět akce.</sh:description>
        <sh:description xml:lang="da">Identificerbart geografisk sted for den enhed, der kan udføre handlinger.</sh:description>
        <sh:description xml:lang="lt">Subjekto, galinčio atlikti veiksmus, identifikuojama geografinė vieta.</sh:description>

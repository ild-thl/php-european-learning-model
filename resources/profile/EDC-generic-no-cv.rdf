        <sh:description xml:lang="sr">Препознатљиво географско место ентитета који може да обавља радње.</sh:description>
        <sh:name xml:lang="pt">Local</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>

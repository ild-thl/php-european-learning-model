        <sh:name xml:lang="ga">Sonraí teagmhála</sh:name>
        <sh:name xml:lang="es">Información de contacto</sh:name>
        <sh:name xml:lang="sk">Kontaktné údaje</sh:name>
        <sh:description xml:lang="is">Tengiliðaupplýsingar aðila sem er fær um að sjá um framkvæmd aðgerða.</sh:description>

                    <dc:title xml:lang="en">Claim Type Node </dc:title>
                    <sh:property>
                      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/ClaimTypeNode-dc_type">
                        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>

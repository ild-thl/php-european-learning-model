        <sh:name xml:lang="ga">ginearálú</sh:name>
        <sh:description xml:lang="el">Προδιαγραφή μαθησιακού επιτεύγματος (π.χ. πρότυπο) της οποίας η συγκεκριμένη προδιαγραφή αποτελεί γενίκευση.</sh:description>
        <sh:name xml:lang="el">γενίκευση του</sh:name>
        <sh:description xml:lang="sl">Specifikacija učnega dosežka (npr. standard), katere posplošitev je ta specifikacija.</sh:description>
        <sh:name xml:lang="sl">generalizacija</sh:name>
        <sh:name xml:lang="me">generalizacija</sh:name>

    <rdfs:comment xml:lang="nl">Een rechtspersoon (in tegenstelling tot een natuurlijk persoon).</rdfs:comment>
    <rdfs:comment xml:lang="ro">O persoană juridică (spre deosebire de o persoană fizică).</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Organisation-rov_legalName">

            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Organisation"/>
          </rdf:Description>
        </sh:or>
        <sh:name xml:lang="en">Credential subject</sh:name>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:label xml:lang="me">Evropski digitalni kredencijal</rdfs:label>
    <sh:group rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</sh:group>
    <rdfs:label xml:lang="hu">Európai digitális tanúsítvány</rdfs:label>
    <rdfs:comment xml:lang="nl">Een speciaal type verifieerbare credential dat wordt gebruikt om leer- en werkgegevens uit te drukken overeenkomstig de aanbeveling van de Raad van 22 mei 2017 inzake het Europees kwalificatiekader voor een leven lang leren.</rdfs:comment>
    <rdfs:comment xml:lang="et">Õppimis- ja tööhõiveandmete väljendamiseks kasutatav eriliigiline verifitseeritav tõend kooskõlas nõukogu 22. mai 2017. aasta soovitusega pidevõppe Euroopa kvalifikatsiooniraamistiku kohta.</rdfs:comment>
    <rdfs:comment xml:lang="cs">Zvláštní typ ověřitelného certifikátu, který se používá k vyjádření údajů o vzdělávání a zaměstnání v souladu s doporučením Rady ze dne 22. května 2017 o evropském rámci kvalifikací pro celoživotní učení.</rdfs:comment>
    <rdfs:label xml:lang="cs">Evropský digitální certifikát</rdfs:label>
    <rdfs:label xml:lang="lv">Eiropas digitālais apliecinājuma dokuments</rdfs:label>
    <rdfs:label xml:lang="ga">Dintiúr Digiteach Eorpach</rdfs:label>
    <rdfs:label xml:lang="pt">Credencial digital europeia</rdfs:label>
    <rdfs:comment xml:lang="bg">Специален вид проверимо удостоверение, използвано за посочване на данни за обучение и заетост в съответствие с Препоръката на Съвета от 22 май 2017 г. относно Европейската квалификационна рамка за обучение през целия живот.</rdfs:comment>
    <rdfs:label xml:lang="mk">Европски Дигитален Акредитив</rdfs:label>
    <rdfs:comment xml:lang="da">En særlig type verificerbart eksamensbevis, der anvendes til at udtrykke lærings- og beskæftigelsesdata i overensstemmelse med Rådets henstilling af 22. maj 2017 om den europæiske referenceramme for kvalifikationer for livslang læring.</rdfs:comment>
    <rdfs:comment xml:lang="is">Sérstök tegund sannreynanlegra skilríkja sem notuð er til að setja fram gögn um nám og störf, í samræmi við tilmæli ráðsins frá 22. maí 2017 varðandi Evrópska viðmiðarammann fyrir ævinám.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-cred_issued">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="https://www.w3.org/2018/credentials#issued"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >3</sh:order>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="tr">Yaşam boyu öğrenme için Avrupa Yeterlilik Çerçevesi, 22 Mayıs 2017 tarihli Konsey Tavsiyesi ile doğru orantılı olarak öğrenme ve istihdam verilerinin ifade edilmesi için kullanılan doğrulanabilir yeterlilik kanıtının özel bir türü.</rdfs:comment>
    <rdfs:comment xml:lang="ga">Cineál speisialta dintiúir infhíoraithe a úsáidtear chun sonraí foghlama agus fostaíochta a chur in iúl, i gcomhréir leis an Moladh ón gComhairle an 22 Bealtaine 2017 maidir leis an gCreat Eorpach um Cháilíochtaí don fhoghlaim ar feadh an tsaoil.</rdfs:comment>
    <rdfs:label xml:lang="en">European Digital Credential</rdfs:label>
    <rdfs:label xml:lang="sk">Európsky digitálny certifikát</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-cred_credentialStatus">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="https://www.w3.org/2018/credentials#credentialStatus"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:name xml:lang="en">Credential status</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/CredentialStatus"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-cred_evidence">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="https://www.w3.org/2018/credentials#evidence"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:name xml:lang="en">Evidence</sh:name>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Evidence"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:label xml:lang="fi">Eurooppalainen digitaalinen osaamistodistus</rdfs:label>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/EuropeanDigitalCredential"/>
    <rdfs:label xml:lang="sv">Europeisk digital referens</rdfs:label>
    <rdfs:comment xml:lang="sv">En speciell typ av verifierbar referens som används för att uttrycka lärande- och anställningsdata enligt rådets rekommendation av den 22 maj 2017 om den europeiska referensramen för livslångt lärande.</rdfs:comment>
    <rdfs:label xml:lang="is">Evrópskt starfrænt skírteini</rdfs:label>
    <rdfs:label xml:lang="it">Credenziale digitale europea</rdfs:label>
    <rdfs:label xml:lang="sr">Европски дигитални акредитив</rdfs:label>
    <rdfs:comment xml:lang="pl">Specjalny rodzaj weryfikowalnego poświadczenia wykorzystywanego do wyrażenia danych dotyczących uczenia się i zatrudnienia, zgodnie z zaleceniem Rady z dnia 22 maja 2017 r. w sprawie europejskich ram kwalifikacji dla uczenia się przez całe życie.</rdfs:comment>
    <rdfs:label xml:lang="et">Euroopa digitaalne õppetõend</rdfs:label>
    <rdfs:label xml:lang="tr">Avrupa Dijital Yeterlilik Kanıtları</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-elm_attachment">
        <sh:name xml:lang="sl">priloga</sh:name>
        <sh:description xml:lang="lt">Bet koks skaitmeninis dokumentas (PDF, JPEG arba PNG formatu), kurį prie Europos skaitmeninio kredencialo dokumento pridėjo jį išdavęs asmuo.</sh:description>
        <sh:name xml:lang="mt">dokument mehmuż</sh:name>
        <sh:description xml:lang="sl">Kateri koli digitalni dokument (v obliki DPF, JPEG ali PNG), ki ga izdajatelj priloži dokumentu z evropskim digitalnim potrdilom.</sh:description>
        <sh:description xml:lang="sv">Ett digitalt dokument (i pdf-, jpeg- eller png-format) som en utfärdare har bifogat till det europeiska digitala referensdokumentet.</sh:description>
        <sh:description xml:lang="mk">Било кој дигитален документ (PDF, JPEG или PNG формат) којшто издавачот го прикачил кон документот на Европскиот дигитален акредитив.</sh:description>
        <sh:description xml:lang="cs">Veškeré digitální dokumenty (ve formátu PDF, JPEG nebo PNG), které vydavatel připojil k evropskému digitálnímu certifikátu.</sh:description>
        <sh:name xml:lang="lv">pielikums</sh:name>
        <sh:name xml:lang="et">manus</sh:name>
        <sh:description xml:lang="fi">Digitaalinen asiakirja (PDF-, JPEG- tai PNG-muodossa), jonka todistuksen myöntäjä on liittänyt eurooppalaiseen digitaaliseen osaamistodistukseen.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="hu">Minden olyan digitális dokumentum (PDF, JPEG vagy PNG formátumban), amelyet a kibocsátó az európai digitális tanúsítványhoz csatolt.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:name xml:lang="no">vedlegg</sh:name>
        <sh:name xml:lang="el">συνημμένο</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:description xml:lang="mt">Kwalunkwe dokument diġitali (format PDF, JPEG jew PNG) li emittent ikun hemeż mad-dokument tal-Kredenzjali Diġitali Ewropea.</sh:description>
        <sh:description xml:lang="sk">Digitálne dokumenty (vo formáte PDF, JPEG alebo PNG), ktoré vydavateľ pripojil k dokumentu európskeho digitálneho certifikátu.</sh:description>
        <sh:name xml:lang="tr">ek</sh:name>
        <sh:name xml:lang="fr">pièce jointe</sh:name>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/MediaObject"/>
        <sh:name xml:lang="cs">příloha</sh:name>
        <sh:description xml:lang="pt">Qualquer documento digital (formato PDF, JPEG ou PNG) que um emitente tenha anexado ao documento da credencial digital europeia.</sh:description>
        <sh:name xml:lang="fi">liite</sh:name>
        <sh:name xml:lang="lt">priedas</sh:name>
        <sh:description xml:lang="nl">Elk digitaal document (in pdf-, jpeg- of png-formaat) dat een verstrekker bij het document van de Europese digitale credential heeft gevoegd.</sh:description>
        <sh:description xml:lang="me">Svaki digitalni dokument (PDF, JPEG ili PNG format) koji je izdavalac priložio dokumentu Evropskog digitalnog kredencijala.</sh:description>
        <sh:description xml:lang="lv">Jebkurš digitāls dokuments (PDF, JPEG vai PNG formātā), ko izdevējs ir pievienojis Eiropas digitālajam apliecinājuma dokumentam.</sh:description>
        <sh:description xml:lang="de">Jedes digitale Dokument (PDF, JPEG oder PNG), das ein Herausgeber dem Europäischen Digitalen Bildungsnachweisdokument beigefügt hat.</sh:description>
        <sh:name xml:lang="sk">príloha</sh:name>
        <sh:description xml:lang="en">Any digital document (PDF, JPEG or PNG format) that an issuer has attached to the European Digital Credential document.</sh:description>
        <sh:description xml:lang="tr">Tahsis edenin Avrupa Dijital Yeterlilik Kanıtı belgesine eklediği herhangi bir dijital belge (PDF, JPEG veya PNG biçiminde).</sh:description>
        <sh:name xml:lang="mk">прилог</sh:name>
        <sh:name xml:lang="sr">прилог</sh:name>
        <sh:description xml:lang="is">Hvers kyns stafræn skjöl (á PDF, JPEG eða PNG sniði) sem útgefandi hefur hengt við Evrópska stafræna skilríkið.</sh:description>
        <sh:description xml:lang="bg">Всеки цифров документ (формат PDF, JPEG или PNG), който издаваща организация е приложила към документа за европейско цифрово удостоверение.</sh:description>
        <sh:description xml:lang="ga">Aon doiciméad digiteach (formáid PDF, JPEG nó PNG) a chuir eisitheoir i gceangal le doiciméad an Dintiúir Dhigitigh Eorpaigh.</sh:description>
        <sh:name xml:lang="sv">bilaga</sh:name>
        <sh:description xml:lang="sr">Сваки дигитални документ (у PDF, JPEG или PNG формату) који је издавалац приложио документу Европског дигиталног акредитива.</sh:description>
        <sh:name xml:lang="da">vedhæftet fil</sh:name>
        <sh:name xml:lang="is">fylgiskjal</sh:name>
        <sh:name xml:lang="pt">anexo</sh:name>
        <sh:description xml:lang="en">Any digital document (PDF, JPEG or PNG format) that an issuer has attached to the European digital credential document.</sh:description>
        <sh:name xml:lang="ro">anexă</sh:name>
        <sh:name xml:lang="es">archivo adjunto</sh:name>
        <sh:name xml:lang="en">attachment</sh:name>
        <sh:name xml:lang="it">allegato</sh:name>
        <sh:name xml:lang="ga">ceangaltán</sh:name>
        <sh:name xml:lang="de">Anhang</sh:name>
        <sh:description xml:lang="pl">Wszystkie dokumenty elektroniczne (w formacie PDF, JPEG lub PNG), które instytucja wydająca załączyła do dokumentu europejskiego poświadczenia cyfrowego.</sh:description>
        <sh:name xml:lang="hu">csatolmány</sh:name>
        <sh:description xml:lang="el">Τυχόν ψηφιακό έγγραφο (σε μορφότυπο PDF, JPEG ή PNG) το οποίο έχει επισυνάψει ένας εκδότης στο ευρωπαϊκό ψηφιακό διαπιστευτήριο.</sh:description>
        <sh:description xml:lang="no">Ethvert digitalt dokument (PDF-, JPEG- eller PNG-format) som en utsteder har lagt ved europeisk digital legitimasjon-dokumentet.</sh:description>
        <sh:description xml:lang="da">Et digitalt dokument (PDF, JPEG eller PNG), som en udsteder har vedhæftet til det europæiske digitale eksamensbevis.</sh:description>
        <sh:description xml:lang="fr">Tout document numérique (format PDF, JPEG ou PNG) qu’un émetteur a joint au document du justificatif numérique européen.</sh:description>
        <sh:name xml:lang="pl">załącznik</sh:name>
        <sh:description xml:lang="ro">Orice document digital (în format PDF, JPEG sau PNG) pe care un emitent l-a anexat la documentul acreditării digitale europene.</sh:description>
        <sh:description xml:lang="et">Mis tahes digitaalne dokument (PDF-, JPEG- või PNG-vormingus), mille väljaandja on Euroopa digitaalsele õppetõendile lisanud.</sh:description>
        <sh:name xml:lang="bg">приложение</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/attachment"/>
        <sh:name xml:lang="nl">bijlage</sh:name>
        <sh:description xml:lang="hr">Svaki digitalni dokument (PDF, JPEG ili PNG) koji je izdavatelj priložio ispravi o europskoj digitalnoj vjerodajnici.</sh:description>
        <sh:name xml:lang="me">prilog</sh:name>
        <sh:name xml:lang="hr">prilog</sh:name>
        <sh:description xml:lang="es">Cualquier documento digital (formato PDF, JPEG o PNG) que un emisor haya adjuntado al documento de la credencial digital europea.</sh:description>
        <sh:description xml:lang="it">Qualsiasi documento digitale (formato PDF, JPEG o PNG) che un emittente ha allegato al documento della credenziale digitale europea.</sh:description>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:label xml:lang="es">Credencial digital europea</rdfs:label>
    <rdfs:label xml:lang="sl">Evropsko digitalno potrdilo</rdfs:label>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-cred_issuer">
        <sh:path rdf:resource="https://www.w3.org/2018/credentials#issuer"/>
        <sh:node>
          <sh:NodeShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/IssuerNodeShape">
            <sh:property>
              <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/IssuerNode-elm_eidasLegalIdentifier">
                <sh:name xml:lang="lt">privalomas teisinis identifikatorius</sh:name>
                <sh:name xml:lang="cs">povinný právní identifikátor</sh:name>
                <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
                >1</sh:maxCount>
                <sh:name xml:lang="fr">identifiant juridique obligatoire</sh:name>
                <sh:description xml:lang="en">The official identification number of the organisation, as awarded by the relevant national authority.authority.</sh:description>
                <sh:name xml:lang="el">υποχρεωτικό αναγνωριστικό νομικής οντότητας</sh:name>
                <sh:description xml:lang="pl">Instytucja wydająca musi posiadać jeden i tylko jeden wydany formalnie przez dany organ publiczny identyfikator, który ma kontekst przestrzenny.</sh:description>
                <sh:description xml:lang="me">Izdavalac mora imati jedan i samo jedan službeno izdat identifikator od strane datog javnog organa, koji ima prostorni kontekst.</sh:description>
                <sh:description xml:lang="fr">Un émetteur doit avoir un seul identifiant formellement émis par une autorité publique donnée, qui possède un contexte géographique.</sh:description>
                <sh:name xml:lang="pl">obowiązkowy identyfikator prawny</sh:name>
                <sh:description xml:lang="nl">Een verstrekker moet één en niet meer dan één door een bepaalde overheidsinstantie formeel verstrekte identificatiecode hebben, met een ruimtelijke context.</sh:description>
                <sh:name xml:lang="no">obligatorisk juridisk identifikator</sh:name>
                <sh:name xml:lang="da">obligatorisk juridisk identifikator</sh:name>
                <sh:description xml:lang="ro">Un emitent trebuie să aibă un singur identificator emis în mod oficial de o autoritate publică dată, care are un context spațial.</sh:description>
                <sh:description xml:lang="mk">Издавачот мора да има еден и само еден формално издаден идентификатор од одреден јавен орган, којшто има просторен контекст.</sh:description>
                <sh:name xml:lang="en">mandatory legal identifier</sh:name>
                <sh:name xml:lang="fi">pakollinen oikeudellinen tunniste</sh:name>
                <sh:name xml:lang="is">lögboðið auðkenni</sh:name>
                <sh:name xml:lang="sr">обавезан законски идентификатор</sh:name>
                <sh:name xml:lang="es">identificador legal obligatorio</sh:name>
                <sh:description xml:lang="ga">Ní mór aitheantóir amháin arna eisiúint go foirmiúil ag údarás poiblí ar leith, a bhfuil comhthéacs spásúil aige, a bheith ag eisitheoir.</sh:description>
                <sh:description xml:lang="sv">En utfärdare måste ha en och endast en formellt utfärdad identifierare från en viss offentlig myndighet som har en geografisk kontext.</sh:description>
                <sh:name xml:lang="et">kohustuslik juriidiline identifikaator</sh:name>
                <sh:name xml:lang="hu">kötelező jogi azonosító</sh:name>
                <sh:description xml:lang="sk">Vydavateľ musí mať len jeden identifikátor formálne vydaný príslušným orgánom verejnej moci, ktorý sa vzťahuje na určitý priestor.</sh:description>
                <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
                <sh:description xml:lang="en">An issuer must have one and only one formally issued identifier by a given public authority, that has a spatial context.</sh:description>
                <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
                >3</sh:order>
                <sh:description xml:lang="it">Un emittente deve avere un unico identificativo emesso formalmente da una determinata autorità pubblica, che ha un contesto spaziale.</sh:description>
                <sh:description xml:lang="fi">Myöntäjällä tulee olla yksi (ja vain yksi) viranomaisen myöntämä tunniste, joka koskee tiettyä aluetta.</sh:description>
                <sh:name xml:lang="tr">zorunlu kanuni tanımlayıcı</sh:name>
                <sh:name xml:lang="ga">aitheantóir dlíthiúil éigeantach</sh:name>
                <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/eidasLegalIdentifier"/>
                <sh:description xml:lang="lv">Izdevējam drīkst būt tikai viens noteiktas publiskās iestādes oficiāli izdots ģeogrāfisks identifikators.</sh:description>
                <sh:description xml:lang="el">Ένας εκδότης πρέπει να διαθέτει ένα και μόνο ένα αναγνωριστικό που έχει εκδοθεί επίσημα από συγκεκριμένη δημόσια αρχή, το οποίο έχει χωρικό πλαίσιο.</sh:description>
                <sh:name xml:lang="lv">obligātais juridiskais identifikators</sh:name>
                <sh:name xml:lang="mt">identifikatur legali obbligatorju</sh:name>
                <sh:name xml:lang="hr">obvezna pravna identifikacijska oznaka</sh:name>
                <sh:description xml:lang="mt">Emmittent għandu jkollu identifikatur wieħed u wieħed biss maħruġ formalment minn awtorità pubblika partikolari, li għandu kuntest spazjali.</sh:description>
                <sh:description xml:lang="bg">За издаваща организация може да има само един идентификатор, определен официално от даден публичен орган, който има пространствен контекст.</sh:description>
                <sh:description xml:lang="cs">Vydavatel musí mít pouze jeden identifikátor formálně vydaný příslušným orgánem veřejné moci, který se vztahuje k určitému území.</sh:description>
                <sh:name xml:lang="bg">задължителен правен идентификатор</sh:name>
                <sh:name xml:lang="me">obavezni pravni identifikator</sh:name>
                <sh:name xml:lang="ro">identificator juridic obligatoriu</sh:name>
                <sh:description xml:lang="et">Väljaandjal peab olema üks ja ainult üks ametlikult väljastatud identifikaator, mille on välja andnud konkreetne ametiasutus ja millel on ruumiline kontekst.</sh:description>
                <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LegalIdentifier"/>
                <sh:description xml:lang="de">Ein Herausgeber muss über eine einzige offiziell von einer bestimmten Behörde ausgegebene Kennung verfügen, die einen räumlichen Kontext hat.</sh:description>
                <sh:name xml:lang="sl">obvezni pravni identifikator</sh:name>
                <sh:description xml:lang="hu">Egy kibocsátónak rendelkeznie kell egy olyan azonosítóval, amelyet egy konkrét hatóság adott ki, és amely térbeli információkat is tartalmaz. A kibocsátó kizárólag egyetlen ilyen azonosítóval rendelkezhet.</sh:description>
                <sh:name xml:lang="mk">задолжителен правен идентификатор</sh:name>
                <sh:name xml:lang="it">identificativo legale obbligatorio</sh:name>
                <sh:name xml:lang="nl">verplichte wettelijke identificatiecode</sh:name>
                <sh:description xml:lang="lt">Išdavėjas turi turėti tik vieną konkrečios valdžios institucijos oficialiai išduotą identifikatorių, turintis teritorinį aspektą.</sh:description>
                <sh:description xml:lang="is">Útgefandi má aðeins hafa eitt formlegt aukenni sem gefið er út af tilteknu yfirvaldi í svæðistengdu samengi.</sh:description>
                <sh:description xml:lang="sl">Izdajatelj mora imeti en in samo en identifikator s prostorskim okvirom, ki ga uradno izda dani javni organ.</sh:description>
                <sh:description xml:lang="sr">Издавалац мора да има један једини идентификатор који је формално издало одређено државно тело који садржи просторни контекст.</sh:description>
                <sh:description xml:lang="pt">Um emitente deve ter um e apenas um identificador formalmente emitido por uma determinada autoridade pública que tenha um contexto espacial.</sh:description>
                <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
                <sh:description xml:lang="es">Un emisor debe tener un único identificador emitido oficialmente por una autoridad pública determinada, que tenga un contexto espacial.</sh:description>
                <sh:name xml:lang="de">obligatorische gesetzliche Kennung</sh:name>
                <sh:name xml:lang="sk">povinné právne identifikačné číslo</sh:name>
                <sh:name xml:lang="pt">identificador legal obrigatório</sh:name>
                <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
                >1</sh:minCount>
                <sh:description xml:lang="da">En udsteder skal have én og kun én formelt udstedt identifikator fra en given offentlig myndighed, som har en pladsmæssig sammenhæng.</sh:description>
                <sh:description xml:lang="tr">Tahsis eden belirli bir kamu kurumu tarafından resmi olarak verilen ve mekansal bir bağlama sahip olan bir ve yalnızca bir tanımlayıcıya sahip olmalıdır.</sh:description>
                <sh:name xml:lang="en">eIDAS identifier</sh:name>
                <sh:description xml:lang="hr">Izdavatelj mora i smije imati samo jednu službeno izdanu identifikacijsku oznaku određenog javnog tijela koja ima prostorni kontekst.</sh:description>
                <sh:name xml:lang="sv">obligatorisk identifierare för juridisk person</sh:name>
                <sh:description xml:lang="no">En utsteder må ha én og kun én formelt utstedt identifikator av en gitt offentlig myndighet, som har en romlig kontekst.</sh:description>
              </rdf:Description>
            </sh:property>
            <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >22</sh:order>
            <sh:group rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
            >3</sh:group>
            <dc:title xml:lang="en">Issuer Node</dc:title>
            <dc:description xml:lang="en">This shape adds an extra constraint on the issuer of the European Digital Credential.</dc:description>
            <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
          </sh:NodeShape>
        </sh:node>
        <sh:or rdf:parseType="Collection">
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Agent"/>
          </rdf:Description>
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Person"/>
          </rdf:Description>
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Organisation"/>
          </rdf:Description>
        </sh:or>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="en">Issuer</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >3</sh:order>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:label xml:lang="fr">Justificatif numérique européen</rdfs:label>
    <rdfs:label xml:lang="el">Ευρωπαϊκό ψηφιακό διαπιστευτήριο</rdfs:label>
    <rdfs:label xml:lang="nl">Europese digitale credential</rdfs:label>
    <rdfs:comment xml:lang="fr">Un type particulier de justificatif vérifiable utilisé pour exprimer des données sur l’apprentissage et l’emploi, conformément à la recommandation du Conseil du 22 mai 2017 concernant le cadre européen des certifications pour l’apprentissage tout au long de la vie.</rdfs:comment>
    <rdfs:comment xml:lang="sr">Специјални тип акредитива који се може верификовати за изражавање података о учењу и запослењу, у складу са Препоруком Савета од 22. маја 2017. године о Европском оквиру квалификација и доживотном учењу.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-cred_issuanceDate">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="https://www.w3.org/2018/credentials#issuanceDate"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:name xml:lang="en">Issuance date</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="en">Defines the date and time, when the credential becomes valid.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
      </sh:PropertyShape>
    </sh:property>
    <rdfs:comment xml:lang="en">A special type of verifiable credential used to express learning and employment data, in line with the Council Recommendation of 22 May 2017 on the European Qualifications Framework for lifelong learning.</rdfs:comment>
    <rdfs:label xml:lang="hr">Europska digitalna vjerodajnica</rdfs:label>
    <rdfs:comment xml:lang="sk">Osobitný druh overiteľného certifikátu, ktorý sa používa na vyjadrenie údajov týkajúcich sa vzdelávania a zamestnania v súlade s odporúčaním Rady z 22. mája 2017 o európskom kvalifikačnom rámci pre celoživotné vzdelávanie.</rdfs:comment>
    <rdfs:comment xml:lang="mt">Tip speċjali ta’ kredenzjali verifikabbli użati biex jesprimu data dwar it-tagħlim u l-impjiegi, f’konformità mar-Rakkomandazzjoni tal-Kunsill tat-22 ta’ Mejju 2017 dwar il-Qafas Ewropew tal-Kwalifiki għat-tagħlim tul il-ħajja.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/EuropeanDigitalCredential-elm_displayParameter">

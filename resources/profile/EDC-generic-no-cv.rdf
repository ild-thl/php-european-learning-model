        <sh:description xml:lang="lv">Datums, no kuram norisinās darbības. Ja nav norādīts, tas nav definēts (“nav zināms”).</sh:description>
        <sh:name xml:lang="ga">Dáta Tosaigh</sh:name>
        <sh:name xml:lang="no">Dato fra</sh:name>

    <rdfs:label xml:lang="de">Beurteilung der Lernleistung</rdfs:label>
    <rdfs:comment xml:lang="sk">Postup zisťovania úrovne, v akej si vzdelávajúca sa osoba osvojila konkrétne vedomosti, zručnosti a kompetencie, na základe kritérií, ako sú vzdelávacie výstupy alebo normy kompetencií.</rdfs:comment>
    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/LearningAssessment-dc_type">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/type"/>

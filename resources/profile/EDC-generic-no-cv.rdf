                        <sh:description xml:lang="fi">Lisätietoa objektista tai aiheesta vapaamuotoisena tekstinä.</sh:description>
                        <sh:name xml:lang="sr">0.0</sh:name>
                        <sh:description xml:lang="et">Vaba tekstina esitatud lisateave objekti või teema kohta.</sh:description>
                        <sh:name xml:lang="de">Weitere Informationen</sh:name>
                        <sh:description xml:lang="tr">Serbest metin biçiminde verilen bir konu veya bir nesne hakkında daha fazla bilgi.</sh:description>
                        <sh:description xml:lang="mk">Дополнителни информации за објект или тема кои се доставени како слободен текст.</sh:description>
                        <sh:description xml:lang="mt">Aktar informazzjoni dwar oġġett jew suġġett ipprovduta bħala test liberu.</sh:description>
                        <sh:description xml:lang="sl">Dodatne informacije o gradniku ali temi, predložene kot prosto besedilo.</sh:description>
                        <sh:description xml:lang="pl">Dodatkowe informacje na temat obiektu lub tematu przedstawione jako tekst dowolny.</sh:description>
                        <sh:description xml:lang="pt">Informações adicionais sobre um objeto ou tema fornecidas em texto livre.</sh:description>

        <sh:name xml:lang="et">vaade</sh:name>
        <sh:description xml:lang="mk">Деталите за прикажување на акредитивот.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/displayParameter"/>

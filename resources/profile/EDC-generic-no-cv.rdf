    <sh:property>
      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/Person-elm_gender">
        <sh:description xml:lang="da">En persons køn. Hvis oplyst, skal værdien tages fra en kontrolleret ordliste (f.eks. http://publications.europa.eu/resource/authority/human-sex). Dataleverandører kan anvende deres egne kontrollerede lister.</sh:description>
        <sh:description xml:lang="tr">Bir kişinin cinsiyeti.Verilmişse, değer kontrol edilmiş bir sözlükten gelmelidir (e.g. http://publications.europa.eu/resource/authority/human-sex). Veri sağlayıcılar kendi kontrol edilmiş listesini(listelerini) kullanabilirler.</sh:description>
        <sh:name xml:lang="sv">Kön</sh:name>
        <sh:name xml:lang="cs">Pohlaví</sh:name>
        <sh:description xml:lang="mt">Il-ġeneru ta’ bniedem. Jekk jiġi pprovdut, il-valur għandu jiġi minn vokabularju kkontrollat (e.g. http://publications.europa.eu/resource/authority/human-sex). Il-fornituri tad-data jistgħu jużaw il-lista/i kontrollata/i tagħhom stess.</sh:description>
        <sh:name xml:lang="es">Sexo</sh:name>
        <sh:name xml:lang="fr">Sexe</sh:name>
        <sh:description xml:lang="sv">En persons kön. I förekommande fall ska värdet komma från en kontrollerad ordlista (t.ex. http://publications.europa.eu/resource/authority/human-sex). Uppgiftslämnare kan använda en eller flera egna kontrollerade listor.</sh:description>
        <sh:name xml:lang="el">Φύλο</sh:name>
        <sh:name xml:lang="pl">Płeć</sh:name>
        <sh:description xml:lang="nl">Het geslacht van een mens. Indien verstrekt, moet de waarde afkomstig zijn uit een gecontroleerde woordenlijst (e.g. http://publications.europa.eu/resource/authority/human-sex). Aanbieders van gegevens kunnen hun eigen gecontroleerde lijst(en) gebruiken.</sh:description>
        <sh:description xml:lang="hr">Spol pojedinca. Ako je navedena, vrijednost bi trebala biti iz kontroliranog rječnika (npr. http://publications.europa.eu/resource/authority/human-sex). Pružatelji podataka mogu se služiti vlastitim popisom/popisima.</sh:description>
        <sh:name xml:lang="sk">Pohlavie</sh:name>
        <sh:name xml:lang="me">Pol</sh:name>
        <sh:description xml:lang="no">Et menneskes kjønn.Hvis oppgitt, bør verdien komme fra et kontrollert vokabular (e.g. http://publications.europa.eu/resource/authority/human-sex). Dataleverandører kan bruke sin(e) egen/egne kontrollerte liste(r).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="me">Pol osobe. Ako je navedena, vrijednost bi trebalo da potiče iz kontrolisanog rječnika (npr. http://publications.europa.eu/resource/authoriti/human-sek). Provajderi podataka mogu da koriste sopstvene kontrolisane liste.</sh:description>
        <sh:description xml:lang="fi">Henkilön sukupuoli. Jos arvo määritellään, sen täytyy perustua kontrolloituun sanastoon(esim. http://publications.europa.eu/resource/authority/human-sex). Tietojen toimittajat voivat käyttää omia kontrolloituja luetteloitaan (yhtä tai useampaa).</sh:description>
        <sh:name xml:lang="ga">Inscne</sh:name>
        <sh:description xml:lang="hu">Nem. Az értéknek (ha meg van adva) ellenőrzött szójegyzékből kell származnia (e.g. http://publications.europa.eu/resource/authority/human-sex). Az adatszolgáltatók használhatják a saját ellenőrzött listájukat (listáikat).</sh:description>
        <sh:name xml:lang="nl">Geslacht</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv"/>
        <sh:name xml:lang="pt">Género</sh:name>
        <sh:description xml:lang="es">El sexo de un ser humano. Si se facilita, el valor debe proceder de un vocabulario controlado (por ejemplo, http://publications.europa.eu/resource/authority/human-sex). Los proveedores de datos pueden utilizar su propia lista o listas controladas.</sh:description>
        <sh:name xml:lang="tr">Cinsiyet</sh:name>
        <sh:name xml:lang="hr">Spol</sh:name>
        <sh:name xml:lang="sl">Spol</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:name xml:lang="mt">Sess</sh:name>
        <sh:name xml:lang="no">Kjønn</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/gender"/>
        <sh:description xml:lang="cs">Pohlaví osoby.Poskytnutá hodnota by měla být převzata z řízeného slovníku (e.g. http://publications.europa.eu/resource/authority/human-sex). Poskytovatelé údajů mohou použít svůj vlastní řízený seznam (své vlastní řízené seznamy).</sh:description>
        <sh:name xml:lang="lv">Dzimums</sh:name>
        <sh:name xml:lang="hu">Nem</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="fi">Sukupuoli</sh:name>
        <sh:name xml:lang="mk">Пол</sh:name>
        <sh:name xml:lang="bg">Пол</sh:name>
        <sh:name xml:lang="en">gender</sh:name>
        <sh:description xml:lang="en">The gender of a human being. If provided, the value should come from a controlled vocabulary (e.g. http://publications.europa.eu/resource/authority/human-sex). Data providers can use their own cotrolled list(s).</sh:description>
        <sh:description xml:lang="mk">Полот на човечкото суштество. Ако е дадена, вредноста треба да биде од контролиран вокабулар (e.g. http://publications.europa.eu/resource/authority/human-sex). Давателите на податоци можат да користат сопствена котролирана листа(и).</sh:description>
        <sh:description xml:lang="ro">Genul unei ființe umane. Dacă este furnizată, valoarea ar trebui să provină dintr-un vocabular controlat (e.g. http://publications.europa.eu/resource/authority/human-sex). Furnizorii de date își pot utiliza propriile liste controlate.</sh:description>
        <sh:description xml:lang="de">Das Geschlecht eines Menschen. Falls angegeben, sollte der Wert aus einem kontrollierten Vokabular stammen (e.g. http://publications.europa.eu/resource/authority/human-sex). Datenanbieter können ihre eigene(n) kontrollierte(n) Liste(n) verwenden.</sh:description>
        <sh:description xml:lang="el">Το φύλο ενός ανθρώπου.Εάν παρέχεται, η τιμή θα πρέπει να προέρχεται από ελεγχόμενο λεξιλόγιο (π.χ. http://publications.europa.eu/resource/authority/human-sex). Οι πάροχοι δεδομένων μπορούν να χρησιμοποιούν τον/τους δικό/-ούς τους ελεγχόμενο/-ους κατάλογο/-λόγους.</sh:description>
        <sh:description xml:lang="pl">Płeć istoty ludzkiej. Jeżeli ją podano, wartość powinna pochodzić ze słownika kontrolowanego (np. http://publications.europa.eu/resource/authority/human-sex). Dostawcy danych mogą stosować swoje własne listy kontrolowane.</sh:description>
        <sh:name xml:lang="da">Køn</sh:name>
        <sh:description xml:lang="pt">O género de uma pessoa. Se for indicado, o valor deve provir de um vocabulário controlado (e.g. http://publications.europa.eu/resource/authority/human-sex). Os fornecedores de dados podem utilizar a(s) sua(s) própria(s) lista(s) controlada(s).</sh:description>
        <sh:description xml:lang="sl">Spol osebe. Če je vrednost navedena, bi morala izhajati iz kontroliranega besednjaka (npr. http://publications.europa.eu/resource/authority/human-sex). Ponudniki podatkov lahko uporabljajo svoje kontrolirane sezname.</sh:description>
        <sh:description xml:lang="fr">Le sexe d’un être humain. Si elle est fournie, la valeur doit provenir d’un vocabulaire contrôlé(e.g. http://publications.europa.eu/resource/authority/human-sex). Les fournisseurs de données peuvent utiliser leur(s) propre(s) liste(s) contrôlée(s).</sh:description>
        <sh:name xml:lang="lt">Lytis</sh:name>
        <sh:description xml:lang="bg">Полът на човек. Ако бъде посочена, стойността трябва да е от контролиран речник (напр. http://publications.europa.eu/resource/authority/human-sex). Доставчиците на данни могат да използват свои собствени контролирани списъци.</sh:description>
        <sh:description xml:lang="sk">Pohlavie osoby. Poskytnutá hodnota by mala byť z riadeného slovníka (napr. http://publications.europa.eu/resource/authority/human-sex). Poskytovatelia údajov môžu používať vlastný riadený zoznam/vlastné riadené zoznamy.</sh:description>
        <sh:name xml:lang="is">Kyn</sh:name>
        <sh:name xml:lang="it">Sesso</sh:name>
        <sh:description xml:lang="is">Kyn mannveru.Ef til staðar, ætti gildið að vera tekið úr stýrðum orðaforða (e.g. http://publications.europa.eu/resource/authority/human-sex). Gagnaveitendur geta notað þeirra eigin stýrðan lista.</sh:description>
        <sh:description xml:lang="it">Il genere di un essere umano. Se fornito, il valore deve essere tratto da un vocabolario controllato (ad es. http://publications.europa.eu/resource/authority/human-sex). I fornitori di dati possono utilizzare i propri elenchi controllati.</sh:description>
        <sh:description xml:lang="et">Inimese sugu. Kui väärtus on märgitud, peaks see pärinema kontrollitud sõnastikust (nt http://publications.europa.eu/resource/authority/human-sex). Andmeesitajad võivad kasutada oma kontrollitud loendit (loendeid).</sh:description>
        <sh:name xml:lang="de">Geschlecht</sh:name>
        <sh:name xml:lang="et">Sugu</sh:name>
        <sh:description xml:lang="lt">Žmogaus lytis. Jei nurodoma, vertė turėtų būti iš kontrolinio žodyno (pvz., http://publications.europa.eu/resource/authority/human-sex). Duomenų teikėjai gali naudoti savo pačių kontrolinį sąrašą (-us).</sh:description>
        <sh:name xml:lang="ro">Sex</sh:name>
        <sh:description xml:lang="ga">Inscne an duine. Má chuirtear ar fáil é, ba cheart an luach teacht ó stór focal rialaithe (e.g. http://publications.europa.eu/resource/authority/human-sex). Is féidir le soláthraithe sonraí a liosta nó a liostaí rialaithe féin a úsáid.</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="lv">Cilvēka dzimums. Var norādīt tikai vērtības, kas ņemtas no kontrolētas vārdnīcas (piem., http://publications.europa.eu/resource/authority/human-sex). Datu sniedzēji var izmantot paši savu(-us) kontroles sarakstu(-us).</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="en">The gender of the person.</sh:description>
        <sh:description xml:lang="sr">Пол особе. Ако се наводи, вредност треба да потиче из контролисаног вокабулара (e.g. http://publications.europa.eu/resource/authority/human-sex). Добављачи података могу да користе своје контролисане листе.</sh:description>
      </sh:PropertyShape>
    </sh:property>

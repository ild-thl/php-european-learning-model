      <sh:PropertyShape rdf:about="http://data.europa.eu/snb/model/application-profile/edc-generic-no-cv/LearningOpportunity-elm_hasPart">
        <sh:description xml:lang="is">Smærri árangurseiningar sem mynda saman þennan árangur.</sh:description>
        <sh:description xml:lang="lv">Sasnieguma vienības, kas kopā veido šo sasniegumu.</sh:description>

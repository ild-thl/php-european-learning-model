        >1</sh:minCount>
        <sh:description xml:lang="en">A language of the resource.</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningAchievementSpecification-elm_learningOutcomeSummary">
        <sh:name xml:lang="lt">mokymosi rezultatų santrauka</sh:name>
        <sh:description xml:lang="no">Den fullstendige læringsutbytteoppsummeringen av beskrivelsen av et sett med kunnskap og/eller ferdigheter brukt med ansvar og autonomi, som kan tilegnes.</sh:description>
        <sh:description xml:lang="sr">Пун резиме исхода учења из описа скупа знања и/или вештина за одговорну и самосталну примену који се могу стећи.</sh:description>
        <sh:description xml:lang="mt">Sommarju tal-eżitu tat-tagħlim sħiħ tad-deskrizzjoni ta’ sett ta’ għarfien u/jew ħiliet użati b’responsabbiltà u awtonomija, li jistgħu jinkisbu.</sh:description>
        <sh:name xml:lang="is">samantekt á námsárangri</sh:name>
        <sh:name xml:lang="nl">samenvatting leerresultaat</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:name xml:lang="et">õpiväljundite kokkuvõte</sh:name>
        <sh:description xml:lang="en">The full learning outcome summary of the description of a set of knowledge and/or skills used with responsibility and autonomy, which may be acquired.</sh:description>
        <sh:description xml:lang="is">Heildaryfirlit hæfniviðmiða út frá lýsingu á safni þekkingar og/eða færni sem notað er af ábyrgð og með sjálfstæðum hætti og sem hægt er að öðlast.</sh:description>
        <sh:name xml:lang="pt">resumo dos resultados da aprendizagem</sh:name>
        <sh:description xml:lang="sk">Úplné zhrnutie vzdelávacích výstupov v súvislosti s opisom súboru vedomostí a/alebo zručností používaných zodpovedne a samostatne, ktoré možno nadobudnúť.</sh:description>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Note"/>
        <sh:description xml:lang="lt">Atsakingai ir savarankiškai naudojamų žinių ir (arba) įgūdžių, kurie gali būti įgyti, aprašo visų mokymosi rezultatų santrauka.</sh:description>
        <sh:description xml:lang="mk">Комплетно резиме на резултатот од учење на описот на збир на знаења и/или вештини употребени со одговорност и автономија, коишто можат да се стекнат.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:description xml:lang="el">Η πλήρης περίληψη του μαθησιακού αποτελέσματος της περιγραφής ενός συνόλου γνώσεων και/ή δεξιοτήτων που χρησιμοποιούνται με υπευθυνότητα και αυτονομία, οι οποίες μπορούν να αποκτηθούν.</sh:description>
        <sh:name xml:lang="da">resumé af læringsresultater</sh:name>
        <sh:name xml:lang="de">Zusammenfassung der Lernergebnisse</sh:name>
        <sh:description xml:lang="da">Komplet resumé af læringsresultater vedrørende den beskrivelse af et af sæt kundskaber og/eller færdigheder, der anvendes med ansvar og selvstændighed, og som kan erhverves.</sh:description>
        <sh:name xml:lang="lv">mācību rezultātu kopsavilkums</sh:name>
        <sh:description xml:lang="es">El resumen completo de los resultados del aprendizaje de la descripción de un conjunto de conocimientos o competencias utilizados con responsabilidad y autonomía, que pueden adquirirse.</sh:description>
        <sh:description xml:lang="sl">Celoten povzetek učnega izida iz opisa nabora znanja in/ali spretnosti, ki se uporabljajo odgovorno in samostojno ter se lahko pridobijo.</sh:description>
        <sh:name xml:lang="bg">резюме на учебния резултат</sh:name>
        <sh:name xml:lang="es">resumen de los resultados del aprendizaje</sh:name>
        <sh:name xml:lang="hr">sažetak ishoda učenja</sh:name>
        <sh:name xml:lang="no">oppsummering læringsutbytte</sh:name>
        <sh:name xml:lang="en">learning outcome summary</sh:name>
        <sh:name xml:lang="mt">sommarju tal-eżitu tal-apprendiment</sh:name>
        <sh:description xml:lang="bg">Пълното резюме на учебния резултат, свързан с описанието на набор от знания и/или умения, използвани отговорно и самостоятелно, които могат да бъдат придобити.</sh:description>
        <sh:description xml:lang="hu">Azon elsajátítható ismeretek és/vagy készségek ismertetésének összefoglalója (a tanulási eredmények részletezésével), amelyeket az egyén önállóan és felelősségteljesen tud használni.</sh:description>
        <sh:description xml:lang="en">The full learning outcome summary of the learning specification.</sh:description>
        <sh:name xml:lang="cs">shrnutí výsledků učení</sh:name>
        <sh:description xml:lang="tr">Edinilebilecek olan otonomi ve sorumluluk ile kullanılan bir dizi bilgi ve/veya kabiliyetin tanımının tam öğrenme sonucu özeti.</sh:description>
        <sh:name xml:lang="sk">zhrnutie vzdelávacích výstupov</sh:name>
        <sh:name xml:lang="ga">achoimre ar na torthaí foghlama</sh:name>
        <sh:name xml:lang="hu">a tanulási eredmények összefoglalása</sh:name>
        <sh:description xml:lang="fr">Le résumé complet du résultat d’apprentissage de la description d’un ensemble de connaissances et/ou de compétences utilisées avec des responsabilités et une certaine autonomie, qui peuvent être acquises.</sh:description>
        <sh:description xml:lang="hr">Cjelovit sažetak ishoda učenja za opis skupa znanja i/ili vještina koje se upotrebljavaju odgovorno i autonomno te koje se mogu steći.</sh:description>
        <sh:description xml:lang="nl">De volledige samenvatting van het leerresultaat van de beschrijving van kennis en/of vaardigheden die op verantwoordelijke en zelfstandige wijze worden gebruikt, die kunnen worden verworven.</sh:description>
        <sh:description xml:lang="ga">Achoimre iomlán ar thorthaí foghlama na tuairisce ar thacar eolais agus/nó scileanna a úsáidtear le freagracht agus neamhspleáchas, a d’fhéadfaí a fháil.</sh:description>
        <sh:name xml:lang="me">rezime ishoda učenja</sh:name>
        <sh:name xml:lang="ro">rezumatul rezultatelor învățării</sh:name>
        <sh:name xml:lang="sl">povzetek učnih izidov</sh:name>
        <sh:description xml:lang="it">Sintesi completa relativa ai risultati dell'apprendimento della descrizione di una serie di conoscenze e/o abilità che possono essere acquisite, utilizzate con responsabilità e autonomia.</sh:description>
        <sh:description xml:lang="pl">Pełne streszczenie efektu uczenia się w przypadku opisu możliwego do zdobycia zestawu wiedzy lub umiejętności wykorzystywanych z odpowiedzialnością i autonomią.</sh:description>
        <sh:name xml:lang="it">sintesi dei risultati dell'apprendimento</sh:name>
        <sh:description xml:lang="cs">Úplný souhrn výsledků učení popisu souboru znalostí a/nebo dovedností používaných zodpovědně a samostatně, které lze získat.</sh:description>
        <sh:description xml:lang="fi">Täysimittainen yhteenveto hankittavissa olevien vastuullisesti ja itsenäisesti käytettävien tietojen ja/tai taitojen kuvauksesta.</sh:description>
        <sh:name xml:lang="pl">streszczenie efektu uczenia się</sh:name>
        <sh:name xml:lang="mk">резиме на исходот од учењето</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/learningOutcomeSummary"/>
        <sh:name xml:lang="sr">резиме исхода учења</sh:name>
        <sh:description xml:lang="et">Omandatavate vastutustundlikult ja iseseisvalt kasutatavate teadmiste ja/või oskuste kogumi kirjelduse täielik õpitulemuse kokkuvõte.</sh:description>
        <sh:description xml:lang="sv">En fullständig sammanfattning av läranderesultatet i beskrivningen av en uppsättning kunskaper och/eller färdigheter som en person kan skaffa sig och som används med ansvar och självständighet.</sh:description>
        <sh:name xml:lang="sv">sammanfattning av läranderesultat</sh:name>
        <sh:name xml:lang="el">περίληψη μαθησιακών αποτελεσμάτων</sh:name>
        <sh:description xml:lang="me">Potpuni rezime ishoda učenja opisa skupa znanja i/ili vještina koje se koriste s odgovornošću i autonomijom, a koje se mogu steći.</sh:description>
        <sh:description xml:lang="ro">Rezumatul complet al rezultatelor învățării din descrierea unui set de cunoștințe și/sau competențe utilizate cu responsabilitate și autonomie, care pot fi dobândite.</sh:description>
        <sh:name xml:lang="tr">öğrenme sonucu özeti</sh:name>
        <sh:description xml:lang="de">Eine vollständige Lernergebnis-Zusammenfassung der Beschreibung einer Reihe von Kenntnissen und/oder Fähigkeiten, die mit Verantwortung und Autonomie genutzt werden und erworben werden können.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="lv">Atbildīgi un autonomi izmantojamo zināšanu un/vai prasmju kopuma apraksta pilnīgais mācību rezultātu kopsavilkums.</sh:description>
        <sh:name xml:lang="fr">résumé du résultat d’apprentissage</sh:name>
        <sh:description xml:lang="pt">Um resumo completo dos resultados da aprendizagem da descrição de um conjunto de conhecimentos e/ou competências utilizados com responsabilidade e autonomia, que podem ser adquiridos.</sh:description>
        <sh:name xml:lang="fi">tiivistelmä oppimistuloksista</sh:name>
      </rdf:Description>
    </sh:property>
    <rdfs:comment xml:lang="es">Descripción de un conjunto de conocimientos o competencias utilizados con responsabilidad y autonomía, que pueden adquirirse.</rdfs:comment>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningAchievementSpecification-elm_learningSetting">
        <sh:name xml:lang="en">learning setting</sh:name>
        <sh:name xml:lang="ga">Suíomh na Foghlama</sh:name>
        <sh:description xml:lang="lv">Mācību vides veids (formāla, neformāla). Var norādīt tikai vērtības, kas ņemtas no mācību vides veidu saraksta (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="pt">O tipo de contexto de aprendizagem (formal, não formal). Se for indicado, o valor deve provir da lista de códigos de contextos de aprendizagem (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="tr">Öğrenme ortamının türü (örgün, yaygın). Verilmişse, değer öğrenme ortamı türlerinin listesinden gelmelidir (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="hr">Vrsta okruženja za učenje (formalno, neformalno). Ako je navedena, vrijednost mora biti s popisa vrsta obrazovnih okruženja (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="sk">Vzdelávacie prostredie</sh:name>
        <sh:name xml:lang="mt">Ambjent ta’ Tagħlim</sh:name>
        <sh:name xml:lang="no">Læringsmiljø</sh:name>
        <sh:name xml:lang="da">Læringsmiljø</sh:name>
        <sh:name xml:lang="sv">Lärandemiljö</sh:name>
        <sh:name xml:lang="es">Entorno de aprendizaje</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/learningSetting"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="el">Ο τύπος του περιβάλλοντος μάθησης (τυπικό, μη τυπικό). Εάν παρέχεται, η τιμή πρέπει να προέρχεται από τον κατάλογο «Τύποι περιβάλλοντος μάθησης» (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="mk">Тип на опкружувањето за учење (формално, неформално). Ако е дадена, вредноста мора да биде од листата на типовите на опкружувања за учење (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="en">The type of learning setting (formal, non-formal).</sh:description>
        <sh:description xml:lang="et">Õpikeskkonna liik (ametlik, mitteametlik). Kui väärtus on märgitud, peab see pärinema õpikeskkonna liikide loetelust (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="ro">Tipul de cadru de învățare (formal, non-formal). Dacă este furnizată, valoarea trebuie să provină din lista tipurilor de cadre de învățare (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="pt">Contexto de aprendizagem</sh:name>
        <sh:name xml:lang="et">Õpikeskkond</sh:name>
        <sh:name xml:lang="sl">Učno okolje</sh:name>
        <sh:name xml:lang="hu">Tanulási környezet</sh:name>
        <sh:description xml:lang="bg">Видът на учебната среда (формална, неформална). Ако бъде посочена, стойността трябва да е от списъка с видове учебна среда (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="lt">Mokymosi pobūdžio tipas (formalusis, neformalusis) Jei nurodoma, vertė turi būti iš mokymosi pobūdžio tipų sąrašo (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="da">Type læringsramme (formel, ikke-formel). Hvis oplyst, skal værdien tages fra listen Learning setting types (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="tr">Öğrenim Ortamı</sh:name>
        <sh:description xml:lang="sr">Тип околности учења (формално или неформално). Ако се наводи, вредност мора да потиче са списка Околности учења (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="pl">Rodzaj trybu nauki (formalny, pozaformalny). Jeżeli ją podano, wartość ta musi pochodzić z wykazu rodzajów trybu nauki (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="mk">Поставување на учење</sh:name>
        <sh:name xml:lang="cs">Prostředí, kde učení probíhá</sh:name>
        <sh:description xml:lang="no">Typen læringsmiljø (formelt, uformelt). Hvis oppgitt, må verdien komme fra listen over læringssettingstyper (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="hu">A tanulási környezet típusa (formális, nem formális). Az értéknek (ha meg van adva) a tanulási környezet típusának a listájáról kell származnia (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="es">El tipo de entorno de aprendizaje (formal, no formal). Si se facilita, el valor debe proceder de la lista de tipos de Entornos de aprendizaje (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="hr">Obrazovno okruženje</sh:name>
        <sh:description xml:lang="is">Tegund námsumhverfis (formlegt, ekki formlegt). Ef til staðar, verður gildið að koma úr lista Námsumhverfistegunda (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="nl">Het soort leeromgeving (formeel, niet-formeel). Indien verstrekt, moet de waarde afkomstig zijn uit de lijst van soorten leeromgevingen (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="lv">Mācību vide</sh:name>
        <sh:description xml:lang="sv">Typ av lärandemiljö (formell, informell). I förekommande fall måste värdet komma från listan över lärandemiljöer (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="it">Il tipo di contesto di apprendimento (formale, non formale). Se fornito, il valore deve essere tratto dall'elenco dei tipi di contesto di apprendimento (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:name xml:lang="ro">Cadrul de învățare</sh:name>
        <sh:description xml:lang="fi">Oppimisympäristön tyyppi (virallinen, epävirallinen) Jos arvo määritellään, sen on oltava Oppimisympäristötyypit (Learning setting types) -luettelon (http://publications.europa.eu/resource/dataset/international-education-classification) mukainen.</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="me">Okruženje za učenje</sh:name>
        <sh:name xml:lang="el">Περιβάλλον μάθησης</sh:name>
        <sh:description xml:lang="mt">It-tip ta’ ambjent ta’ tagħlim (formali, mhux formali). Jekk jiġi pprovdut, il-valur għandu jiġi mit-tipi ta’ ssettjar tat-Tagħlim (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="is">Námsumhverfi</sh:name>
        <sh:name xml:lang="bg">Среда, в която се провежда обучението</sh:name>
        <sh:description xml:lang="cs">Typ prostředí, kde učení probíhá (formální, neformální). Poskytnutá hodnota musí být převzata ze seznamu Prostředí, kde učení probíhá (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="it">Contesto di apprendimento</sh:name>
        <sh:name xml:lang="fi">Oppimistilanne</sh:name>
        <sh:description xml:lang="en">The type of learning setting (formal, non-formal). If provided, the value must come from the list of Learning setting types (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="fr">Cadre d’apprentissage</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:description xml:lang="fr">Le type de cadre d’apprentissage (formel ou non formel). Si elle est fournie, la valeur doit provenir de la liste des Types de cadre d’apprentissage (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="pl">Tryb nauki</sh:name>
        <sh:name xml:lang="de">Lernumgebung</sh:name>
        <sh:description xml:lang="sk">Druh vzdelávacieho prostredia (formálne, neformálne). Poskytnutá hodnota musí byť zo zoznamu druhov vzdelávacieho prostredia (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="nl">Leeromgeving</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="de">Art der Lernumgebung (formal, nichtformal). Falls angegeben, muss der Wert aus der Liste der Lernumgebungsarten stammen (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="me">Tip okruženja za učenje (formalno, neformalno). Ako je navedena, vrijednost mora da potiče sa liste tipova okruženja za učenje (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="sl">Vrsta učnih okolij (formalno, neformalno). Navedena vrednost mora izhajati s seznama vrst učnih okolij (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:description xml:lang="ga">Cineál an tsuímh foghlama (foirmiúil, neamhfhoirmiúil). Má chuirtear ar fáil é, ní mór an luach teacht ón liosta Cineálacha suímh foghlama (http://publications.europa.eu/resource/dataset/learning-setting).</sh:description>
        <sh:name xml:lang="lt">Mokymosi pobūdis</sh:name>
      </rdf:Description>
    </sh:property>
    <rdfs:label xml:lang="lv">mācību sasnieguma specifikācija</rdfs:label>
    <rdfs:comment xml:lang="bg">Описание на набор от знания и/или умения, използвани отговорно и самостоятелно, които могат да бъдат придобити.</rdfs:comment>
    <rdfs:label xml:lang="tr">öğrenme başarısının özelliği</rdfs:label>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningAchievementSpecification-elm_entryRequirement">
        <sh:description xml:lang="el">Ειδική απαίτηση ή προαπαιτούμενο εισόδου για άτομα για τα οποία η συγκεκριμένη προδιαγραφή μαθησιακού επιτεύγματος έχει σχεδιαστεί για την έναρξη της συγκεκριμένης ευκαιρίας μάθησης.</sh:description>
        <sh:name xml:lang="hr">uvjet za upis</sh:name>
        <sh:name xml:lang="bg">изискване за прием</sh:name>
        <sh:name xml:lang="mt">rekwiżit tad-dħul</sh:name>
        <sh:name xml:lang="no">inngangskrav</sh:name>

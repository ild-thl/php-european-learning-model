        <sh:description xml:lang="et">Õpitulemuse kirjelduse individuaalne (oodatav) õpiväljund.</sh:description>
        <sh:description xml:lang="fi">Yksittäinen (vaadittu) osaamiseritelmän oppimistulos.</sh:description>
        <sh:description xml:lang="ga">Toradh foghlama aonair (a bhfuiltear ag súil leis) ar an tsonraíocht foghlama.</sh:description>
        <sh:name xml:lang="sk">Vzdelávací výstup</sh:name>

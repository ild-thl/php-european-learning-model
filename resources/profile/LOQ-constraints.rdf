    <rdfs:comment xml:lang="tr">Bir dijital dosya.</rdfs:comment>
    <rdfs:comment xml:lang="fi">Digitaalinen tiedosto.</rdfs:comment>
    <rdfs:label xml:lang="sk">Objekt médií</rdfs:label>

        <sh:description xml:lang="tr">Tekrar ödeme gerektirmeyen mali veya ayni olarak verilen ödenek için halka açık URL.</sh:description>
        <sh:description xml:lang="lv">Publiskās piekļuves URL subsīdijai, kas piešķirta naudā vai natūrā un kas nav jāatmaksā.</sh:description>
        <sh:description xml:lang="is">Opin slóð fyrir styrk, hvort sem hann er fjárhagslegur eða í öðru formi, sem ekki þarf að endurgreiða.</sh:description>
        <sh:description xml:lang="el">Η δημόσια διεύθυνση URL για την επιδότηση, που χορηγείται σε χρήμα ή σε είδος, για την οποία δεν απαιτείται επιστροφή.</sh:description>
        <sh:name xml:lang="de">URL</sh:name>
        <sh:name xml:lang="pt">URL do conteúdo</sh:name>
        <sh:name xml:lang="sv">innehållets webbadress</sh:name>
        <sh:name xml:lang="cs">URL s příspěvkem</sh:name>
        <sh:name xml:lang="en">contentURL</sh:name>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="tr">içerik URL</sh:name>
      </rdf:Description>
    </sh:property>

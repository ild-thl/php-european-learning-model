    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningActivitySpecification-elm_specialisationOf">
        <sh:name xml:lang="is">sérhæfing á</sh:name>
        <sh:name xml:lang="ro">specializare</sh:name>

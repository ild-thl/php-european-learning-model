        <sh:name xml:lang="hr">je dio</sh:name>
        <sh:description xml:lang="is">Námsárangur, sem þessi námsárangursþáttur er hluti af.</sh:description>
        <sh:description xml:lang="sv">Ett läranderesultat som detta läranderesultat är en del av.</sh:description>
        <sh:name xml:lang="da">som led i</sh:name>
        <sh:description xml:lang="ro">O realizare a învățării din care face parte această realizare a învățării.</sh:description>

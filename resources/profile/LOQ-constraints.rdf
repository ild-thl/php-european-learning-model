        <sh:description xml:lang="hu">A tanulási specifikáció egyéni (várható) tanulási eredménye.</sh:description>
        <sh:description xml:lang="bg">Отделен (очакван) учебен резултат от спецификацията за обучение.</sh:description>
        <sh:name xml:lang="lv">Mācību rezultāti</sh:name>
        <sh:description xml:lang="cs">Individuální (očekávaný) výsledek učení v rámci specifikace vzdělávání.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>

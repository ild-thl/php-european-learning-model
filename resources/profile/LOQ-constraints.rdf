  <owl:Ontology rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints">
    <owl:versionIri rdf:resource="http://data.europa.eu/snb/model/version/1.2.0/application-profile/loq-constraints"/>
    <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <owl:versionInfo>1.2.0</owl:versionInfo>
    <rdfs:comment xml:lang="en">This document specifies the set of classes and properties used in the LOMS application profile,
  and the constraints on occurrences and values used.</rdfs:comment>
    <owl:imports rdf:resource="http://purl.org/dc/terms/"/>
    <dc:publisher rdf:resource="http://publications.europa.eu/resource/authority/corporate-body/DEMP"/>
    <owl:imports rdf:resource="http://data.europa.eu/snb/model/version/3.3.0/ontology"/>

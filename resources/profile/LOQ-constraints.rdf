        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/learningOutcome"/>
        <sh:description xml:lang="de">Ein individuelles (erwartetes) Lernergebnis der Lernspezifikation.</sh:description>
        <sh:name xml:lang="no">Læringsutbytte</sh:name>
        <sh:description xml:lang="ro">Un rezultat individual (preconizat) al învățării din specificația de învățare.</sh:description>
        <sh:name xml:lang="nl">Leerresultaten</sh:name>
        <sh:name xml:lang="hu">Tanulási kimenet</sh:name>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LearningOutcome"/>
        <sh:description xml:lang="pl">(Oczekiwane) efekty uczenia się, jakie dana specyfikacja nauki przyniesie osobie uczącej się.</sh:description>
        <sh:name xml:lang="lt">Mokymosi rezultatai</sh:name>
        <sh:description xml:lang="tr">Öğrenme şartnamesinin bireysel (beklenen) öğrenme sonucu.</sh:description>
        <sh:name xml:lang="de">Lernergebnis</sh:name>
        <sh:description xml:lang="no">Et individuelt (forventet) læringsutbytte av læringsspesifikasjonen.</sh:description>
        <sh:name xml:lang="sv">Läranderesultat</sh:name>
        <sh:name xml:lang="pl">Efekt uczenia się</sh:name>
        <sh:name xml:lang="mt">Eżitu tat-Tagħlim</sh:name>
        <sh:name xml:lang="is">Hæfniviðmið</sh:name>
        <sh:description xml:lang="fr">Un résultat d’apprentissage (attendu) individuel de la spécification d’apprentissage.</sh:description>
        <sh:description xml:lang="me">Individualni (očekivani) ishod učenja specifikacije učenja.</sh:description>
        <sh:name xml:lang="et">Õpiväljund</sh:name>
        <sh:description xml:lang="el">Ατομικό (αναμενόμενο) μαθησιακό αποτέλεσμα της προδιαγραφής μάθησης.</sh:description>
        <sh:description xml:lang="da">Et individuelt (forventet) læringsresultat af læringsspecifikationen.</sh:description>
        <sh:description xml:lang="lv">Mācību specifikācijas individuālais (paredzamais) mācību rezultāts.</sh:description>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:name xml:lang="fi">Oppimistulokset</sh:name>
        <sh:description xml:lang="es">Un resultado del aprendizaje individual (esperado) de la especificación del aprendizaje.</sh:description>
        <sh:name xml:lang="tr">Öğrenim Sonucu</sh:name>
        <sh:name xml:lang="it">Risultato dell'apprendimento</sh:name>
        <sh:description xml:lang="sr">Појединачни (предвиђени) исход учења из спецификације учења.</sh:description>
        <sh:description xml:lang="is">Hæfniviðmið einstaklings (sem krafist er) í námsskilmála.</sh:description>
        <sh:description xml:lang="it">Singolo risultato dell'apprendimento (atteso) della specifica di apprendimento.</sh:description>
        <sh:name xml:lang="es">Resultado del aprendizaje</sh:name>
        <sh:name xml:lang="ro">Rezultatul învățării</sh:name>
        <sh:name xml:lang="fr">Résultat d’apprentissage</sh:name>
        <sh:name xml:lang="bg">Резултат от обучението</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="mt">Eżitu ta’ tagħlim individwali (mistenni) tal-ispeċifikazzjoni tat-tagħlim.</sh:description>
        <sh:description xml:lang="sl">Posamezni (pričakovani) učni izid učne specifikacije.</sh:description>
        <sh:description xml:lang="pt">Um resultado da aprendizagem individual (esperado) da especificação de aprendizagem.</sh:description>
        <sh:name xml:lang="cs">Výsledky učení</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:name xml:lang="ga">Toradh Foghlama</sh:name>

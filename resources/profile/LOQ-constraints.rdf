        <sh:name xml:lang="pt">generalização de</sh:name>
        <sh:description xml:lang="fi">Oppimissaavutuksen eritelmä (esim. standardi), josta tämä eritelmä on yleistys.</sh:description>
        <sh:name xml:lang="sl">generalizacija</sh:name>
        <sh:name xml:lang="me">generalizacija</sh:name>
        <sh:name xml:lang="hr">generalizacija</sh:name>
        <sh:name xml:lang="fr">généralisation de</sh:name>
        <sh:description xml:lang="is">Námsárangursskilmáli (t.d. staðall) þar sem þessi skilmáli er almennur.</sh:description>
        <sh:description xml:lang="et">Õpitulemuste kirjeldus (nt standard), mille üldistus see kirjeldus on.</sh:description>
        <sh:name xml:lang="ro">generalizare pentru</sh:name>
        <sh:description xml:lang="lt">Mokymosi pasiekimų specifikacija (pvz., standartas), kurios platesnė specifikacija yra ši specifikacija.</sh:description>
        <sh:description xml:lang="en">An entitlement specification (e.g., a standard) of which this specification is a generalisation. This is an association between specifications of the same type of learning achievements specifications.</sh:description>
        <sh:name xml:lang="tr">genelleştirme</sh:name>
        <sh:name xml:lang="cs">zobecnění</sh:name>
        <sh:name xml:lang="es">generalización de</sh:name>
        <sh:description xml:lang="da">En specifikation for læringsresultater (f.eks. en standard), som denne specifikation er en generalisering af.</sh:description>
        <sh:name xml:lang="lt">apibendrinimas</sh:name>
        <sh:description xml:lang="ga">Sonraíocht gnóthachtála foghlama (e.g. caighdeán) ar ginearálú de an tsonraíocht seo.</sh:description>
        <sh:description xml:lang="mk">Спецификација за постигање во учење (на пример, стандардна) од којашто оваа спецификација е генерализација.</sh:description>
        <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Qualification"/>
        <sh:name xml:lang="nl">generalisatie van</sh:name>
        <sh:name xml:lang="sr">генерализација дела</sh:name>
        <sh:description xml:lang="me">Specifikacija dostignuća u učenju (npr. standard) čija je ova specifikacija generalizacija.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="sv">En specifikation för läranderesultat (t.ex. en standard) som denna specifikation är en generalisering av.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/generalisationOf"/>
        <sh:name xml:lang="hu">ennek a fölérendelt kategóriája:</sh:name>
        <sh:name xml:lang="mt">ġeneralizzazzjoni ta’</sh:name>
        <sh:name xml:lang="lv">vispārinājums šim:</sh:name>
        <sh:description xml:lang="bg">Спецификация за учебно постижение (напр. стандарт), на която тази спецификация е генерализация.</sh:description>
        <sh:description xml:lang="tr">Bu şartnamenin bir genellemesi olduğu bir öğrenme başarısı şartnamesi (örneğin, bir standart).</sh:description>
        <sh:description xml:lang="mt">Speċifikazzjoni tal-kisba tat-tagħlim (eż., standard) li din l-ispeċifikazzjoni hija ġeneralizzazzjoni tagħha.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="cs">Specifikace studijních výsledků (např. standard), jejíž je tato specifikace zobecněním.</sh:description>
        <sh:name xml:lang="et">üldistus</sh:name>
        <sh:description xml:lang="hu">Tanulási eredmények specifikációja (pl. szabvány), amelynek ez a specifikáció a fölérendelt kategóriája.</sh:description>
        <sh:name xml:lang="de">Verallgemeinerung von</sh:name>
        <sh:name xml:lang="pl">uogólnienie</sh:name>
        <sh:description xml:lang="sl">Specifikacija učnega dosežka (npr. standard), katere posplošitev je ta specifikacija.</sh:description>
        <sh:description xml:lang="sk">Špecifikácia vzdelávacieho výstupu (napr. norma), ktorej zovšeobecnením je táto špecifikácia.</sh:description>
        <sh:description xml:lang="ro">O specificație a rezultatelor învățării (de exemplu, un standard) pentru care această specificație reprezintă o generalizare.</sh:description>
        <sh:name xml:lang="sk">zovšeobecnenie</sh:name>
      </rdf:Description>

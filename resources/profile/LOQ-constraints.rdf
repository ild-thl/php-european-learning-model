        <sh:name xml:lang="pl">Uprawnia do</sh:name>
        <sh:description xml:lang="hu">Azok a jogosultságok, amelyeket a tulajdonos az eredménynek köszönhetően kapott.</sh:description>
        <sh:name xml:lang="tr">Kazandırdığı Hak</sh:name>
        <sh:name xml:lang="en">entitles to</sh:name>
        <sh:description xml:lang="nl">Rechten die de houder heeft verworden door deze prestatie.</sh:description>
        <sh:name xml:lang="it">Dà diritto a</sh:name>

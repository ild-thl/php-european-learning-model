        <sh:name xml:lang="hr">specijalizacija</sh:name>
        <sh:name xml:lang="mt">speċjalizzazzjoni ta’</sh:name>
        <sh:description xml:lang="cs">Specifikace studijních výsledků (např. standard), jejíž je tato specifikace specializací.</sh:description>
        <sh:description xml:lang="es">Una especificación del logro del aprendizaje (por ejemplo, una norma), de la que esta especificación es una especialización.</sh:description>

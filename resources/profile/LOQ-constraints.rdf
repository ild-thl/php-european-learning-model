    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningAchievementSpecification-elm_category">
        <sh:datatype rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <sh:name xml:lang="fi">kategoria</sh:name>
        <sh:name xml:lang="pl">kategoria</sh:name>
        <sh:description xml:lang="lv">Kategorija kā rakstzīmju virkne, kas apraksta iegūstamo atbildīgi un autonomi izmantojamo zināšanu un/vai prasmju kopumu.</sh:description>
        <sh:name xml:lang="ga">catagóir</sh:name>
        <sh:name xml:lang="en">category</sh:name>
        <sh:description xml:lang="sl">Kategorija niza opisa nabora znanja in/ali spretnosti, ki se uporabljajo odgovorno in samostojno ter se lahko pridobijo.</sh:description>
        <sh:description xml:lang="ga">An chatagóir mar theaghrán den tuairisc ar thacar eolais agus/nó scileanna a úsáidtear le freagracht agus neamhspleáchas, a d’fhéadfaí a fháil.</sh:description>
        <sh:name xml:lang="fr">catégorie</sh:name>
        <sh:description xml:lang="sv">Kategorin som en beskrivningssträng av en uppsättning kunskaper och/eller färdigheter som en person kan skaffa sig och som används med ansvar och självständighet.</sh:description>
        <sh:description xml:lang="lt">Atsakingai ir savarankiškai naudojamų žinių ir (arba) įgūdžių, kurie gali būti įgyti, aprašo kategorija kaip eilutė.</sh:description>
        <sh:description xml:lang="hu">Azon elsajátítható ismeretek és/vagy készségek ismertetésének kódkategóriája, amelyeket az egyén önállóan és felelősségteljesen tud használni.</sh:description>
        <sh:name xml:lang="bg">категория</sh:name>
        <sh:description xml:lang="no">Kategorien som en streng av beskrivelsen av et sett med kunnskap og/eller ferdigheter brukt med ansvar og autonomi, som kan tilegnes.</sh:description>
        <sh:description xml:lang="hr">Kategorija kao niz opisa skupa znanja i/ili vještina koje se upotrebljavaju odgovorno i autonomno te koje se mogu steći.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="cs">Kategorie řetězce popisu souboru znalostí a/nebo dovedností používaných zodpovědně a samostatně, které lze získat.</sh:description>
        <sh:description xml:lang="pl">Wyrażona jako ciąg znaków kategoria opisu możliwego do zdobycia zestawu wiedzy lub umiejętności wykorzystywanych z odpowiedzialnością i autonomią.</sh:description>
        <sh:description xml:lang="mk">Категоријата како низа во описот на збирот на знаења и/или вештини кои се употребени со одговорност и автономија, а кои можат да се стекнат.</sh:description>
        <sh:name xml:lang="cs">kategorie</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="el">Η κατηγορία ως συμβολοσειρά της περιγραφής ενός συνόλου γνώσεων και/ή δεξιοτήτων που χρησιμοποιούνται με υπευθυνότητα και αυτονομία, οι οποίες μπορούν να αποκτηθούν.</sh:description>
        <sh:name xml:lang="it">categoria</sh:name>
        <sh:description xml:lang="ro">Categoria, sub formă de șir de descriere a unui set de cunoștințe și/sau competențe utilizate cu responsabilitate și autonomie, care pot fi dobândite.</sh:description>
        <sh:name xml:lang="ro">categoria</sh:name>
        <sh:name xml:lang="pt">categoria</sh:name>
        <sh:description xml:lang="pt">A categoria como uma sequência da descrição de um conjunto de conhecimentos e/ou competências utilizados com responsabilidade e autonomia, que podem ser adquiridos.</sh:description>
        <sh:name xml:lang="de">Kategorie</sh:name>
        <sh:description xml:lang="bg">Категорията (под формата на низ) на описанието на набор от знания и/или умения, използвани отговорно и самостоятелно, които могат да бъдат придобити.</sh:description>
        <sh:description xml:lang="et">Kategooria kui omandatavate vastutustundlikult ja iseseisvalt kasutatavate teadmiste ja/või oskuste kogumi kirjelduse string.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/category"/>
        <sh:description xml:lang="sr">Категорија у облику ниске описа скупа знања и/или вештина за одговорну и самосталну примену који се могу стећи.</sh:description>
        <sh:name xml:lang="hr">kategorija</sh:name>
        <sh:name xml:lang="lt">kategorija</sh:name>
        <sh:name xml:lang="lv">kategorija</sh:name>
        <sh:name xml:lang="me">kategorija</sh:name>
        <sh:name xml:lang="mt">kategorija</sh:name>
        <sh:name xml:lang="sl">kategorija</sh:name>
        <sh:description xml:lang="en">A category to which this specification belongs. This property can be used instead of dc:type, if the category cannot provided via a controlled vocabulary.</sh:description>
        <sh:description xml:lang="mt">Il-kategorija bħala sekwenza tad-deskrizzjoni ta’ sett ta’ għarfien u/jew ħiliet użati b’responsabbiltà u awtonomija, li jistgħu jinkisbu.</sh:description>
        <sh:name xml:lang="tr">kategori</sh:name>
        <sh:name xml:lang="sv">kategori</sh:name>
        <sh:description xml:lang="fi">Kategoria merkkijonona, joka on osa kuvausta hankittavissa olevista vastuullisesti ja itsenäisesti käytettävistä tiedoista ja/tai taidoista.</sh:description>
        <sh:description xml:lang="me">Kategorija kao niz opisa skupa znanja i/ili vještina koji se koriste sa odgovornošću i autonomijom, a koja se mogu steći.</sh:description>
        <sh:name xml:lang="no">kategori</sh:name>
        <sh:description xml:lang="en">The category as a string of the description of a set of knowledge and/or skills used with responsibility and autonomy, which may be acquired.</sh:description>
        <sh:name xml:lang="da">kategori</sh:name>
        <sh:description xml:lang="is">Flokkur sem strengur, á lýsingu á safni þekkingar og/eða færni sem notað er af ábyrgð og með sjálfstæðum hætti og sem hægt er að öðlast.</sh:description>
        <sh:name xml:lang="mk">категорија</sh:name>
        <sh:name xml:lang="sr">категорија</sh:name>
        <sh:description xml:lang="sk">Kategória ako reťazec opisu súboru vedomostí a/alebo zručností používaných zodpovedne a samostatne, ktoré možno nadobudnúť.</sh:description>
        <sh:description xml:lang="da">Kategorien som en streng af beskrivelsen af et sæt af kundskaber og/eller færdigheder, der anvendes med ansvar og selvstændighed, og som kan erhverves.</sh:description>
        <sh:name xml:lang="et">kategooria</sh:name>
        <sh:description xml:lang="nl">De categorie als een reeks van de beschrijving van kennis en/of vaardigheden die op verantwoordelijke en zelfstandige wijze worden gebruikt, die kunnen worden verworven.</sh:description>
        <sh:description xml:lang="de">Die Kategorie als Zeichenkette der Beschreibung einer Reihe von Kenntnissen und/oder Fähigkeiten, die mit Verantwortung und Autonomie genutzt werden und erworben werden können.</sh:description>
        <sh:description xml:lang="tr">Edinilebilecek olan otonomi ve sorumluluk ile kullanılan bir dizi bilgi ve/veya kabiliyetin tanımının bir dizisi olan kategori.</sh:description>
        <sh:name xml:lang="el">κατηγορία</sh:name>
        <sh:name xml:lang="hu">kategória</sh:name>
        <sh:name xml:lang="sk">kategória</sh:name>
        <sh:name xml:lang="es">categoría</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="it">La categoria intesa come stringa della descrizione di un insieme di conoscenze e/o abilità che possono essere acquisite, utilizzate con responsabilità e autonomia.</sh:description>
        <sh:description xml:lang="fr">La catégorie en tant que chaîne de la description d’un ensemble de connaissances et/ou de compétences utilisées avec des responsabilités et une certaine autonomie, qui peuvent être acquises.</sh:description>
        <sh:name xml:lang="is">flokkur</sh:name>
        <sh:name xml:lang="nl">categorie</sh:name>
        <sh:description xml:lang="es">La categoría en forma de secuencia de la descripción de un conjunto de conocimientos o competencias utilizados con responsabilidad y autonomía, que pueden adquirirse.</sh:description>
      </rdf:Description>
    </sh:property>
    <rdfs:label xml:lang="me">specifikacija postignuća u učenju</rdfs:label>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningAchievementSpecification-dc_publisher">
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/publisher"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:or rdf:parseType="Collection">
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Agent"/>
          </rdf:Description>
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Organisation"/>
          </rdf:Description>
        </sh:or>
        <sh:name xml:lang="en">Publisher</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="en">An entity responsible for making the resource available.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
      </rdf:Description>
    </sh:property>
    <rdfs:comment xml:lang="hr">Opis skupa znanja i/ili vještina koje se upotrebljavaju odgovorno i autonomno te koje se mogu steći.</rdfs:comment>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningAchievementSpecification-elm_educationLevel">
        <sh:description xml:lang="hu">A kapcsolódó oktatási szint az oktatási szinteket leíró szemantikai keretrendszeren belül. Az értéknek (ha meg van adva) ellenőrzött szójegyzékből kell származnia. Az adatszolgáltatók használhatják a saját ellenőrzött listájukat (listáikat).</sh:description>
        <sh:name xml:lang="sr">Ниво образовања</sh:name>
        <sh:name xml:lang="pt">Nível de ensino</sh:name>
        <sh:description xml:lang="en">An associated level of education within a semantic framework describing education levels.</sh:description>
        <sh:name xml:lang="mk">Ниво на образование</sh:name>
        <sh:name xml:lang="de">Bildungsniveau</sh:name>
        <sh:description xml:lang="el">Σχετικό επίπεδο εκπαίδευσης εντός σημασιολογικού πλαισίου που περιγράφει τα επίπεδα εκπαίδευσης.Εάν παρέχεται, η τιμή θα πρέπει να προέρχεται από ελεγχόμενο λεξιλόγιο. Οι πάροχοι δεδομένων μπορούν να χρησιμοποιούν τον/τους δικό/-ούς τους ελεγχόμενο/-ους κατάλογο/-λόγους.</sh:description>
        <sh:name xml:lang="sl">Stopnja izobrazbe</sh:name>
        <sh:description xml:lang="mt">Livell assoċjat ta’ edukazzjoni fi ħdan qafas semantiku li jiddeskrivi l-livelli ta’ edukazzjoni. Jekk jiġi pprovdut, il-valur għandu jiġi minn vokabularju kkontrollat. Il-fornituri tad-data jistgħu jużaw il-lista/i kontrollata/i tagħhom stess.</sh:description>
        <sh:description xml:lang="hr">Povezana razina obrazovanja unutar semantičkog okvira u kojem se opisuju razine obrazovanja. Ako je navedena, vrijednost bi trebala biti iz kontroliranog rječnika. Pružatelji podataka mogu se služiti vlastitim popisom/popisima.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="pt">Um nível de ensino associado num quadro semântico que descreve níveis de ensino. Se for indicado, o valor deve provir de um vocabulário controlado. Os fornecedores de dados podem utilizar a(s) sua(s) própria(s) lista(s) controlada(s).</sh:description>
        <sh:description xml:lang="ga">Leibhéal gaolmhar oideachais laistigh de chreat séimeantach ina ndéantar cur síos ar leibhéil oideachais. Má chuirtear ar fáil é, ba cheart an luach teacht ó stór focal rialaithe. Is féidir le soláthraithe sonraí a liosta nó a liostaí rialaithe féin a úsáid.</sh:description>
        <sh:name xml:lang="lt">Išsilavinimas</sh:name>
        <sh:description xml:lang="cs">Související úroveň vzdělávání v rámci sémantického rámce popisujícího úrovně vzdělávání.Poskytnutá hodnota by měla být převzata z řízeného slovníku. Poskytovatelé údajů mohou použít svůj vlastní řízený seznam (své vlastní řízené seznamy).</sh:description>
        <sh:name xml:lang="nl">Onderwijsniveau</sh:name>
        <sh:description xml:lang="fr">Un niveau d’enseignement associé dans un cadre sémantique décrivant les niveaux d’éducation. Si elle est fournie, la valeur doit provenir d’un vocabulaire contrôlé. Les fournisseurs de données peuvent utiliser leur(s) propre(s) liste(s) contrôlée(s).</sh:description>
        <sh:description xml:lang="de">Ein damit verbundenes Bildungsniveau innerhalb eines semantischen Rahmens, der das Bildungsniveau beschreibt. Falls angegeben, sollte der Wert aus einem kontrollierten Vokabular stammen. Datenanbieter können ihre eigene(n) kontrollierte(n) Liste(n) verwenden.</sh:description>
        <sh:name xml:lang="tr">Eğitim seviyesi</sh:name>
        <sh:name xml:lang="cs">Úroveň dosaženého vzdělání</sh:name>
        <sh:description xml:lang="it">Un livello di istruzione associato all'interno di un quadro semantico che descrive i livelli di istruzione. Se fornito, il valore deve essere tratto da un vocabolario controllato. I fornitori di dati possono utilizzare i propri elenchi controllati.</sh:description>
        <sh:description xml:lang="ro">Un nivel de educație asociat într-un cadru semantic care descrie nivelurile de educație. Dacă este furnizată, valoarea ar trebui să provină dintr-un vocabular controlat. Furnizorii de date își pot utiliza propriile liste.</sh:description>
        <sh:name xml:lang="el">Επίπεδο εκπαίδευσης</sh:name>
        <sh:description xml:lang="nl">Een gekoppeld onderwijsniveau binnen een semantisch kader dat onderwijsniveaus beschrijft. Indien verstrekt, moet de waarde afkomstig zijn uit een gecontroleerde woordenlijst. Aanbieders van gegevens kunnen hun eigen gecontroleerde lijst(en) gebruiken.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="ga">Leibhéal oideachais</sh:name>
        <sh:description xml:lang="pl">Powiązany poziom wykształcenia w obrębie ram semantycznych opisujących poziomy wykształcenia. Jeżeli ją podano, wartość powinna pochodzić ze słownika kontrolowanego. Dostawcy danych mogą stosować swoje własne listy kontrolowane.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:name xml:lang="fi">Koulutustaso</sh:name>
        <sh:description xml:lang="et">Asjaomane haridustase haridustasemeid kirjeldavas semantilises raamistikus. Kui väärtus on märgitud, peaks see pärinema kontrollitud sõnastikust. Andmeesitajad võivad kasutada oma kontrollitud loendit (loendeid).</sh:description>
        <sh:name xml:lang="me">Nivo obrazovanja</sh:name>
        <sh:description xml:lang="is">Tengt menntunarstig innan merkingarramma sem lýsir menntunarstigum.Ef til staðar, þarf gildið að koma frá stýrðum orðaforða. Gagnaveitendur geta notað þeirra eigin stýrðan lista.</sh:description>
        <sh:description xml:lang="mk">Поврзано ниво на образование во семантична рамка во која се опишува нивото на образование. Ако е дадена, вредноста треба да биде од контролиран вокабулар. Давателите на податоци можат да користат сопствена котролирана листа(и).</sh:description>
        <sh:name xml:lang="hu">Oktatási szint</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/educationLevel"/>
        <sh:description xml:lang="sl">Povezana stopnja izobrazbe znotraj semantičnega okvira, ki opisuje stopnje izobrazbe. Če je vrednost navedena, bi morala izhajati iz kontroliranega besednjaka. Ponudniki podatkov lahko uporabljajo svoje kontrolirane sezname.</sh:description>
        <sh:name xml:lang="sv">Utbildningsnivå</sh:name>
        <sh:name xml:lang="pl">Poziom wykształcenia</sh:name>
        <sh:description xml:lang="me">Povezani nivo obrazovanja unutar semantičkog okvira koji opisuje nivoe obrazovanja. Ako je navedena, vrijednost bi trebalo da potiče iz kontrolisanog rječnika. Provajderi podataka mogu da koriste sopstvene kontrolisane liste.</sh:description>
        <sh:name xml:lang="en">education level</sh:name>
        <sh:name xml:lang="da">Uddannelsesniveau</sh:name>
        <sh:name xml:lang="sk">Stupeň vzdelania</sh:name>
        <sh:description xml:lang="sv">En associerad utbildningsnivå inom en semantisk ram som beskriver utbildningsnivåer. I förekommande fall ska värdet komma från en kontrollerad ordlista. Uppgiftslämnare kan använda en eller flera egna kontrollerade listor.</sh:description>
        <sh:description xml:lang="no">Et tilhørende utdanningsnivå innenfor et semantisk rammeverk som beskriver utdanningsnivåer.Hvis oppgitt, bør verdien komme fra et kontrollert vokabular. Dataleverandører kan bruke sin(e) egen/egne kontrollerte liste(r).</sh:description>
        <sh:name xml:lang="no">Utdanningsnivå</sh:name>
        <sh:description xml:lang="sr">Повезани ниво образовања у оквиру семантичког радног оквира који описује образовне нивое. Ако се наводи, вредност треба да потиче из контролисаног вокабулара. Добављачи података могу да користе своје контролисане листе.</sh:description>
        <sh:name xml:lang="es">Nivel educativo</sh:name>
        <sh:description xml:lang="bg">Свързано ниво на образование в семантична рамка, описваща образователните нива. Ако бъде посочена, стойността трябва да е от контролиран речник. Доставчиците на данни могат да използват свои собствени контролирани списъци.</sh:description>
        <sh:description xml:lang="sk">Súvisiaca úroveň vzdelávania v sémantickom rámci opisujúcom úrovne vzdelávania. Poskytnutá hodnota by mala byť z riadeného slovníka. Poskytovatelia údajov môžu používať vlastný riadený zoznam/vlastné riadené zoznamy.</sh:description>
        <sh:name xml:lang="mt">Livell ta’ edukazzjoni</sh:name>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="fi">Koulutustasoja kuvailevan semanttisen kehyksen mukainen koulutuksen taso. Jos arvo määritellään, sen täytyy perustua kontrolloituun sanastoon. Tietojen toimittajat voivat käyttää omia kontrolloituja luetteloitaan (yhtä tai useampaa).</sh:description>
        <sh:name xml:lang="bg">Образователно равнище</sh:name>
        <sh:name xml:lang="is">Menntunarstig</sh:name>
        <sh:name xml:lang="hr">Stupanj obrazovanja</sh:name>
        <sh:description xml:lang="lt">Susijęs išsilavinimo lygis švietimo lygmenis apibūdinančioje semantinėje sistemoje. Jei nurodoma, vertė turėtų būti iš kontrolinio žodyno. Duomenų teikėjai gali naudoti savo pačių kontrolinį sąrašą (-us).</sh:description>
        <sh:description xml:lang="en">An associated level of education within a semantic framework describing education levels. If provided, the value should come from a controlled vocabulary. Data providers can use their own cotrolled list(s).</sh:description>
        <sh:name xml:lang="it">Livello d'istruzione</sh:name>
        <sh:name xml:lang="lv">Izglītības līmenis</sh:name>
        <sh:name xml:lang="ro">Nivelul de studii</sh:name>
        <sh:name xml:lang="et">Haridustase</sh:name>
        <sh:description xml:lang="lv">Saistīts izglītības līmenis semantiskā sistēmā, kas raksturo izglītības līmeņus. Var norādīt tikai vērtības, kas ņemtas no kontrolētas vārdnīcas. Datu sniedzēji var izmantot paši savu(-us) kontroles sarakstu(-us).</sh:description>
        <sh:description xml:lang="tr">Eğitim seviyelerini tanımlayan anlamsal bir çerçeve içerisinde eğitimin ilgili seviyesi.Verilmişse, değer kontrol edilmiş bir sözlükten gelmelidir. Veri sağlayıcılar kendi kontrol edilmiş listesini(listelerini) kullanabilirler.</sh:description>
        <sh:name xml:lang="fr">Niveau d’éducation</sh:name>
        <sh:description xml:lang="es">Un nivel de educación asociado dentro de un marco semántico que describe los niveles educativos. Si se facilita, el valor debe proceder de un vocabulario controlado. Los proveedores de datos pueden utilizar su propia lista o listas controladas.</sh:description>
        <sh:description xml:lang="da">Et tilknyttet uddannelsesniveau inden for en semantisk ramme, der beskriver uddannelsesniveauer. Hvis oplyst, skal værdien tages fra en kontrolleret ordliste. Dataleverandører kan anvende deres egne kontrollerede lister.</sh:description>
      </rdf:Description>
    </sh:property>

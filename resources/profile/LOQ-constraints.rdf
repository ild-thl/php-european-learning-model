        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="tr">Bu şartnamenin bir ihtisas olduğu bir öğrenme başarısı şartnamesi (örneğin, bir standart).</sh:description>
        <sh:description xml:lang="hr">Specifikacija obrazovnog postignuća (npr. standard) čija je ova specifikacija specijalizacija.</sh:description>
        <sh:name xml:lang="es">especialización en</sh:name>
        <sh:name xml:lang="lv">specializācija</sh:name>
        <sh:name xml:lang="pl">specjalizacja</sh:name>
        <sh:name xml:lang="fr">spécialisation de</sh:name>

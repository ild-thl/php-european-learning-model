    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/WebResource-elm_contentUrl">
        <sh:description xml:lang="sv">URL för allmän åtkomst för subventionen, i form av pengar eller naturaförmåner, och inte måste betalas tillbaka.</sh:description>
        <sh:description xml:lang="it">L'URL di accesso pubblico per la sovvenzione, concessa sotto forma di finanziamento o in natura, che non richiede il rimborso.</sh:description>
        <sh:description xml:lang="mk">URL адресата за јавен пристап до субвенцијата, која е доделена финансиски или во непарични средства, што не треба да се отплаќа.</sh:description>
        <sh:name xml:lang="et">sisu URL</sh:name>
        <sh:name xml:lang="fi">sisällön URL-osoite</sh:name>
        <sh:name xml:lang="it">URL del contenuto</sh:name>
        <sh:name xml:lang="da">indhold URL</sh:name>
        <sh:name xml:lang="mk">УРЛ-адреса на содржината</sh:name>
        <sh:description xml:lang="hr">Internetska adresa (URL) s javnim pristupom za subvenciju koja je dodijeljena financijski ili u naravi, a koju ne treba vratiti.</sh:description>
        <sh:name xml:lang="lv">satura URL</sh:name>
        <sh:name xml:lang="sk">URL obsahu</sh:name>
        <sh:description xml:lang="sk">Verejne dostupné URL týkajúce sa finančnej alebo nefinančnej dotácie, ktorá si nevyžaduje vrátenie.</sh:description>
        <sh:name xml:lang="mt">URL tal-kontenut</sh:name>
        <sh:name xml:lang="ga">URL ábhar</sh:name>
        <sh:description xml:lang="bg">URL адресът за публичен достъп до информацията за финансовата помощ или помощта в натура, която не трябва да бъде връщана.</sh:description>
        <sh:name xml:lang="hu">a tartalom URL-je</sh:name>
        <sh:name xml:lang="ro">URL conținut</sh:name>
        <sh:description xml:lang="cs">Veřejně přístupná internetová adresa dotace poskytnuté finančně nebo jako věcné plnění, kterou není nutné vracet.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:description xml:lang="fr">L’URL accessible au public pour la subvention, financière ou en nature, qui ne nécessite pas de remboursement.</sh:description>
        <sh:name xml:lang="fr">URL du contenu</sh:name>
        <sh:description xml:lang="nl">De openbaar toegankelijke URL voor de subsidie, financieel of in natura toegekend, die niet hoeft te worden terugbetaald.</sh:description>
        <sh:description xml:lang="pt">O URL de acesso público para a subvenção, financeira ou em espécie, que não exige reembolso.</sh:description>
        <sh:description xml:lang="es">La URL de acceso público de la subvención económica o en especie, que no requiere reembolso.</sh:description>
        <sh:description xml:lang="da">URL'en for offentlig adgang til tilskuddet, finansielt eller i naturalier, som ikke skal tilbagebetales.</sh:description>
        <sh:name xml:lang="bg">URL адрес на съдържанието</sh:name>
        <sh:name xml:lang="no">innholds-URL</sh:name>
        <sh:name xml:lang="pl">URL treści</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/contentUrl"/>
        <sh:description xml:lang="de">Die öffentlich aufrufbare URL für den Zuschuss, der in finanzieller Form oder in Form von Sachleistungen gewährt wird und nicht zurückgezahlt wurden muss.</sh:description>
        <sh:description xml:lang="en">The public access URL for the subsidy, awarded financially or in-kind, which does not require repayment.</sh:description>
        <sh:description xml:lang="en">The public access URL.</sh:description>
        <sh:description xml:lang="et">Avaliku veebilehe URL-aadress rahalise või mitterahalise toetuse jaoks, mida ei ole vaja tagasi maksta.</sh:description>
        <sh:name xml:lang="hr">URL sadržaja</sh:name>
        <sh:name xml:lang="me">URL sadržaja</sh:name>
        <sh:name xml:lang="is">vefslóð efnis</sh:name>
        <sh:description xml:lang="no">Nettadressen for offentlig tilgang for tilskuddet, tildelt økonomisk eller i naturalier, som ikke krever tilbakebetaling.</sh:description>
        <sh:description xml:lang="fi">Taloudellisesti tai luontoissuorituksina myönnetyn, takaisinmaksua edellyttämättömän tuen julkinen verkko-osoite.</sh:description>
        <sh:description xml:lang="ro">URL-ul de acces public pentru subvenția, acordată financiar sau în natură, care nu necesită rambursare.</sh:description>
        <sh:description xml:lang="sl">Javno dostopen URL za subvencijo, dodeljeno v denarni ali nedenarni obliki, za katero se ne zahteva vračilo.</sh:description>
        <sh:name xml:lang="nl">content-URL</sh:name>
        <sh:description xml:lang="me">URL za javni pristup za subvenciju, dodijeljenu u novcu ili u naturi, koja ne zahtijeva otplatu.</sh:description>
        <sh:description xml:lang="ga">An URL rochtana poiblí don fhóirdheontas, arna bhronnadh ó thaobh airgeadais nó comhchineáil de, nach bhfuil aisíocaíocht ag teastáil ina leith.</sh:description>
        <sh:description xml:lang="sr">URL адреса за јавни приступ дотацији, новчаној или неновчаној, коју није неопходно отплатити.</sh:description>
        <sh:description xml:lang="hu">A pénzben vagy természetben odaítélt, vissza nem térítendő támogatás nyilvános URL-je.</sh:description>
        <sh:name xml:lang="el">URL περιεχομένου</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >3</sh:order>
        <sh:name xml:lang="es">URL del contenido</sh:name>
        <sh:description xml:lang="pl">Adres URL dostępu publicznego do dotacji przyznanej w formie finansowej lub rzeczowej, która nie podlega spłacie.</sh:description>
        <sh:name xml:lang="lt">turinio URL</sh:name>
        <sh:description xml:lang="mt">L-URL tal-aċċess pubbliku għas-sussidju, mogħti finanzjarjament jew in natura, li ma jeħtieġx ħlas lura.</sh:description>
        <sh:description xml:lang="lt">Finansinės arba nepiniginės subsidijos, kurios grąžinti nereikia, viešas URL.</sh:description>
        <sh:name xml:lang="sr">URL адреса садржаја</sh:name>
        <sh:name xml:lang="en">content URL</sh:name>
        <sh:name xml:lang="sl">vsebina URL</sh:name>

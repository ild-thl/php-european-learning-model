        <sh:path rdf:resource="http://purl.org/dc/terms/temporal"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:name xml:lang="en">Temporal Coverage</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="en">Temporal characteristics of the resource.</sh:description>
        <sh:class rdf:resource="http://purl.org/dc/terms/PeriodOfTime"/>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
      </rdf:Description>
    </sh:property>
    <rdfs:comment xml:lang="bg">Условията, напр. време и място, при които дадено лице може да придобие набор от знания и/или умения, използвани отговорно и самостоятелно.</rdfs:comment>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningOpportunity-elm_location">
        <sh:name xml:lang="mk">Локација</sh:name>
        <sh:name xml:lang="it">Luogo</sh:name>
        <sh:name xml:lang="de">Ort</sh:name>
        <sh:name xml:lang="et">Toimumiskoht</sh:name>
        <sh:description xml:lang="mk">Препознатливо географско место на ентитетот кој може да спроведе активности.</sh:description>
        <sh:description xml:lang="ro">Locul geografic identificabil al entității care este în măsură să desfășoare acțiuni.</sh:description>
        <sh:description xml:lang="is">Auðkennanleg landfræðileg staðsetning aðila sem er fær um að sjá um framkvæmd aðgerða.</sh:description>
        <sh:name xml:lang="ro">Locul</sh:name>
        <sh:name xml:lang="sv">Plats</sh:name>
        <sh:name xml:lang="pt">Local</sh:name>
        <sh:name xml:lang="da">Sted</sh:name>
        <sh:name xml:lang="no">Sted</sh:name>
        <sh:description xml:lang="en">The identifiable geographic place of the entity that is able to carry out actions.</sh:description>
        <sh:description xml:lang="lv">Tās entītijas ģeogrāfiskā atrašanās vieta, kura var veikt darbības.</sh:description>
        <sh:description xml:lang="el">Ο προσδιορίσιμος γεωγραφικός τόπος στον οποίο βρίσκεται η οντότητα που είναι σε θέση να εκτελεί ενέργειες.</sh:description>
        <sh:description xml:lang="fr">Le lieu géographique identifiable de l’entité ayant la capacité de mener des actions.</sh:description>
        <sh:name xml:lang="el">Τόπος</sh:name>
        <sh:name xml:lang="en">location</sh:name>
        <sh:description xml:lang="lt">Subjekto, galinčio atlikti veiksmus, identifikuojama geografinė vieta.</sh:description>
        <sh:description xml:lang="et">Tegevusi läbiviiva üksuse tuvastatav geograafiline asukoht.</sh:description>
        <sh:description xml:lang="es">La ubicación geográfica identificable de la entidad que puede llevar a cabo las acciones.</sh:description>
        <sh:name xml:lang="fr">Lieu</sh:name>
        <sh:description xml:lang="fi">Toimien toteuttamiseen kykenevän tahon todennettavissa oleva maantieteellinen paikka.</sh:description>
        <sh:description xml:lang="da">Identificerbart geografisk sted for den enhed, der kan udføre handlinger.</sh:description>
        <sh:description xml:lang="cs">Identifikovatelná zeměpisná poloha entity, která může provádět akce.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/location"/>
        <sh:name xml:lang="ga">Suíomh</sh:name>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="sl">Določljiv geografski kraj subjekta, ki lahko opravlja dejavnosti.</sh:description>
        <sh:name xml:lang="is">Staðsetning</sh:name>
        <sh:name xml:lang="hr">Lokacija</sh:name>
        <sh:name xml:lang="me">Lokacija</sh:name>
        <sh:name xml:lang="es">Ubicación</sh:name>
        <sh:description xml:lang="pt">O local geograficamente identificado da entidade capaz de realizar ações.</sh:description>
        <sh:name xml:lang="sl">Kraj</sh:name>
        <sh:description xml:lang="hr">Prepoznatljivo zemljopisno mjesto subjekta koji može provoditi mjere.</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="sv">Den identifierbara geografiska platsen för den enhet som kan vidta åtgärder.</sh:description>
        <sh:name xml:lang="nl">Plaats</sh:name>
        <sh:description xml:lang="ga">Áit gheografach inaitheanta an eintitis atá in ann gníomhaíochtaí a dhéanamh.</sh:description>
        <sh:name xml:lang="hu">Helyszín</sh:name>
        <sh:name xml:lang="pl">Miejsce</sh:name>
        <sh:description xml:lang="pl">Możliwa do zidentyfikowania lokalizacja geograficzna podmiotu, który jest w stanie prowadzić działania.</sh:description>
        <sh:description xml:lang="bg">Установимо географско място на субекта, който е в състояние да извършва действия.</sh:description>
        <sh:description xml:lang="mt">Il-post ġeografiku identifikabbli tal-entità li tista’ twettaq azzjonijiet.</sh:description>
        <sh:description xml:lang="sr">Препознатљиво географско место ентитета који може да обавља радње.</sh:description>
        <sh:description xml:lang="hu">A tevékenységeket végrehajtani képes entitás azonosítható földrajzi helyszíne.</sh:description>
        <sh:name xml:lang="bg">Местоположение</sh:name>
        <sh:description xml:lang="it">Il luogo geografico identificabile del soggetto in grado di svolgere azioni.</sh:description>
        <sh:description xml:lang="me">Prepoznatljivo geografsko mjesto subjekta koji je u stanju da sprovodi akcije.</sh:description>
        <sh:description xml:lang="en">The location of a resource.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >8</sh:order>
        <sh:name xml:lang="fi">Sijainti</sh:name>
        <sh:description xml:lang="de">Der identifizierbare geografische Ort der Entität, die Aktionen ausführen kann.</sh:description>
        <sh:description xml:lang="nl">De identificeerbare geografische plaats van de entiteit die in staat is om acties uit te voeren.</sh:description>
        <sh:name xml:lang="mt">Lok</sh:name>
        <sh:description xml:lang="no">Det identifiserbare geografiske stedet for enheten som er i stand til å utføre handlinger.</sh:description>
        <sh:name xml:lang="tr">Yer</sh:name>
        <sh:name xml:lang="sk">Miesto</sh:name>
        <sh:name xml:lang="lv">Vieta</sh:name>
        <sh:name xml:lang="lt">Vieta</sh:name>
        <sh:class rdf:resource="http://purl.org/dc/terms/Location"/>
        <sh:description xml:lang="sk">Identifikovateľné geografické miesto subjektu, ktorý môže vykonávať akcie.</sh:description>
        <sh:description xml:lang="tr">Faaliyetleri yerine getirebilecek olan kurumun tanımlanabilir coğrafi yeri.</sh:description>
        <sh:name xml:lang="cs">Místo</sh:name>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningOpportunity-elm_learningSchedule">
        <sh:name xml:lang="en">learning schedule</sh:name>
        <sh:name xml:lang="bg">График за обучението</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="fr">L’horaire d’apprentissage. Si elle est fournie, la valeur doit provenir d’un vocabulaire contrôlé(e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Les fournisseurs de données peuvent utiliser leur(s) propre(s) liste(s) contrôlée(s).</sh:description>
        <sh:name xml:lang="pl">Harmonogram nauki</sh:name>
        <sh:description xml:lang="hu">A tanulás ütemezése. Az értéknek (ha meg van adva) ellenőrzött szójegyzékből kell származnia (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Az adatszolgáltatók használhatják a saját ellenőrzött listájukat (listáikat).</sh:description>
        <sh:name xml:lang="ro">Orar</sh:name>
        <sh:description xml:lang="es">El calendario de aprendizaje. Si se facilita, el valor debe proceder de un vocabulario controlado (por ejemplo, http://publications.europa.eu/resource/dataset/learning-schedule). Los proveedores de datos pueden utilizar su propia lista o listas controladas.</sh:description>
        <sh:description xml:lang="cs">Harmonogram studia. Poskytnutá hodnota by měla být převzata z řízeného slovníku (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Poskytovatelé údajů mohou použít svůj vlastní řízený seznam (své vlastní řízené seznamy).</sh:description>
        <sh:name xml:lang="cs">Rozvrh učení</sh:name>
        <sh:name xml:lang="no">Timeplan for læringen.</sh:name>
        <sh:description xml:lang="de">Der Lernplan. Falls angegeben, sollte der Wert aus einem kontrollierten Vokabular stammen (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Datenanbieter können ihre eigene(n) kontrollierte(n) Liste(n) verwenden.</sh:description>
        <sh:description xml:lang="el">Το πρόγραμμα μάθησης. Εάν παρέχεται, η τιμή θα πρέπει να προέρχεται από ελεγχόμενο λεξιλόγιο (π.χ. http://publications.europa.eu/resource/dataset/learning-schedule). Οι πάροχοι δεδομένων μπορούν να χρησιμοποιούν τον/τους δικό/-ούς τους ελεγχόμενο/-ους κατάλογο/-λόγους.</sh:description>
        <sh:description xml:lang="ga">An sceideal foghlama. Má chuirtear ar fáil é, ba cheart an luach teacht ó stór focal rialaithe (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Is féidir le soláthraithe sonraí a liosta nó a liostaí rialaithe féin a úsáid.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:name xml:lang="fr">Horaire d'apprentissage</sh:name>
        <sh:description xml:lang="da">Læringsplanen. Hvis oplyst, skal værdien tages fra en kontrolleret ordliste (f.eks. http://publications.europa.eu/resource/dataset/learning-schedule). Dataleverandører kan anvende deres egne kontrollerede lister.</sh:description>
        <sh:name xml:lang="nl">Leerschema</sh:name>
        <sh:name xml:lang="lv">Mācību grafiks</sh:name>
        <sh:description xml:lang="et">Õppimise ajakava. Kui väärtus on märgitud, peaks see pärinema kontrollitud sõnastikust (nt http://publications.europa.eu/resource/dataset/learning-schedule). Andmeesitajad võivad kasutada oma kontrollitud loendit (loendeid).</sh:description>
        <sh:description xml:lang="fi">Opiskeluaikataulu. Jos arvo määritellään, sen täytyy perustua kontrolloituun sanastoon (esim. http://publications.europa.eu/resource/dataset/learning-schedule). Tietojen toimittajat voivat käyttää omia kontrolloituja luetteloitaan (yhtä tai useampaa).</sh:description>
        <sh:name xml:lang="es">Horario de aprendizaje</sh:name>
        <sh:description xml:lang="nl">Het leerschema. Indien verstrekt, moet de waarde afkomstig zijn uit een gecontroleerde woordenlijst (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Aanbieders van gegevens kunnen hun eigen gecontroleerde lijst(en) gebruiken.</sh:description>
        <sh:name xml:lang="da">Tidsplan for læring</sh:name>
        <sh:name xml:lang="it">Calendario</sh:name>
        <sh:name xml:lang="fi">Oppimisaikataulu</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:name xml:lang="me">Raspored učenja</sh:name>
        <sh:name xml:lang="ga">An Sceideal Foghlama</sh:name>
        <sh:name xml:lang="hr">Raspored učenja</sh:name>
        <sh:name xml:lang="mt">Skeda ta’ Tagħlim</sh:name>
        <sh:name xml:lang="mk">Распоред на учење</sh:name>
        <sh:name xml:lang="de">Lernplan</sh:name>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:name xml:lang="tr">Öğrenim Takvimi</sh:name>
        <sh:description xml:lang="sk">Harmonogram vzdelávania. Poskytnutá hodnota by mala byť z riadeného slovníka (napr. http://publications.europa.eu/resource/dataset/learning-schedule). Poskytovatelia údajov môžu používať vlastný riadený zoznam/vlastné riadené zoznamy.</sh:description>
        <sh:description xml:lang="lt">Mokymosi tvarkaraštis. Jei nurodoma, vertė turėtų būti iš kontrolinio žodyno (pvz., http://publications.europa.eu/resource/dataset/learning-schedule). Duomenų teikėjai gali naudoti savo pačių kontrolinį sąrašą (-us).</sh:description>
        <sh:name xml:lang="is">Námsáætlun</sh:name>
        <sh:description xml:lang="pt">O calendário de aprendizagem. Se for indicado, o valor deve provir de um vocabulário controlado (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Os fornecedores de dados podem utilizar a(s) sua(s) própria(s) lista(s) controlada(s).</sh:description>
        <sh:description xml:lang="en">The learning schedule. If provided, the value should come from a controlled vocabulary (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Data providers can use their own cotrolled list(s).</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="ro">Orarul cursurilor. Dacă este furnizată, valoarea ar trebui să provină dintr-un vocabular controlat (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Furnizorii de date își pot utiliza propriile liste controlate.</sh:description>
        <sh:name xml:lang="lt">Mokymosi tvarkaraštis</sh:name>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="pl">Harmonogram nauki. Jeżeli ją podano, wartość powinna pochodzić ze słownika kontrolowanego (np. http://publications.europa.eu/resource/dataset/learning-schedule). Dostawcy danych mogą stosować swoje własne listy kontrolowane.</sh:description>
        <sh:name xml:lang="sv">Inlärningsschema</sh:name>
        <sh:name xml:lang="pt">Calendário da aprendizagem</sh:name>
        <sh:description xml:lang="sr">Распоред учења. Ако се наводи, вредност треба да потиче из контролисаног вокабулара (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Добављачи података могу да користе своје контролисане листе.</sh:description>
        <sh:description xml:lang="no">Læreplanen. Hvis oppgitt, bør verdien komme fra et kontrollert vokabular (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Dataleverandører kan bruke sin(e) egen/egne kontrollerte liste(r).</sh:description>
        <sh:description xml:lang="sv">Inlärningsschemat. I förekommande fall ska värdet komma från en kontrollerad ordlista (t.ex. http://publications.europa.eu/resource/dataset/learning-schedule). Uppgiftslämnare kan använda en eller flera egna kontrollerade listor.</sh:description>
        <sh:description xml:lang="me">Raspored učenja. Ako je navedena, vrijednost bi trebalo da potiče iz kontrolisanog rječnika (npr. http://publications.europa.eu/resource/dataset/learning-schedule). Provajderi podataka mogu da koriste sopstvene kontrolisane liste.</sh:description>
        <sh:name xml:lang="sl">Učni načrt</sh:name>
        <sh:description xml:lang="en">Detailed information about the timetable or schedule. This may include weekly schedules (e.g., Every Monday, 4pm, but may also include the overall schedule for the course, (e.g., October: lectures, November: group-work, December: break, January: assessment).</sh:description>
        <sh:description xml:lang="bg">Учебният график. Ако бъде посочена, стойността трябва да е от контролиран речник (напр. http://publications.europa.eu/resource/dataset/learning-schedule). Доставчиците на данни могат да използват свои собствени контролирани списъци.</sh:description>
        <sh:name xml:lang="et">Õppegraafik</sh:name>
        <sh:description xml:lang="hr">Raspored učenja. Ako je navedena, vrijednost bi trebala biti iz kontroliranog rječnika (npr. http://publications.europa.eu/resource/dataset/learning-schedule). Pružatelji podataka mogu se služiti vlastitim popisom/popisima.</sh:description>
        <sh:name xml:lang="sk">Harmonogram vzdelávania</sh:name>
        <sh:description xml:lang="mt">L-iskeda tat-tagħlim. Jekk jiġi pprovdut, il-valur għandu jiġi minn vokabularju kkontrollat (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Il-fornituri tad-data jistgħu jużaw il-lista/i kontrollata/i tagħhom stess.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/learningSchedule"/>
        <sh:description xml:lang="tr">Öğrenme planı. Verilmişse, değer kontrol edilmiş bir sözlükten gelmelidir (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Veri sağlayıcılar kendi kontrol edilmiş listesini(listelerini) kullanabilirler.</sh:description>
        <sh:description xml:lang="is">Námsáætlun. Ef til staðar, ætti gildið að vera tekið úr stýrðum orðaforða (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Gagnaveitendur geta notað þeirra eigin stýrðan lista.</sh:description>
        <sh:description xml:lang="it">Il calendario. Se fornito, il valore deve essere tratto da un vocabolario controllato (ad es. http://publications.europa.eu/resource/dataset/learning-schedule). I fornitori di dati possono utilizzare i propri elenchi controllati.</sh:description>
        <sh:name xml:lang="el">Πρόγραμμα μάθησης</sh:name>
        <sh:description xml:lang="lv">Mācību grafiks. Var norādīt tikai vērtības, kas ņemtas no kontrolētas vārdnīcas (piem., http://publications.europa.eu/resource/dataset/learning-schedule). Datu sniedzēji var izmantot paši savu(-us) kontroles sarakstu(-us).</sh:description>
        <sh:name xml:lang="hu">A tanulás ütemezése</sh:name>
        <sh:description xml:lang="sl">Učni načrt. Če je vrednost navedena, bi morala izhajati iz kontroliranega besednjaka (npr. http://publications.europa.eu/resource/dataset/learning-schedule). Ponudniki podatkov lahko uporabljajo svoje kontrolirane sezname.</sh:description>
        <sh:description xml:lang="mk">Распоред на учењето. Ако е дадена, вредноста треба да биде од контролиран вокабулар (e.g. http://publications.europa.eu/resource/dataset/learning-schedule). Давателите на податоци можат да користат сопствена котролирана листа(и).</sh:description>
      </rdf:Description>
    </sh:property>
    <rdfs:comment xml:lang="ro">Condițiile, de exemplu ora și locul, în care o persoană poate dobândi un set de cunoștințe și/sau competențe utilizate cu responsabilitate și autonomie.</rdfs:comment>
    <sh:property rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints/elm_order"/>
    <rdfs:comment xml:lang="et">Tingimused, nt aeg ja koht, mille alusel inimene võib omandada teadmiste ja/või oskuste kogumi, mida ta kasutab vastutustundlikult ja iseseisvalt.</rdfs:comment>
    <rdfs:label xml:lang="sl">Možnost izobraževanja</rdfs:label>
    <rdfs:comment xml:lang="cs">Podmínky, např. časové a místní, za kterých si osoba může osvojit soubor znalostí a/nebo dovedností používaných zodpovědně a samostatně.</rdfs:comment>
    <rdfs:label xml:lang="ga">Deis Foghlama</rdfs:label>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningOpportunity-elm_duration">
        <sh:name xml:lang="lt">Trukmė</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="tr">Öğrenme fırsatının devam edeceği nominal süre. Bunun bitiş tarihinden sonra olabileceğini unutmayın, çünkü kayıtlar kapanmış olabilir ancak öğrenme fırsatı hala devam ediyor olabilir.</sh:description>
        <sh:name xml:lang="bg">Продължителност</sh:name>
        <sh:name xml:lang="de">Dauer</sh:name>
        <sh:description xml:lang="et">Nominaalne kestus, mille jooksul õppimisvõimalus jätkub. Pange tähele, et see võib olla pärast lõppkuupäeva, sest vastuvõtt võib olla suletud, kuid õppimisvõimalus võib veel jätkuda.</sh:description>
        <sh:description xml:lang="mk">Номиналното времетраење за кое ќе продолжи да тече можноста за учење. Имајте на ум дека ова може да биде по завршувањето на датумот, бидејќи приемните може да бидат завршени, но можноста за учење сé уште може да биде во тек.</sh:description>
        <sh:name xml:lang="fi">Kesto</sh:name>
        <sh:description xml:lang="no">Den nominelle varigheten læringsmuligheten vil fortsette å vare. Merk at dette kan være etter sluttdatoen, siden opptak kan være stengt, men læringsmuligheten kan fortsatt pågå.</sh:description>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
        <sh:description xml:lang="en">A duration.</sh:description>
        <sh:description xml:lang="fr">La période nominale pendant laquelle la possibilité d’apprentissage continuera à être dispensée. Note: celle-ci peut être postérieure à la date de fin, étant donné que la période d'inscription peut être close alors que la possibilité d’apprentissage est toujours dispensée.</sh:description>
        <sh:description xml:lang="it">La durata nominale dell'opportunità di apprendimento. Si noti che tale termine potrebbe essere successivo alla data conclusiva, dal momento che, pur essendo chiuse le iscrizioni, l'opportunità di apprendimento potrebbe essere ancora in corso.</sh:description>
        <sh:name xml:lang="sr">0.0</sh:name>
        <sh:description xml:lang="sr">Номинално трајање током ког ће се одвијати прилика за учење. Имајте у виду да ово може бити и након крајњег датума јер упис може бити завршен, а да прилика за учење и даље тече.</sh:description>
        <sh:name xml:lang="da">Varighed</sh:name>
        <sh:description xml:lang="nl">De nominale tijdsduur waarvoor de leermogelijkheid zal blijven lopen. Let op: dit kan na de einddatum zijn, aangezien de toelating gesloten kan zijn, maar de leermogelijkheid nog kan lopen.</sh:description>
        <sh:description xml:lang="hu">Az az időtartam, ameddig a tanulási lehetőség fennáll. Figyelem! Előfordulhat, hogy ez az időtartam a záró dátum után ér véget (abban az esetben, ha a felvételi eljárások már lezárultak, de a tanulási lehetőség még tart).</sh:description>
        <sh:description xml:lang="sl">Nominalno trajanje možnosti izobraževanja. Opomba: To je lahko po končnem datumu, saj se število vpisnih mest lahko zapolni, možnost izobraževanja pa je lahko še vedno na voljo.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >4</sh:order>
        <sh:name xml:lang="en">duration</sh:name>
        <sh:name xml:lang="el">Διάρκεια</sh:name>
        <sh:name xml:lang="ro">Durata</sh:name>
        <sh:name xml:lang="it">Durata</sh:name>
        <sh:name xml:lang="pl">Czas trwania</sh:name>
        <sh:description xml:lang="da">Den nominelle periode, hvor læringsmuligheden er igangværende. Bemærk, at dette kan være efter slutdatoen, da muligheden for optagelse kan være udløbet, mens læringsmulighederne fortsætter.</sh:description>
        <sh:description xml:lang="pt">A duração nominal da oportunidade de aprendizagem. É de notar que o termo deste período pode ser posterior à data-limite, uma vez que o processo de admissão pode ser encerrado enquanto ainda decorre a oportunidade de aprendizagem.</sh:description>
        <sh:description xml:lang="me">Nominalno trajanje tokom kojeg će prilika za učenje nastaviti da traje. Imajte na umu da to može biti nakon datuma završetka, budući da je upis možda zatvoren, ali prilika za učenje još uvijek može biti u toku.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="is">Tímabil sem hægt er að nýta sér námstækifæri. Athugið að það getur verið eftir endadagsetningu, því umsóknarfrestur getur verið liðinn en tækifæri til náms verið enn til staðar.</sh:description>
        <sh:name xml:lang="nl">Duur</sh:name>
        <sh:name xml:lang="fr">Durée</sh:name>
        <sh:description xml:lang="sv">Den nominella tid som inlärningsmöjligheten pågår. Notera att detta kan vara efter slutdatumet, eftersom ansökningstiden kan ha löpt ut medan inlärningsmöjligheten fortfarande pågår.</sh:description>
        <sh:name xml:lang="es">Duración</sh:name>
        <sh:name xml:lang="lv">Mācību ilgums</sh:name>
        <sh:description xml:lang="mt">It-tul ta’ żmien nominali li għalih l-opportunità ta’ tagħlim se tkompli għaddejja. Innota, din tista’ tkun wara d-data tat-tmiem, peress li l-ammissjonijiet jistgħu jingħalqu iżda l-opportunità ta’ tagħlim tista’ tkun għadha għaddejja.</sh:description>
        <sh:name xml:lang="no">Varighet</sh:name>
        <sh:description xml:lang="cs">Jmenovitá doba, po kterou bude vzdělávací příležitost trvat. Upozorňujeme, že tato doba může překračovat konečné datum, protože přijímací řízení již sice mohou být ukončena, vzdělávací příležitost však může stále probíhat.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="es">El período teórico durante el cual la oportunidad de aprendizaje seguirá llevándose a cabo. Nótese que puede ser posterior a la fecha de finalización, ya que la oportunidad de aprendizaje puede continuar tras haber finalizado el plazo de admisión.</sh:description>
        <sh:name xml:lang="hu">Időtartam</sh:name>
        <sh:description xml:lang="ga">An fad ainmniúil a leanfaidh an deis foghlama ar aghaidh. Tabhair faoi deara go bhféadfadh sé sin a bheith tar éis an dáta deiridh, ós rud é go bhféadfadh cead isteach a bheith dúnta ach d’fhéadfadh an deis foghlama a bheith fós ar siúl.</sh:description>
        <sh:description xml:lang="hr">Nominalno trajanje mogućnosti učenja. Napomena: može biti nakon datuma završetka jer prijem može biti zaključen, a mogućnost učenja može još biti u tijeku.</sh:description>
        <sh:name xml:lang="cs">Doba trvání</sh:name>
        <sh:description xml:lang="el">Η ονομαστική διάρκεια της ευκαιρίας μάθησης. Σημειώνεται ότι η διάρκεια αυτή μπορεί να εκτείνεται πέραν της τελικής ημερομηνίας, καθώς μπορεί να μη γίνονται πλέον δεκτές αιτήσεις, αλλά η ευκαιρία μάθησης μπορεί να είναι ακόμη σε εξέλιξη.</sh:description>
        <sh:name xml:lang="et">Kestus</sh:name>
        <sh:description xml:lang="lt">Numatomas laikotarpis, kuriuo mokymosi galimybė bus teikiama. Atkreipkite dėmesį į tai, kad šis laikotarpis gali tęstis ir po pabaigos datos, nes priėmimas gali būti pasibaigęs, bet pati mokymosi galimybė gali būti dar teikiama.</sh:description>
        <sh:description xml:lang="en">The nominal duration for which the learning opportunity will continue to run. Note, this may be after the end-date, since admissions may be closed but the learning opportunity may still be ongoing.</sh:description>
        <sh:description xml:lang="fi">Oppimismahdollisuuden jatkumisen nimellinen kesto. Huomaa, että tämä saattaa olla päättymispäivän jälkeen, sillä oppimismahdollisuus saattaa jatkua edelleen, vaikka sisäänotto on päättynyt.</sh:description>
        <sh:description xml:lang="de">Die Regellaufzeit der Lernmöglichkeit. Hinweis: Die Lernmöglichkeit kann über das Enddatum hinaus verfügbar sein, da nach diesem Tag zwar keine Teilnehmer mehr zugelassen werden, die Maßnahme aber möglicherweise weiterläuft.</sh:description>
        <sh:name xml:lang="sv">Varaktighet</sh:name>
        <sh:name xml:lang="mk">Времетраење</sh:name>
        <sh:description xml:lang="bg">Номиналната продължителност на провеждане на учебната възможност. Имайте предвид, че това може да е след крайната дата, тъй като е възможно приемът да е приключил, но учебната възможност все още да продължава.</sh:description>
        <sh:description xml:lang="pl">Nominalny czas trwania oferty nauki. Uwaga: dopuszczalne po dacie końcowej, ponieważ okres przyjmowania może zostać zakończony, a oferta nauki może dalej trwać.</sh:description>
        <sh:name xml:lang="sk">Trvanie</sh:name>
        <sh:name xml:lang="is">Tímalengd</sh:name>
        <sh:name xml:lang="mt">Tul ta’ żmien</sh:name>
        <sh:description xml:lang="sk">Menovité trvanie príležitosti na vzdelávanie. Upozorňujeme, že to môže byť po dátume ukončenia, keďže prihlasovanie už môže byť skončené, ale príležitosť na vzdelávanie ešte môže pokračovať.</sh:description>
        <sh:description xml:lang="lv">Mācību iespējas darbības nominālais ilgums. Ņemiet vērā, ka mācību iespēja var būt spēkā arī pēc beigu datuma, jo, lai gan jaunu dalībnieku uzņemšana vairs nenotiek, mācību iespējas norise turpinās.</sh:description>
        <sh:name xml:lang="pt">Duração</sh:name>
        <sh:name xml:lang="tr">Süre</sh:name>
        <sh:description xml:lang="ro">Perioada teoretică în care va continua să se desfășoare oportunitatea de învățare. Notă: finalul acestei perioade poate fi posterior datei de sfârșit, întrucât este posibil să se fi încheiat doar admiterea, nu și procesul de învățare.</sh:description>
        <sh:name xml:lang="ga">Fad</sh:name>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/duration"/>
        <sh:name xml:lang="sl">Trajanje</sh:name>
        <sh:name xml:lang="me">Trajanje</sh:name>
        <sh:name xml:lang="hr">Trajanje</sh:name>
      </rdf:Description>
    </sh:property>
    <sh:ignoredProperties rdf:parseType="Collection">
      <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
    </sh:ignoredProperties>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningOpportunity-elm_learningAchievementSpecification">
        <sh:description xml:lang="sk">Udelený opis súboru vedomostí a/alebo zručností používaných zodpovedne a samostatne, ktoré možno nadobudnúť.</sh:description>
        <sh:name xml:lang="mk">доделена спецификација за достигнување во учењето</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:or rdf:parseType="Collection">
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/LearningAchievementSpecification"/>
          </rdf:Description>
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/QualificationReference"/>
          </rdf:Description>
          <rdf:Description>
            <sh:class rdf:resource="http://data.europa.eu/snb/model/ontology/Qualification"/>
          </rdf:Description>
        </sh:or>
        <sh:description xml:lang="tr">Edinilebilecek olan otonomi ve sorumluluk ile kullanılan bir dizi bilgi ve/veya kabiliyetin verilen tanımı.</sh:description>
        <sh:name xml:lang="ga">sonraíocht gnóthachtála foghlama bronnta</sh:name>
        <sh:name xml:lang="en">learning achievement specification</sh:name>
        <sh:description xml:lang="sl">Dodeljen opis nabora znanja in/ali spretnosti, ki se uporabljajo odgovorno in samostojno ter se lahko pridobijo.</sh:description>
        <sh:description xml:lang="no">Den tildelte beskrivelsen av et sett med kunnskap og/eller ferdigheter brukt med ansvar og autonomi, som kan tilegnes.</sh:description>
        <sh:name xml:lang="sr">спецификација заслуженог достигнућа у учењу</sh:name>
        <sh:description xml:lang="me">Dodijeljeni opis skupa znanja i/ili vještina koje se koriste s odgovornošću i autonomijom, a koje se mogu steći.</sh:description>
        <sh:name xml:lang="fi">myönnetyn oppimissuorituksen eritelmä</sh:name>
        <sh:name xml:lang="me">dodijeljena specifikacija postignuća u učenju</sh:name>
        <sh:name xml:lang="pl">specyfikacja poświadczenia uzyskania rezultatu nauczania</sh:name>
        <sh:description xml:lang="pt">A descrição atribuída de um conjunto de conhecimentos e/ou competências utilizados com responsabilidade e autonomia, que podem ser adquiridos.</sh:description>
        <sh:description xml:lang="de">Die ausgewiesene Beschreibung einer Reihe von Kenntnissen und/oder Fähigkeiten, die mit Verantwortung und Autonomie genutzt werden und erworben werden können.</sh:description>
        <sh:description xml:lang="nl">De toegekende beschrijving van kennis en/of vaardigheden die op verantwoordelijke en zelfstandige wijze worden gebruikt, die kunnen worden verworven.</sh:description>
        <sh:name xml:lang="tr">ödül olarak verilen öğrenme başarısının özelliği</sh:name>
        <sh:name xml:lang="mt">speċifikazzjoni tal-kisba tal-apprendiment mogħtija</sh:name>
        <sh:description xml:lang="es">La descripción atribuida a un conjunto de conocimientos o competencias utilizados con responsabilidad y autonomía, que pueden adquirirse.</sh:description>
        <sh:description xml:lang="ro">Descrierea atribuită unui set de cunoștințe și/sau competențe utilizate cu responsabilitate și autonomie, care pot fi dobândite.</sh:description>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:description xml:lang="is">Viðurkennd lýsing á safni þekkingar og/eða færni sem notað er af ábyrgð og með sjálfstæðum hætti og sem hægt er að öðlast.</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >3</sh:order>
        <sh:description xml:lang="it">La descrizione attribuita a una serie di conoscenze e/o abilità che possono essere acquisite, utilizzate con responsabilità e autonomia.</sh:description>
        <sh:name xml:lang="it">specifica del risultato dell'apprendimento conferito</sh:name>
        <sh:description xml:lang="ga">An tuairisc bhronnta ar thacar eolais agus/nó scileanna a úsáidtear le freagracht agus neamhspleáchas, a d’fhéadfaí a fháil.</sh:description>
        <sh:description xml:lang="cs">Udělený popis souboru znalostí a/nebo dovedností používaných zodpovědně a samostatně, které lze získat.</sh:description>
        <sh:description xml:lang="lt">Atsakingai ir savarankiškai naudojamų žinių ir (arba) įgūdžių, kurie gali būti įgyti, suteiktas aprašas.</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/learningAchievementSpecification"/>
        <sh:name xml:lang="bg">спецификация за присъденото учебно постижение</sh:name>
        <sh:name xml:lang="fr">spécification de l’acquis d’apprentissage attribué</sh:name>
        <sh:description xml:lang="lv">Saistītais apraksts par iegūstamo atbildīgi un autonomi izmantojamo zināšanu un/vai prasmju kopumu.</sh:description>
        <sh:description xml:lang="et">Omandatavate vastutustundlikult ja iseseisvalt kasutatavate teadmiste ja/või oskuste kogumi väljaantud kirjeldus.</sh:description>
        <sh:name xml:lang="sl">specifikacija podeljenega učnega dosežka</sh:name>
        <sh:description xml:lang="sv">Den utfärdade beskrivningen av en uppsättning kunskaper och/eller färdigheter som en person kan skaffa sig och som används med ansvar och självständighet</sh:description>
        <sh:description xml:lang="bg">Описание на набор от знания и/или умения, използвани отговорно и самостоятелно, които могат да бъдат придобити.</sh:description>
        <sh:name xml:lang="no">tildelt læringsprestasjonsspesifikasjon</sh:name>
        <sh:name xml:lang="en">awarded learning achievement specification</sh:name>
        <sh:name xml:lang="nl">specificatie toegekende leerprestatie</sh:name>
        <sh:description xml:lang="fr">La description attribuée d’un ensemble de connaissances et/ou de compétences utilisées avec des responsabilités et une certaine autonomie, qui peuvent être acquises.</sh:description>
        <sh:description xml:lang="en">The awarded description of a set of knowledge and/or skills used with responsibility and autonomy, which may be acquired.</sh:description>
        <sh:name xml:lang="es">especificación del logro de aprendizaje que ha sido concedido</sh:name>
        <sh:name xml:lang="sk">špecifikácia získaného vzdelávacieho výstupu</sh:name>
        <sh:name xml:lang="ro">specificație de realizare a învățării acordată</sh:name>
        <sh:name xml:lang="is">samþykktir skilmálar námsárangurs</sh:name>
        <sh:name xml:lang="da">specifikation for tildelte læringsresultater</sh:name>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="sr">Додељени опис скупа знања и/или вештина за одговорну и самосталну примену који се могу стећи.</sh:description>
        <sh:name xml:lang="hu">a megszerzett tanulási eredmények specifikációja</sh:name>
        <sh:description xml:lang="mt">Id-deskrizzjoni mogħtija ta’ sett ta’ għarfien u/jew ħiliet użati b’responsabbiltà u awtonomija, li jistgħu jinkisbu.</sh:description>
        <sh:description xml:lang="en">The learning achievement specification, including the curricula, of this learning opportunity.</sh:description>
        <sh:description xml:lang="el">Η χορηγηθείσα περιγραφή ενός συνόλου γνώσεων και/ή δεξιοτήτων που χρησιμοποιούνται με υπευθυνότητα και αυτονομία, οι οποίες μπορούν να αποκτηθούν.</sh:description>
        <sh:name xml:lang="hr">specifikacija dodijeljenog postignuća učenja</sh:name>
        <sh:name xml:lang="pt">especificação da aquisição de aprendizagem conferida</sh:name>
        <sh:name xml:lang="de">Spezifikation für das erzielte Lernergebnis</sh:name>
        <sh:name xml:lang="cs">specifikace získaného studijního úspěchu</sh:name>
        <sh:description xml:lang="da">Den tildelte beskrivelse af et sæt kundskaber og/eller færdigheder anvendt med ansvar og selvstændighed, og som kan erhverves.</sh:description>
        <sh:name xml:lang="lv">iegūtā mācību sasnieguma specifikācija</sh:name>
        <sh:description xml:lang="pl">Opis uzyskania możliwego do zdobycia zestawu wiedzy lub umiejętności wykorzystywanych z odpowiedzialnością i autonomią.</sh:description>
        <sh:description xml:lang="mk">Доделениот опис на збир на знаења и/или вештини кои се користат со одговорност и автономија, кои можат да се стекнат.</sh:description>
        <sh:name xml:lang="et">hinnatava õpiväljundi kirjeldus</sh:name>
        <sh:name xml:lang="sv">utfärdad specifikation för läranderesultat</sh:name>
        <sh:description xml:lang="fi">Myönnetty kuvaus hankittavissa olevien vastuullisesti ja itsenäisesti käytettävistä tiedoista ja/tai taidoista.</sh:description>
        <sh:description xml:lang="hr">Dodijeljeni opis skupa znanja i/ili vještina koje se upotrebljavaju odgovorno i autonomno te koje se mogu steći.</sh:description>
        <sh:name xml:lang="el">χορηγηθείσα προδιαγραφή μαθησιακών επιτευγμάτων</sh:name>
        <sh:name xml:lang="lt">skirto mokymosi pasiekimo specifikacija</sh:name>
        <sh:description xml:lang="hu">Azon elsajátítható ismeretek és/vagy készségek odaítélt ismertetése, amelyeket az egyén önállóan és felelősségteljesen tud használni.</sh:description>
      </rdf:Description>
    </sh:property>
    <rdfs:comment xml:lang="lt">Sąlygos, pvz., laiko ir vietos, kuriomis asmuo gali įgyti žinių ir (arba) įgūdžių, naudojamų atsakingai ir savarankiškai.</rdfs:comment>
    <sh:group rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
    >1</sh:group>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningOpportunity-elm_defaultLanguage">
        <sh:name xml:lang="es">lengua predeterminada</sh:name>
        <sh:name xml:lang="lt">numatytoji kalba</sh:name>
        <sh:description xml:lang="sl">Osnovni jezik pogojev, pod katerimi oseba lahko pridobi nabor znanja in/ali spretnosti, ki se uporabljajo odgovorno in samostojno, da bi veljali za verodostojne. Navedena vrednost mora izhajati z referenčnega seznama jezikov (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="mk">зададен јазик</sh:name>
        <sh:name xml:lang="pl">język domyślny</sh:name>
        <sh:name xml:lang="hr">zadani jezik</sh:name>
        <sh:description xml:lang="mk">Основниот јазик на условите под кои едно лице може да стекне збир на знаења и/или вештини кои се користат со одговорност и автономија, за да се сметаат за меродавни. Ако е дадена, вредноста мора да биде од листата на именувани јазици од надлежните органи (http://publications.europa.eu/resource/authority/language).</sh:description>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="tr">Yetkili olmak için sorumluluk ve otonomi ile kullanılan bir dizi bilgi ve/veya yeteneği bir kişinin edinebilmesi için gerekli şartların temel dili.Verilmişse, değer Dil Adı Verilmiş Yetkili Listesinden gelmelidir (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="hr">Osnovni jezik uvjeta pod kojima osoba može steći skup znanja i/ili vještina koje se koriste odgovorno i autonomno, koji se smatra mjerodavnim. Ako je navedena, vrijednost mora biti s popisa jezika imenovanog tijela (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:maxCount>
        <sh:description xml:lang="lt">Pagrindinė kalba, kuria nurodomos sąlygos, pvz., laikas ir vieta, kuriomis asmuo gali įgyti žinių ir (arba) įgūdžių, naudojamų atsakingai ir savarankiškai, kuria pateikiamas tekstas laikomas autentišku. Jei pateikiama, vertė turi būti iš kalbų vardinių autoritetinių duomenų sąrašo (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="da">Basissproget for de betingelser, hvorunder en person kan tilegne sig et sæt kundskaber og/eller færdigheder, der anvendes med ansvar og selvstændighed, som skal betragtes som autoritative. Hvis oplyst, skal værdien tages fra listen Language Named Authority (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:description xml:lang="hu">Azon feltételek alapnyelve, amelyekkel egy személy önállóan és felelősségteljesen használható ismereteket és/vagy készségeket sajátíthat el, amelyek irányadónak tekinthetők. A megadott értéknek a nyelvek szójegyzékéből kell származnia (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="pt">língua predefinida</sh:name>
        <sh:name xml:lang="fi">oletuskieli</sh:name>
        <sh:name xml:lang="lv">noklusējuma valoda</sh:name>
        <sh:description xml:lang="nl">De basistaal van de omstandigheden waarin een persoon kennis en/of vaardigheden kan verwerven die op verantwoordelijke en zelfstandige wijze worden gebruikt, die als authentiek moet worden beschouwd. Indien verstrekt, moet de waarde afkomstig zijn uit de standaardnamenlijst van talen (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="et">vaikekeel</sh:name>
        <sh:name xml:lang="sl">privzeti jezik</sh:name>
        <sh:description xml:lang="es">La lengua de base de las condiciones en las que una persona puede adquirir un conjunto de conocimientos o competencias utilizados con responsabilidad y autonomía, en que estas se considerarán oficiales. Si se facilita, el valor debe proceder de la Lista autorizada de nombres Lengua (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:path rdf:resource="http://data.europa.eu/snb/model/ontology/defaultLanguage"/>
        <sh:description xml:lang="bg">Основният език на условията, при които дадено лице може да придобие набор от знания и/или умения, използвани отговорно и самостоятелно, който следва да се счита за меродавен. Ако бъде посочена, стойността трябва да е от номенклатурния списък на езиците (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >7</sh:order>
        <sh:name xml:lang="sr">подразумевани језик</sh:name>
        <sh:description xml:lang="sr">Основни језик услова, као што су време и локација, под којима неко може да усвоји скуп знања и/или вештина за одговорну и самосталну примену који се сматра меродавним. Ако се наводи, вредност мора да потиче са именованог одобреног списка Језик (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="da">standardsprog</sh:name>
        <sh:description xml:lang="pt">A língua de base das condições em que uma pessoa pode adquirir um conjunto de conhecimentos e/ou competências utilizados com responsabilidade e autonomia, para serem consideradas fidedignas. Se for indicado, o valor deve provir da lista de autoridade relativa às línguas (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="pl">Język podstawowy warunków uzyskania przez daną osobę zestawu wiedzy lub umiejętności wykorzystywanych z odpowiedzialnością i autonomią, który należy uznać za autorytatywny. Jeżeli ją podano, wartość ta musi pochodzić z autorytatywnego wykazu języków (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="tr">varsayılan dil</sh:name>
        <sh:name xml:lang="mt">lingwa predefinita</sh:name>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >1</sh:minCount>
        <sh:name xml:lang="en">default language</sh:name>
        <sh:description xml:lang="el">Η γλώσσα βάσης των συνθηκών υπό τις οποίες ένα πρόσωπο μπορεί να αποκτήσει ένα σύνολο γνώσεων και/ή δεξιοτήτων που χρησιμοποιούνται με υπευθυνότητα και αυτονομία, η οποία πρέπει να θεωρείται επίσημη γλώσσα.Εάν παρέχεται, η τιμή πρέπει να προέρχεται από τον κατάλογο εγκεκριμένων ονομάτων «Language» (Γλώσσα) (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="bg">език по подразбиране</sh:name>
        <sh:description xml:lang="me">Osnovni jezik uslova pod kojima osoba može steći skup znanja i/ili vještina koje se koriste s odgovornošću i autonomijom, a koji se smatra mjerodavnim. Ako je navedena, vrijednost mora da potiče sa liste ovlašćenja sa nazivom jezika (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="ro">Limba de bază a condițiilor în care o persoană poate dobândi un set de cunoștințe și/sau competențe utilizate cu responsabilitate și autonomie, care să fie considerate oficială. Dacă este furnizată, valoarea trebuie să provină din lista de limbi desemnate ale autorității(http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="ga">teanga réamhshocraithe</sh:name>
        <sh:description xml:lang="sk">Základný jazyk podmienok, za ktorých môže osoba nadobudnúť súbor vedomostí a/alebo zručností používaných zodpovedne a samostatne, ktorý sa bude považovať za rozhodujúci. Poskytnutá hodnota musí byť zo zoznamu určených orgánov pre jazyky (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="fi">Sellaisten ehtojen oletuskieli, joiden täyttyessä henkilö voi hankkia vastuullisesti ja itsenäisesti käytettävät tiedot ja/tai taidot, jotta hänet katsotaan päteväksi. Jos arvo määritellään, sen on oltava Language (kieli) -NAL-luettelon mukainen(http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="sk">predvolený jazyk</sh:name>
        <sh:name xml:lang="ro">limba implicită</sh:name>
        <sh:name xml:lang="el">προεπιλεγμένη γλώσσα</sh:name>
        <sh:description xml:lang="is">Grunntungumál skilyrða, sem einstaklingur þarf að fylgja til að öðlast ákveðna þekkingu og/eða færni sem notuð er af ábyrgð og með sjálfstæðum hætti til að teljast viðurkenndur.Uppgefin gildi verða að koma af lista yfir Tungumálaheiti yfirvalda (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="no">standardspråk</sh:name>
        <sh:name xml:lang="de">Standardsprache</sh:name>
        <sh:name xml:lang="it">lingua predefinita</sh:name>
        <sh:description xml:lang="en">The base language of the conditions under which a person may acquire a set of knowledge and/or skills used with responsibility and autonomy, to be considered authoritative. If provided, the value must come from the Language Named Authority List (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="de">Die Grundsprache der Bedingungen, unter denen eine Person eine Reihe von Kenntnissen und/oder Fähigkeiten erwerben kann, die mit Verantwortung und Autonomie genutzt werden, ist verbindlich. Falls angegeben, muss der Wert aus der Sprachautoritätsliste (http://publications.europa.eu/resource/authority/language) stammen.</sh:description>
        <sh:description xml:lang="fr">La langue de base des conditions dans lesquelles une personne peut acquérir un ensemble de connaissances et/ou de compétences utilisées avec des responsabilités et une certaine autonomie, à considérer comme faisant autorité. Si elle est fournie, la valeur doit provenir de la liste d’autorités de la Langue (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="cs">výchozí nastavení jazyka</sh:name>
        <sh:description xml:lang="et">Nende tingimuste põhikeelt, mille alusel inimene võib omandada teadmiste ja/või oskuste kogumi, mida ta kasutab vastutustundlikult ja iseseisvalt, peetakse autoriteetseks. Kui väärtus on märgitud, peab see pärinema keele normandmeloendist (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="ga">Bunteanga na gcoinníollacha faoina bhféadfaidh duine tacar eolais agus/nó scileanna a fháil a úsáidtear le freagracht agus le neamhspleáchas, ionas go measfar go bhfuil sé údarásach. Má chuirtear ar fáil é, ní mór an luach teacht ó Liosta na nÚdarás Ainmnithe de réir Teanga (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="lv">Obligātā pamatvaloda nosacījumiem, saskaņā ar kuriem persona var iegūt atbildīgi un autonomi izmantojamu zināšanu un/vai prasmju kopumu. Var norādīt tikai vērtības, kas ņemtas no valodu nosaukumu autoritatīvā saraksta (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="sv">Basspråket för de villkor enligt vilka en person kan skaffa sig en uppsättning kunskaper och/eller färdigheter som används med ansvar och självständighet som ska betraktas som auktoritativa. I förekommande fall måste värdet komma från auktoritetsregistret för namn på språk (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:description xml:lang="en">The default language of the learning opportunity.</sh:description>
        <sh:name xml:lang="me">podrazumijevani jezik</sh:name>
        <sh:description xml:lang="it">La lingua di base delle condizioni alle quali una persona può acquisire una serie di conoscenze e/o abilità utilizzate con responsabilità e autonomia, da considerarsi facente fede. Se fornito, il valore deve essere tratto dalle lingue indicate nell'elenco delle autorità designate (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="sv">förinställt språk</sh:name>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:name xml:lang="is">sjálfgefið tungumál</sh:name>
        <sh:description xml:lang="no">Grunnspråket for betingelsene der en person kan tilegne seg et sett med kunnskap og/eller ferdigheter som brukes med ansvar og autonomi, for å anses som autoritativ.Hvis medfølgende, må den oppgitte verdien må komme fra Language Named Authority-listen (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="hu">alapértelmezett nyelv</sh:name>
        <sh:name xml:lang="fr">langue par défaut</sh:name>
        <sh:description xml:lang="cs">Základní jazyk podmínek, za kterých si osoba může osvojit soubor znalostí a/nebo dovedností používaných zodpovědně a samostatně, aby mohly být považovány za závazné.Poskytnutá hodnota musí být převzata ze Seznamu Určených orgánů pro jazyk (http://publications.europa.eu/resource/authority/language).</sh:description>
        <sh:name xml:lang="nl">standaardtaal</sh:name>
        <sh:description xml:lang="mt">Il-lingwa bażika tal-kundizzjonijiet li taħthom persuna tista’ tikseb sett ta’ għarfien u/jew ħiliet użati b’responsabbiltà u awtonomija, biex titqies awtorevoli. Jekk jiġi pprovdut, il-valur irid jiġi mil-Lista tal-Awtorità Imsemmija tal-Lingwa (http://publications.europa.eu/resource/authority/language).</sh:description>
      </rdf:Description>
    </sh:property>
    <rdfs:label xml:lang="lt">Mokymosi galimybė</rdfs:label>
    <rdfs:comment xml:lang="sv">De villkor, t.ex. tid och plats, enligt vilka en person kan skaffa sig en uppsättning kunskaper och/eller färdigheter som används med ansvar och/eller självständighet.</rdfs:comment>
    <rdfs:label xml:lang="it">Opportunità di apprendimento;</rdfs:label>
    <rdfs:comment xml:lang="el">Οι συνθήκες, π.χ. χρόνος και τόπος, υπό τις οποίες ένα πρόσωπο μπορεί να αποκτήσει ένα σύνολο γνώσεων και/ή δεξιοτήτων που χρησιμοποιούνται με υπευθυνότητα και αυτονομία.</rdfs:comment>
    <rdfs:comment xml:lang="mt">Il-kundizzjonijiet, eż. il-ħin u l-lokalizzazzjoni, li taħthom persuna tista’ tikseb sett ta’ għarfien u/jew ħiliet użati b’responsabbiltà u awtonomija.</rdfs:comment>
    <sh:targetClass rdf:resource="http://data.europa.eu/snb/model/ontology/LearningOpportunity"/>
    <rdfs:comment xml:lang="pl">Warunki, np. czas i miejsce, uzyskania przez daną osobę zestawu wiedzy lub umiejętności wykorzystywanych z odpowiedzialnością i autonomią.</rdfs:comment>
    <sh:property>
      <rdf:Description rdf:about="http://data.europa.eu/snb/model/application-profile/loq-constraints/LearningOpportunity-elm_mode">
        <sh:description xml:lang="lv">Mācīšanās un/vai novērtēšanas metode. Var norādīt tikai vērtības, kas ņemtas no kontrolētas vārdnīcas (piem., http://publications.europa.eu/resource/dataset/learning-assessment). Datu sniedzēji var izmantot paši savu(-us) kontroles sarakstu(-us).</sh:description>
        <sh:name xml:lang="is">hamur</sh:name>
        <sh:description xml:lang="pl">Sposób nauki lub oceny. Jeżeli ją podano, wartość powinna pochodzić ze słownika kontrolowanego (np. http://publications.europa.eu/resource/dataset/learning-assessment). Dostawcy danych mogą stosować swoje własne listy kontrolowane.</sh:description>
        <sh:description xml:lang="fr">Le mode d’apprentissage et/ou d’évaluation. Si elle est fournie, la valeur doit provenir d’un vocabulaire contrôlé(e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Les fournisseurs de données peuvent utiliser leur(s) propre(s) liste(s) contrôlée(s).</sh:description>
        <sh:description xml:lang="ro">Modul de învățare și/sau evaluare. Dacă este furnizată, valoarea ar trebui să provină dintr-un vocabular controlat (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Furnizorii de date își pot utiliza propriile liste.</sh:description>
        <sh:description xml:lang="lt">Mokymosi ir (arba) vertinimo būdas. Jei nurodoma, vertė turėtų būti iš kontrolinio žodyno (pvz., http://publications.europa.eu/resource/dataset/learning-assessment). Duomenų teikėjai gali naudoti savo pačių kontrolinį sąrašą (-us).</sh:description>
        <sh:description xml:lang="mk">Начинот на учење, и/или проценката. Ако е дадена, вредноста треба да биде од контролиран вокабулар (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Давателите на податоци можат да користат сопствена котролирана листа(и).</sh:description>
        <sh:description xml:lang="nl">De leer- en/of beoordelingsmethode. Indien verstrekt, moet de waarde afkomstig zijn uit een gecontroleerde woordenlijst (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Aanbieders van gegevens kunnen hun eigen gecontroleerde lijst(en) gebruiken.</sh:description>
        <sh:description xml:lang="sv">Typ av lärande och/eller bedömning. I förekommande fall ska värdet komma från en kontrollerad ordlista (t.ex. http://publications.europa.eu/resource/dataset/learning-assessment). Uppgiftslämnare kan använda en eller flera egna kontrollerade listor.</sh:description>
        <sh:description xml:lang="en">The mode of learning, and/or assessment. If provided, the value should come from a controlled vocabulary (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Data providers can use their own cotrolled list(s).</sh:description>
        <sh:description xml:lang="cs">Způsob učení a/nebo hodnocení. Poskytnutá hodnota by měla být převzata z řízeného slovníku (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Poskytovatelé údajů mohou použít svůj vlastní řízený seznam (své vlastní řízené seznamy).</sh:description>
        <sh:description xml:lang="et">Õppimisviis ja/või hindamine. Kui väärtus on märgitud, peaks see pärinema kontrollitud sõnastikust (nt http://publications.europa.eu/resource/dataset/learning-assessment). Andmeesitajad võivad kasutada oma kontrollitud loendit (loendeid).</sh:description>
        <sh:description xml:lang="es">El modo de aprendizaje o evaluación. Si se facilita, el valor debe proceder de un vocabulario controlado (por ejemplo, http://publications.europa.eu/resource/dataset/learning-assessment). Los proveedores de datos pueden utilizar su propia lista o listas controladas.</sh:description>
        <sh:name xml:lang="nl">methode</sh:name>
        <sh:description xml:lang="de">Die Lern- und/oder Beurteilungsmethode. Falls angegeben, sollte der Wert aus einem kontrollierten Vokabular stammen (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Datenanbieter können ihre eigene(n) kontrollierte(n) Liste(n) verwenden.</sh:description>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer"
        >12</sh:order>
        <sh:description xml:lang="sr">Режим учења и/или оцењивања. Ако се наводи, вредност треба да потиче из контролисаног вокабулара (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Добављачи података могу да користе своје контролисане листе.</sh:description>
        <sh:name xml:lang="lv">režīms</sh:name>
        <sh:name xml:lang="hu">üzemmód</sh:name>
        <sh:description xml:lang="fi">Oppimisen ja/tai arvioinnin tapa. Jos arvo määritellään, sen täytyy perustua kontrolloituun sanastoon (esim. http://publications.europa.eu/resource/dataset/learning-assessment). Tietojen toimittajat voivat käyttää omia kontrolloituja luetteloitaan (yhtä tai useampaa).</sh:description>
        <sh:name xml:lang="sk">režim</sh:name>
        <sh:name xml:lang="sl">način</sh:name>
        <rdfs:isDefinedBy rdf:resource="http://data.europa.eu/snb/model/application-profile/loq-constraints"/>
        <sh:description xml:lang="en">The mode of learning and or assessment.</sh:description>
        <sh:name xml:lang="el">τρόπος</sh:name>
        <sh:name xml:lang="me">način rada</sh:name>
        <sh:name xml:lang="lt">režimas</sh:name>
        <sh:description xml:lang="hr">Modalitet učenja i/ili ocjenjivanja. Ako je navedena, vrijednost bi trebala biti iz kontroliranog rječnika (npr. http://publications.europa.eu/resource/dataset/learning-assessment). Pružatelji podataka mogu se služiti vlastitim popisom/popisima.</sh:description>
        <sh:name xml:lang="da">tilstand</sh:name>
        <sh:description xml:lang="me">Način učenja i/ili ocjenjivanja. Ako je navedena, vrijednost bi trebalo da potiče iz kontrolisanog rječnika (npr. http://publications.europa.eu/resource/dataset/learning-assessment). Provajderi podataka mogu da koriste sopstvene kontrolisane liste.</sh:description>
        <sh:description xml:lang="sl">Način učenja in/ali ocenjevanja Če je vrednost navedena, bi morala izhajati iz kontroliranega besednjaka (npr. http://publications.europa.eu/resource/dataset/learning-assessment). Ponudniki podatkov lahko uporabljajo svoje kontrolirane sezname.</sh:description>
        <sh:name xml:lang="fi">tapa</sh:name>
        <sh:name xml:lang="no">modus</sh:name>
        <sh:name xml:lang="hr">modalitet</sh:name>
        <sh:description xml:lang="mt">Mod ta’ tagħlim, u/jew tal-valutazzjoni Jekk jiġi pprovdut, il-valur għandu jiġi minn vokabularju kkontrollat (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Il-fornituri tad-data jistgħu jużaw il-lista/i kontrollata/i tagħhom stess.</sh:description>
        <sh:description xml:lang="ga">An modh foghlama agus/nó measúnaithe. Má chuirtear ar fáil é, ba cheart an luach teacht ó stór focal rialaithe (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Is féidir le soláthraithe sonraí a liosta nó a liostaí rialaithe féin a úsáid.</sh:description>
        <sh:class rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <sh:description xml:lang="it">Modalità di apprendimento e/o valutazione. Se fornito, il valore deve essere tratto da un vocabolario controllato (ad es. http://publications.europa.eu/resource/dataset/learning-assessment). I fornitori di dati possono utilizzare i propri elenchi controllati.</sh:description>
        <sh:description xml:lang="hu">A tanulás és/vagy az értékelés módja Az értéknek (ha meg van adva) ellenőrzött szójegyzékből kell származnia (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Az adatszolgáltatók használhatják a saját ellenőrzött listájukat (listáikat).</sh:description>
        <sh:name xml:lang="en">mode</sh:name>
        <sh:name xml:lang="fr">mode</sh:name>
        <sh:name xml:lang="it">modalità</sh:name>
        <sh:name xml:lang="mt">modalità</sh:name>
        <sh:description xml:lang="is">Námsaðferð og/eða námsmat. Ef til staðar, ætti gildið að vera tekið úr stýrðum orðaforða (e.g. http://publications.europa.eu/resource/dataset/learning-assessment). Gagnaveitendur geta notað þeirra eigin stýrðan lista.</sh:description>
        <sh:name xml:lang="ga">modh</sh:name>
        <sh:name xml:lang="bg">начин</sh:name>
